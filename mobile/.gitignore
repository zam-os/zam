node_modules/
dist/
src-tauri/target/
src-tauri/gen/*
!src-tauri/gen/android/

# Staged by build.rs from DEP_TAURI_IOS_LIBRARY_PATH so ios/Package.swift can
# resolve the Tauri Swift API. Generated, never edited.
src-tauri/.tauri/
src-tauri/ios/.build/
src-tauri/ios/Package.resolved

# iOS: unlike gen/android — versioned wholesale because the API-37 Gradle
# customizations live in generated files — every iOS customization lives in
# project.yml (deployment target, Info.plist keys) or in hand-written Swift
# under Sources/. The .xcodeproj is pure xcodegen output, regenerated by
# `tauri ios init`, so versioning it would add churn and no information.
!src-tauri/gen/apple/
src-tauri/gen/apple/*.xcodeproj/
# Regenerated from project.yml on every build (down to the trailing newline),
# so versioning it just dirties the worktree. project.yml carries the same
# values — including NSCameraUsageDescription — and is the reviewable source.
src-tauri/gen/apple/zam-mobile_iOS/Info.plist
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/build/
src-tauri/gen/apple/Pods/
src-tauri/gen/apple/Podfile.lock
src-tauri/gen/apple/.tauri/
