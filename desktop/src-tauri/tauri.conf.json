{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZAM",
  "version": "../../package.json",
  "identifier": "com.zam.app",
  "build": {
    "beforeDevCommand": "npm run dev:with-bridge",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:with-bridge",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZAM",
        "width": 950,
        "height": 720,
        "minWidth": 720,
        "minHeight": 580,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/zam-os/zam/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NEYzOEU2Mjc4QTU2MTMKUldRVFZvb241amhQMXg1Y0tlYkdPdkxuTDNBU3Z3Q2poZzg2ekR1Z0JqRnJTVFR3ZTBOREROMVAK"
    }
  }
}
