{
  "name": "uml-learning-app",
  "version": "1.0.0",
  "private": true,
  "description": "Grafischer UML 2.5.1 Editor & Interaktive Lern-App für Systemverständnis und visuellen Ausdruck (unabhängig von ZAM, ohne KI).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:zip": "npm run build && node scripts/build-release-zip.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
