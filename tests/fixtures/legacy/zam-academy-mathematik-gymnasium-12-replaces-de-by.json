        {
          "type": "math",
          "tex": "\\alpha = 0{,}05",
          "speech": "Alpha gleich 0,05"
        },
        {
          "type": "text",
          "text": "), 3. Bestimmung der Entscheidungsregel:   * Ablehnungsbereich "
        },
        {
          "type": "math",
          "tex": "\\bar{A} = \\{k+1, \\dots, n\\}",
          "speech": "A quer gleich die Menge von k plus 1 bis n"
        },
        {
          "type": "text",
          "text": ".   * Bedingung: "
        },
        {
          "type": "math",
          "tex": "P_{p_0}(X \\in \\bar{A}) = P_{p_0}(X \\ge k+1) = 1 - P_{p_0}(X \\le k) \\le \\alpha \\iff P_{p_0}(X \\le k) \\ge 1 - \\alpha",
          "speech": "P p null von X Element von A quer gleich P p null von X größer gleich k plus 1 gleich 1 minus P p null von X kleiner gleich k kleiner gleich Alpha, genau dann, wenn P p null von X kleiner gleich k größer gleich 1 minus Alpha"
        },
        {
          "type": "text",
          "text": ", 4. Entscheidung & Interpretation:   * Fällt das Stichprobenergebnis "
        },
        {
          "type": "math",
          "tex": "x \\in \\bar{A}",
          "speech": "x Element von A quer"
        },
        {
          "type": "text",
          "text": ", wird "
        },
        {
          "type": "math",
          "tex": "H_0",
          "speech": "H null"
        },
        {
          "type": "text",
          "text": " zugunsten von "
        },
        {
          "type": "math",
          "tex": "H_1",
          "speech": "H eins"
        },
        {
          "type": "text",
          "text": " verworfen; fällt "
        },
        {
          "type": "math",
          "tex": "x \\in A",
          "speech": "x Element von A"
        },
        {
          "type": "text",
          "text": ", wird "
        },
        {
          "type": "math",
          "tex": "H_0",
          "speech": "H null"
        },
        {
          "type": "text",
          "text": " nicht verworfen."
        }
      ],
