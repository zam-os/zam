        {
          "type": "math",
          "tex": "X \\sim B(n; p_0)",
          "speech": "X ist binomialverteilt mit n und p null"
        },
        {
          "type": "text",
          "text": ".   * Signifikanzniveau "
        },
        {
          "type": "math",
          "tex": "\\alpha",
          "speech": "Alpha"
        },
        {
          "type": "text",
          "text": " (z. B. "
