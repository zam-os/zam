      "practice_items": [
        {
          "id": "01K4M7Z0000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Löse die lineare Gleichung "
            },
            {
              "type": "math",
              "tex": "5x - 8 = 2x + 13",
              "speech": "5 x minus 8 gleich 2 x plus 13"
            },
            {
              "type": "text",
              "text": " für "
            },
            {
              "type": "math",
              "tex": "x \\in \\mathbb{Q}",
              "speech": "x Element der rationalen Zahlen"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept": "x = 7 (3x = 21 -> x = 7)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "x = 7",
              "x = 5"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K4M7Z0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Erkläre systematisch Äquivalenzumformungen von Gleichungen und die Prozentrechnung: 1. Äquivalenzumformungen (Symbol "
            },
            {
              "type": "math",
              "tex": "\\Leftrightarrow",
              "speech": "genau dann, wenn"
            },
            {
              "type": "text",
              "text": "): Umformungen, die die Lösungsmen "
            },
            {
              "type": "math",
              "tex": "L",
              "speech": "L"
            },
            {
              "type": "text",
              "text": " einer Gleichung nicht verändern:   * Beidseitige Addition/Subtraktion desselben Terms ("
            },
            {
              "type": "math",
              "tex": "T_1 = T_2 \\Leftrightarrow T_1 + T_3 = T_2 + T_3",
              "speech": "T eins gleich T zwei genau dann, wenn T eins plus T drei gleich T zwei plus T drei"
            },
            {
              "type": "text",
              "text": ").   * Beidseitige Multiplikation/Division mit einer Zahl "
            },
            {
              "type": "math",
              "tex": "c \\neq 0",
              "speech": "c ungleich 0"
            },
            {
              "type": "text",
              "text": ". 2. Lösen linearer Gleichungen mit Klammern: Terme vereinfachen (Klammern auflösen) "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Terme auf eine Seite, absolute Zahlen auf die andere "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " durch Koeffizienten vor "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": " teilen "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " Lösungsmenge "
            },
            {
              "type": "math",
              "tex": "L = \\{x\\}",
              "speech": "L gleich die Menge aus x"
            },
            {
              "type": "text",
              "text": " angeben. 3. Die Prozentrechnung: Formel "
            },
            {
              "type": "math",
              "tex": "W = G \\cdot p\\%",
              "speech": "W gleich G mal p Prozent"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "W = \\text{Prozentwert}",
              "speech": "W gleich Prozentwert"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "G = \\text{Grundwert}",
              "speech": "G gleich Grundwert"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "p\\% = \\frac{p}{100} = \\text{Prozentsatz}",
              "speech": "p Prozent gleich p durch 100 gleich Prozentsatz"
            },
            {
              "type": "text",
              "text": "); Prozentsatzveränderungen (Vermehrter Grundwert "
            },
            {
              "type": "math",
              "tex": "G^+ = G \\cdot (1 + p\\%)",
              "speech": "G plus gleich G mal Klammer auf 1 plus p Prozent Klammer zu"
            },
            {
              "type": "text",
              "text": " vs. Verminderter Grundwert "
            },
            {
              "type": "math",
              "tex": "G^- = G \\cdot (1 - p\\%)",
              "speech": "G minus gleich G mal Klammer auf 1 minus p Prozent Klammer zu"
            },
            {
              "type": "text",
              "text": "). 4. Löse die Gleichung: "
            },
            {
              "type": "math",
              "tex": "3 \\cdot (2x - 4) - (x + 2) = 4 \\cdot (x - 1) + 6",
              "speech": "3 mal Klammer auf 2 x minus 4 Klammer zu minus Klammer auf x plus 2 Klammer zu gleich 4 mal Klammer auf x minus 1 Klammer zu plus 6"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept": "Gleichungen lösen (Klammern auflösen, Terme ordnen, Äquivalenzumformung); Prozentrechnung: W = G * p%, vermehrter/verminderter Grundwert mit Wachstumsfaktor; Lösung Gleichung: 6x - 12 - x - 2 = 4x - 4 + 6 -> 5x - 14 = 4x + 2 -> x = 16, L = {16}.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Grundregeln der Äquivalenzumformung: - Eine Äquivalenzumformung verändert die Gültigkeit einer Gleichung und deren Lösungsmenge "
            },
            {
              "type": "math",
              "tex": "L"
            },
            {
              "type": "text",
              "text": " nicht:   * Erlaubt: Beidseitige Addition/Subtraktion beliebiger Terme; beidseitige Multiplikation/Division mit Zahlen "
            },
            {
              "type": "math",
              "tex": "c \\neq 0"
            },
            {
              "type": "text",
              "text": ".   * Nicht äquivalent: Multiplikation mit Null oder Multiplikation mit Termen, die Null werden können (führt zu Scheinlösungen). 2. Schrittweiser Algorithmus zum Lösen linearer Gleichungen: - 1. Schritt: Terme auf beiden Seiten separat vereinfachen (Klammern nach Vorzeichenregeln und Distributivgesetz ausmultiplizieren, gleichartige Terme zusammenfassen). - 2. Schritt: Alle Terme mit der Variablen "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": " auf eine Seite und alle reinen Zahlen auf die Gegenseite bringen (durch Addition/Subtraktion). - 3. Schritt: Durch den Koeffizienten vor "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": " dividieren. - 4. Schritt: Lösungsmenge "
            },
            {
              "type": "math",
              "tex": "L = \\{x\\}"
            },
            {
              "type": "text",
              "text": " notieren und optional Probe durchführen. 3. Die Prozentrechnung als proportionale Zuordnung: - Die Grundgleichung verbindet die drei Größen:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{W = G \\cdot p\\%} \\iff \\mathbf{W = G \\cdot \\frac{p}{100}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Grundwert "
            },
            {
              "type": "math",
              "tex": "G"
            },
            {
              "type": "text",
              "text": ": Das Ganze ("
            },
            {
              "type": "math",
              "tex": "100\\%"
            },
            {
              "type": "text",
              "text": ").   * Prozentwert "
            },
            {
              "type": "math",
              "tex": "W"
            },
            {
              "type": "text",
              "text": ": Der absolute Anteil.   * Prozentsatz "
            },
            {
              "type": "math",
              "tex": "p\\%"
            },
            {
              "type": "text",
              "text": ": Der relative Anteil. - Prozentuale Zunahme / Abnahme:   * Erhöhung um "
            },
            {
              "type": "math",
              "tex": "p\\%"
            },
            {
              "type": "text",
              "text": ": Neuer Wert "
            },
            {
              "type": "math",
              "tex": "= G \\cdot (1 + p\\%)"
            },
            {
              "type": "text",
              "text": " (Wachstumsfaktor "
            },
            {
              "type": "math",
              "tex": "q = 1 + \\frac{p}{100}"
            },
            {
              "type": "text",
              "text": ").   * Reduzierung um "
            },
            {
              "type": "math",
              "tex": "p\\%"
            },
            {
              "type": "text",
              "text": ": Neuer Wert "
            },
            {
              "type": "math",
              "tex": "= G \\cdot (1 - p\\%)"
            },
            {
              "type": "text",
              "text": " (Abnahmefaktor "
            },
            {
              "type": "math",
              "tex": "q = 1 - \\frac{p}{100}"
            },
            {
              "type": "text",
              "text": "). 4. Vollständige Rechnung zur Beispielaufgabe:   "
            },
            {
              "type": "math",
              "tex": "3 \\cdot (2x - 4) - (x + 2) = 4 \\cdot (x - 1) + 6",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "6x - 12 - x - 2 = 4x - 4 + 6 \\quad \\text{(Klammern auflösen)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "5x - 14 = 4x + 2 \\quad \\text{(Zusammenfassen)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "5x - 4x = 2 + 14 \\quad | -4x \\; | +14",
