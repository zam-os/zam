          "id": "01K4WAK0000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Wie berechnen sich die 'Herstellkosten der Erzeugung' (HK d. E.) im klassischen 11-stufigen bayerischen BwR-Kalkulationsschema?",
          "concept": "Herstellkosten = Fertigungsmaterial (FM) + Materialgemeinkosten (MGK) + Fertigungslöhne (FL) + Fertigungsgemeinkosten (FGK)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Materialkosten (FM+MGK) + Fertigungskosten (FL+FGK)",
              "Selbstkosten + Gewinnzuschlag"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K4WAK0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question": "Führe das vollständige bayerische Vorwärtskalkulationsschema (von Fertigungsmaterial bis Bruttoverkaufspreis) lückenlos vor und berechne den Barverkaufspreis (BVP) bei folgenden Werten: Fertigungsmaterial (FM) = 200,00 €, Materialgemeinkostenzuschlag (MGKZ) = 10 %, Fertigungslöhne (FL) = 300,00 €, Fertigungsgemeinkostenzuschlag (FGKZ) = 150 %, Verwaltungsgemeinkostenzuschlag (VwGKZ) = 15 %, Vertriebsgemeinkostenzuschlag (VtGKZ) = 10 %, Gewinnzuschlag = 20 %.",
          "concept": "Kalkulationsschema: FM (200 €) + MGK 10% (20 €) = MK (220 €); FL (300 €) + FGK 150% (450 €) = FK (750 €); Herstellkosten HK = MK + FK = 970 €; VwGK 15% (145,50 €) + VtGK 10% (97,00 €); Selbstkosten SK = 970 + 145,50 + 97 = 1.212,50 €; Gewinn 20% von SK = 242,50 €; Barverkaufspreis BVP = 1.212,50 + 242,50 = 1.455,00 €.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Das 11-stufige bayerische Vorwärtskalkulationsschema: 1. Fertigungsmaterial (FM) 2. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Materialgemeinkosten (MGK) ["
            },
            {
              "type": "math",
              "tex": "= \\text{FM} \\cdot \\text{MGKZ}\\%"
            },
            {
              "type": "text",
              "text": "] "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Materialkosten (MK)}}"
            },
            {
              "type": "text",
              "text": " 3. Fertigungslöhne (FL) 4. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Fertigungsgemeinkosten (FGK) ["
            },
            {
              "type": "math",
              "tex": "= \\text{FL} \\cdot \\text{FGKZ}\\%"
            },
            {
              "type": "text",
              "text": "] "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Fertigungskosten (FK)}}"
            },
            {
              "type": "text",
              "text": " 5. "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Herstellkosten (HK)}}"
            },
            {
              "type": "text",
              "text": " ["
            },
            {
              "type": "math",
              "tex": "= \\text{MK} + \\text{FK}"
            },
            {
              "type": "text",
              "text": "] 6. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Verwaltungsgemeinkosten (VwGK) ["
            },
            {
              "type": "math",
              "tex": "= \\text{HK} \\cdot \\text{VwGKZ}\\%"
            },
            {
              "type": "text",
              "text": "] 7. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Vertriebsgemeinkosten (VtGK) ["
            },
            {
              "type": "math",
              "tex": "= \\text{HK} \\cdot \\text{VtGKZ}\\%"
            },
            {
              "type": "text",
              "text": "] 8. "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Selbstkosten (SK)}}"
            },
            {
              "type": "text",
              "text": " ["
            },
            {
              "type": "math",
              "tex": "= \\text{HK} + \\text{VwGK} + \\text{VtGK}"
            },
            {
              "type": "text",
              "text": "] 9. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Gewinn ["
            },
            {
              "type": "math",
              "tex": "= \\text{SK} \\cdot \\text{Gewinn}\\%"
            },
            {
              "type": "text",
              "text": "] 10. "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Barverkaufspreis (BVP)}}"
            },
            {
              "type": "text",
              "text": " 11. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Kundenskonto (im Hundert) "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Zielverkaufspreis (ZVP)}}"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Kundenrabatt (im Hundert) "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Listenverkaufspreis (LVP nettopreis)}} + 19\\%\\text{ USt} = \\mathbf{\\text{Bruttoverkaufspreis}}"
            },
            {
              "type": "text",
              "text": ". 2. Durchrechnung des Beispiels: - 1. Fertigungsmaterial (FM): "
            },
            {
              "type": "math",
              "tex": "200,00\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 2. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " MGK ("
            },
            {
              "type": "math",
              "tex": "10\\% \\text{ von } 200\\text{ €}"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "+ 20,00\\text{ €}"
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\rightarrow"
            },
            {
              "type": "text",
              "text": " Materialkosten (MK): "
            },
            {
              "type": "math",
              "tex": "220,00\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 3. Fertigungslöhne (FL): "
            },
            {
              "type": "math",
              "tex": "300,00\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 4. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " FGK ("
            },
            {
              "type": "math",
              "tex": "150\\% \\text{ von } 300\\text{ €}"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "+ 450,00\\text{ €}"
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\rightarrow"
            },
            {
              "type": "text",
              "text": " Fertigungskosten (FK): "
            },
            {
              "type": "math",
              "tex": "750,00\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 5. "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Herstellkosten (HK)}} = 220,00\\text{ €} + 750,00\\text{ €} = \\mathbf{970,00\\text{ €}}"
            },
            {
              "type": "text",
              "text": " - 6. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " VwGK ("
            },
            {
              "type": "math",
              "tex": "15\\% \\text{ von } 970\\text{ €}"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "+ 145,50\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 7. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " VtGK ("
            },
            {
              "type": "math",
              "tex": "10\\% \\text{ von } 970\\text{ €}"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "+ 97,00\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 8. "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Selbstkosten (SK)}} = 970,00 + 145,50 + 97,00 = \\mathbf{1.212,50\\text{ €}}"
            },
            {
              "type": "text",
              "text": " - 9. "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " Gewinn ("
            },
            {
              "type": "math",
              "tex": "20\\% \\text{ von } 1.212,50\\text{ €}"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "+ 242,50\\text{ €}"
            },
            {
              "type": "text",
              "text": " - 10. "
            },
            {
              "type": "math",
              "tex": "= \\mathbf{\\text{Barverkaufspreis (BVP)}} = 1.212,50\\text{ €} + 242,50\\text{ €} = \\mathbf{1.455,00\\text{ €}}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ]
