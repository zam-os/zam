      "practice_items": [
        {
          "id": "01K8GB00000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Was ist der entscheidende mathematische Schritt bei einem Extremwertproblem, um die Zielfunktion "
            },
            {
              "type": "math",
              "tex": "Z(x, y)",
              "speech": "Z von x und y"
            },
            {
              "type": "text",
              "text": " mit zwei Variablen in eine ableitbare Funktion "
            },
            {
              "type": "math",
              "tex": "Z(x)",
              "speech": "Z von x"
            },
            {
              "type": "text",
              "text": " mit nur einer Variablen umzuwandeln?"
            }
          ],
          "concept": "Das Auflösen der Nebenbedingung nach einer Variablen und das Einsetzen dieses Terms in die Hauptbedingung / Zielfunktion",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Nebenbedingung nach einer Variablen auflösen und in die Zielfunktion einsetzen",
              "Beide Variablen einfach gleich Null setzen"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GB00000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Löse ein klassisches geometrisches Optimierungsproblem: Ein Landwirt möchte mit einem "
            },
            {
              "type": "math",
              "tex": "U = 40\\,\\text{m}",
              "speech": "U gleich 40 Meter"
            },
            {
              "type": "text",
              "text": " langen Zaun ein rechteckiges Weidegrundstück an einer geraden Flussmauer einzäunen. Die Seite an der Flussmauer benötigt keinen Zaun. 1. Hauptbedingung (Zielfunktion): Formuliere den Flächeninhalt "
            },
            {
              "type": "math",
              "tex": "A(a, b)",
              "speech": "A von a und b"
            },
            {
              "type": "text",
              "text": " des Rechtecks, 2. Nebenbedingung: Stelle die Gleichung für die gegebene Zaunlänge auf, 3. Zielfunktion in einer Variablen "
            },
            {
              "type": "math",
              "tex": "A(a)",
              "speech": "A von a"
            },
            {
              "type": "text",
              "text": ": Drücke die Fläche nur in Abhängigkeit von der senkrecht zur Mauer stehenden Seitenlänge "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": " aus und bestimme den ökonomisch sinnvollen Definitionsbereich "
            },
            {
              "type": "math",
              "tex": "\\mathbb{D}_A",
              "speech": "D A"
            },
            {
              "type": "text",
              "text": ", 4. Extremwertbestimmung & Randwertvergleich: Berechne die optimalen Seitenlängen "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "b",
              "speech": "b"
            },
            {
              "type": "text",
              "text": " sowie den maximalen Flächeninhalt "
            },
            {
              "type": "math",
              "tex": "A_{\\text{max}}",
              "speech": "A max"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Extremwertproblem: Hauptbedingung "
            },
            {
              "type": "math",
              "tex": "A = a \\cdot b",
              "speech": "A gleich a mal b"
            },
            {
              "type": "text",
              "text": "; Nebenbedingung "
            },
            {
              "type": "math",
              "tex": "2a + b = 40 \\Rightarrow b = 40 - 2a",
              "speech": "2 a plus b gleich 40, daraus folgt b gleich 40 minus 2 a"
            },
            {
              "type": "text",
              "text": "; Zielfunktion "
            },
            {
              "type": "math",
              "tex": "A(a) = a \\cdot (40 - 2a) = 40a - 2a^2",
              "speech": "A von a gleich a mal Klammer auf 40 minus 2 a Klammer zu gleich 40 a minus 2 a Quadrat"
            },
            {
              "type": "text",
              "text": "; Ableitung "
            },
            {
              "type": "math",
              "tex": "A'(a) = 40 - 4a = 0 \\Rightarrow a = 10\\,\\text{m}",
              "speech": "A Strich von a gleich 40 minus 4 a gleich 0, daraus folgt a gleich 10 Meter"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "b = 20\\,\\text{m}",
              "speech": "b gleich 20 Meter"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "A_{\\text{max}} = 200\\,\\text{m}^2",
              "speech": "A max gleich 200 Quadratmeter"
            },
            {
              "type": "text",
              "text": "; Randwerte "
            },
            {
              "type": "math",
              "tex": "A(0) = A(20) = 0",
              "speech": "A von 0 gleich A von 20 gleich 0"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Systematischer 4-Schritte-Lösungsplan für Extremwertprobleme: - 1. Schritt: Hauptbedingung (Was soll maximal werden?):   * Der Flächeninhalt des rechteckigen Geheges mit den Seitenlängen "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": " (Breite senkrecht zur Mauer) und "
            },
            {
              "type": "math",
              "tex": "b"
            },
            {
              "type": "text",
              "text": " (Länge parallel zur Mauer):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A(a, b) = a \\cdot b} \\longrightarrow \\text{maximal!}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Schritt: Nebenbedingung (Welche Restriktion liegt vor?):   * Da die Flussmauer keinen Zaun benötigt, besteht die Zaunlänge aus zwei Breiten "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": " und einer Länge "
            },
            {
              "type": "math",
              "tex": "b"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{2a + b = 40\\,\\text{m}} \\implies \\mathbf{b = 40 - 2a}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 3. Schritt: Zielfunktion "
            },
            {
              "type": "math",
              "tex": "A(a)"
            },
            {
              "type": "text",
              "text": " in einer Variablen:   * Einsetzen der Nebenbedingung in die Hauptbedingung:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A(a) = a \\cdot (40 - 2a) = 40a - 2a^2}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Definitionsbereich: Seitenlängen müssen positiv sein "
            },
            {
              "type": "math",
              "tex": "\\implies a > 0"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "b = 40 - 2a > 0 \\implies a < 20"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\mathbb{D}_A = [0; 20]}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Extremwertbestimmung mittels Differentialrechnung: - 1. Ableitung bilden und Null setzen:   "
            },
            {
              "type": "math",
              "tex": "A'(a) = 40 - 4a",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "A'(a) = 0 \\iff 40 - 4a = 0 \\implies 4a = 40 \\implies \\mathbf{a = 10\\,\\text{m}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Ableitung zur Überprüfung auf Maximum:   "
            },
            {
              "type": "math",
              "tex": "A''(a) = -4 < 0 \\quad \\forall a \\implies \\mathbf{\\text{globales Maximum}}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Seitenlängen, Maximalfläche und Randwertvergleich: - Optimale Abmessungen:   * Breite: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{a = 10\\,\\text{m}}"
            },
            {
              "type": "text",
              "text": "   * Länge: "
            },
            {
              "type": "math",
              "tex": "b = 40 - 2(10) = \\mathbf{20\\,\\text{m}}"
            },
            {
              "type": "text",
              "text": " - Maximaler Flächeninhalt:   "
            },
            {
              "type": "math",
              "tex": "A_{\\text{max}} = A(10) = 10\\,\\text{m} \\cdot 20\\,\\text{m} = \\mathbf{200\\,\\text{m}^2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Randwertvergleich (Randextrema):   * "
            },
            {
              "type": "math",
              "tex": "A(0) = 0\\,\\text{m}^2"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "A(20) = 0\\,\\text{m}^2"
            },
            {
              "type": "text",
              "text": ".   * Das innere Maximum "
            },
            {
              "type": "math",
              "tex": "A(10) = 200\\,\\text{m}^2"
            },
            {
              "type": "text",
              "text": " ist somit das absolute globale Maximum."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    }
  ]
