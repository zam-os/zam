      "practice_items": [
        {
          "id": "01K8GB00000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Welche hinreichende Bedingung garantiert die Existenz eines relativen Hochpunkts (lokales Maximum) an einer Stelle "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": " mit waagrechter Tangente "
            },
            {
              "type": "math",
              "tex": "f'(x_0) = 0",
              "speech": "f Strich von x null gleich 0"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept": "f''(x_0) < 0 (Rechtskrümmung der Kurve im Extrempunkt)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "f''(x_0) < 0 (Graph ist rechtsgekrümmt -> Maximum)",
              "f''(x_0) > 0"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GB00000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Führe eine vollständige mathematische Kurvendiskussion für die ganzrationale Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = x^3 - 3x^2 + 4",
              "speech": "f von x gleich x hoch drei minus 3 x Quadrat plus 4"
            },
            {
              "type": "text",
              "text": " durch: 1. Ableitungen: Bestimme "
            },
            {
              "type": "math",
              "tex": "f'(x)",
              "speech": "f Strich von x"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "f''(x)",
              "speech": "f Strich Strich von x"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "f'''(x)",
              "speech": "f Strich Strich Strich von x"
            },
            {
              "type": "text",
              "text": ", 2. Achsenschnittpunkte & Nullstellen:   * Schnittpunkt mit der "
            },
            {
              "type": "math",
              "tex": "y",
              "speech": "y"
            },
            {
              "type": "text",
              "text": "-Achse: "
            },
            {
              "type": "math",
              "tex": "S_y(0|f(0))",
              "speech": "S y mit den Koordinaten 0 und f von 0"
            },
            {
              "type": "text",
              "text": ".   * Nullstellen: Bestimme die Nullstellen von "
            },
            {
              "type": "math",
              "tex": "f(x)",
              "speech": "f von x"
            },
            {
              "type": "text",
              "text": " (Tipp: "
            },
            {
              "type": "math",
              "tex": "x_1 = -1",
              "speech": "x eins gleich minus 1"
            },
            {
              "type": "text",
              "text": " durch Erraten und Polynomdivision/Linearfaktorzerlegung), 3. Extrempunkte & Monotonie:   * Notwendige Bedingung: "
            },
            {
              "type": "math",
              "tex": "f'(x) = 0",
              "speech": "f Strich von x gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Hinreichende Bedingung: "
            },
            {
              "type": "math",
              "tex": "f''(x_E) \\neq 0",
              "speech": "f Strich Strich von x E ungleich 0"
            },
            {
              "type": "text",
              "text": " (Klassifikation in Tiefpunkt / Hochpunkt mit Koordinaten), 4. Wendepunkte & Krümmungsverhalten:   * Notwendige Bedingung: "
            },
            {
              "type": "math",
              "tex": "f''(x) = 0",
              "speech": "f Strich Strich von x gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Hinreichende Bedingung: "
            },
            {
              "type": "math",
              "tex": "f'''(x_W) \\neq 0",
              "speech": "f Strich Strich Strich von x W ungleich 0"
            },
            {
              "type": "text",
              "text": " (Bestimmung des Wendepunkts "
            },
            {
              "type": "math",
              "tex": "W",
              "speech": "W"
            },
            {
              "type": "text",
              "text": ")."
            }
          ],
          "concept": "Kurvendiskussion: Ableitungen f', f'', f'''; Nullstellen (x=-1, x=2 doppelt); Extrempunkte: f'=0 -> x=0 (HP(0|4) da f''=-6<0), x=2 (TP(2|0) da f''=6>0); Wendepunkt: f''=0 -> x=1 (WP(1|2) da f'''=6!=0).",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Bestimmung der Ableitungsfunktionen: - Ausgangsfunktion: "
            },
            {
              "type": "math",
              "tex": "f(x) = x^3 - 3x^2 + 4"
            },
            {
              "type": "text",
              "text": " - 1. Ableitung: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f'(x) = 3x^2 - 6x}"
            },
            {
              "type": "text",
              "text": " - 2. Ableitung: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f''(x) = 6x - 6}"
            },
            {
              "type": "text",
              "text": " - 3. Ableitung: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f'''(x) = 6}"
            },
            {
              "type": "text",
              "text": " 2. Schnittpunkte mit den Koordinatenachsen: - "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achsenschnittpunkt: "
            },
            {
              "type": "math",
              "tex": "f(0) = 0 - 0 + 4 = 4 \\implies \\mathbf{S_y(0 \\mid 4)}"
            },
            {
              "type": "text",
              "text": " - Nullstellen ("
            },
            {
              "type": "math",
              "tex": "f(x) = 0"
            },
            {
              "type": "text",
              "text": "):   * Erraten einer ganzzahligen Nullstelle aus den Teilern von "
            },
            {
              "type": "math",
              "tex": "4"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "f(-1) = (-1)^3 - 3(-1)^2 + 4 = -1 - 3 + 4 = 0 \\implies \\mathbf{x_1 = -1}"
            },
            {
              "type": "text",
              "text": ".   * Polynomdivision: "
            },
            {
              "type": "math",
              "tex": "(x^3 - 3x^2 + 4) : (x + 1) = x^2 - 4x + 4 = (x - 2)^2"
            },
            {
              "type": "text",
              "text": ".   * Weitere Nullstellen: "
            },
            {
              "type": "math",
              "tex": "(x - 2)^2 = 0 \\implies \\mathbf{x_{2/3} = 2}"
            },
            {
              "type": "text",
              "text": " (doppelte Nullstelle / Berührpunkt!).   * Nullstellen: "
            },
            {
              "type": "math",
              "tex": "N_1(-1 \\mid 0)"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "N_2(2 \\mid 0)"
            },
            {
              "type": "text",
              "text": ". 3. Extrempunkte und Monotonie: - Notwendige Bedingung: "
            },
            {
              "type": "math",
              "tex": "f'(x) = 0"
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "3x^2 - 6x = 0 \\iff 3x(x - 2) = 0 \\implies \\mathbf{x_{E1} = 0}, \\quad \\mathbf{x_{E2} = 2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Hinreichende Bedingung ("
            },
            {
              "type": "math",
              "tex": "f''(x)"
            },
            {
              "type": "text",
              "text": "):   * Für "
            },
            {
              "type": "math",
              "tex": "x_{E1} = 0"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "f''(0) = 6(0) - 6 = -6 < 0 \\implies \\mathbf{\\text{relatives Maximum (Hochpunkt)}}",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "y = f(0) = 4 \\implies \\mathbf{HP(0 \\mid 4)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Für "
            },
            {
              "type": "math",
              "tex": "x_{E2} = 2"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "f''(2) = 6(2) - 6 = +6 > 0 \\implies \\mathbf{\\text{relatives Minimum (Tiefpunkt)}}",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "y = f(2) = 2^3 - 3(2)^2 + 4 = 8 - 12 + 4 = 0 \\implies \\mathbf{TP(2 \\mid 0)}",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Wendepunkte und Krümmungsverhalten: - Notwendige Bedingung: "
            },
            {
              "type": "math",
              "tex": "f''(x) = 0"
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "6x - 6 = 0 \\implies 6x = 6 \\implies \\mathbf{x_W = 1}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Hinreichende Bedingung:   "
            },
            {
              "type": "math",
              "tex": "f'''(1) = 6 \\neq 0 \\implies \\mathbf{\\text{echter Wendepunkt mit Krümmungswechsel}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Koordinate des Wendepunkts:   "
            },
            {
              "type": "math",
              "tex": "f(1) = 1^3 - 3(1)^2 + 4 = 1 - 3 + 4 = 2 \\implies \\mathbf{W(1 \\mid 2)}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Krümmung: Für "
            },
            {
              "type": "math",
              "tex": "x < 1"
            },
            {
              "type": "text",
              "text": " ist "
            },
            {
              "type": "math",
              "tex": "f''(x) < 0"
            },
            {
              "type": "text",
              "text": " (rechtsgekrümmt/konkav); für "
            },
            {
              "type": "math",
              "tex": "x > 1"
            },
            {
              "type": "text",
              "text": " ist "
            },
            {
              "type": "math",
              "tex": "f''(x) > 0"
            },
            {
              "type": "text",
              "text": " (linksgekrümmt/konvex)."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
