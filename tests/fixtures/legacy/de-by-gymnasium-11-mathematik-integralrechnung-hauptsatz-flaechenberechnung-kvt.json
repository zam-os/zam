        {
          "id": "01K8GB10000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die Grundlagen der Integralrechnung und den Hauptsatz: 1. Definition der Stammfunktion:   * Eine differenzierbare Funktion "
            },
            {
              "type": "math",
              "tex": "F(x)",
              "speech": "F von x"
            },
            {
              "type": "text",
              "text": " heißt Stammfunktion von "
            },
            {
              "type": "math",
              "tex": "f(x)",
              "speech": "f von x"
            },
            {
              "type": "text",
              "text": " auf einem Intervall "
            },
            {
              "type": "math",
              "tex": "I",
              "speech": "I"
            },
            {
              "type": "text",
              "text": ", wenn gilt:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{F'(x) = f(x)} \\quad \\forall x \\in I",
              "block": true,
              "speech": "F Strich von x gleich f von x, für alle x Element von I"
            },
            {
              "type": "text",
              "text": "   * Zwei Stammfunktionen derselben Funktion "
            },
            {
              "type": "math",
              "tex": "f",
              "speech": "f"
            },
            {
              "type": "text",
              "text": " unterscheiden sich nur um eine additive Integrationskonstante "
            },
            {
              "type": "math",
              "tex": "C \\in \\mathbb{R}",
              "speech": "C Element der reellen Zahlen"
            },
            {
              "type": "text",
              "text": ", 2. Elementare Integrationsregeln:   * Potenzregel: "
            },
            {
              "type": "math",
              "tex": "\\int x^n \\,\\mathrm{d}x = \\frac{1}{n+1} x^{n+1} + C",
              "speech": "Integral über x hoch n d x gleich 1 durch n plus 1 mal x hoch n plus 1 plus C"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "n \\neq -1",
              "speech": "n ungleich minus 1"
            },
            {
              "type": "text",
              "text": ").   * Faktorregel: "
            },
            {
              "type": "math",
              "tex": "\\int (c \\cdot f(x)) \\,\\mathrm{d}x = c \\cdot \\int f(x) \\,\\mathrm{d}x",
              "speech": "Integral über Klammer auf c mal f von x Klammer zu d x gleich c mal Integral über f von x d x"
            },
            {
              "type": "text",
              "text": ".   * Summenregel: "
            },
            {
              "type": "math",
              "tex": "\\int (f(x) + g(x)) \\,\\mathrm{d}x = \\int f(x) \\,\\mathrm{d}x + \\int g(x) \\,\\mathrm{d}x",
              "speech": "Integral über Klammer auf f von x plus g von x Klammer zu d x gleich Integral über f von x d x plus Integral über g von x d x"
            },
            {
              "type": "text",
              "text": ", 3. Der Hauptsatz der Differential- und Integralrechnung (HDI):   * Verknüpft die Flächenberechnung mit der Umkehrung des Differenzierens:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int_a^b f(x) \\,\\mathrm{d}x = [F(x)]_a^b = F(b) - F(a)}",
              "block": true,
              "speech": "Integral von a bis b über f von x d x gleich F von x in den Grenzen von a bis b gleich F von b minus F von a"
            },
            {
              "type": "text",
              "text": " 4. Berechne das bestimmte Integral "
            },
            {
              "type": "math",
              "tex": "\\int_{1}^{3} (3x^2 - 4x + 2) \\,\\mathrm{d}x",
              "speech": "Integral von 1 bis 3 über Klammer auf 3 x Quadrat minus 4 x plus 2 Klammer zu d x"
            },
            {
              "type": "text",
              "text": " exakt mithilfe einer Stammfunktion."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Integralrechnung: Stammfunktion "
            },
            {
              "type": "math",
              "tex": "F'(x) = f(x)",
              "speech": "F Strich von x gleich f von x"
            },
            {
              "type": "text",
              "text": "; Potenzregel; Hauptsatz "
            },
            {
              "type": "math",
              "tex": "\\int_a^b f(x)\\,dx = [F(x)]_a^b = F(b) - F(a)",
              "speech": "Integral von a bis b über f von x d x gleich F von x in den Grenzen von a bis b gleich F von b minus F von a"
            },
            {
              "type": "text",
              "text": "; Rechnung: "
            },
            {
              "type": "math",
              "tex": "F(x) = x^3 - 2x^2 + 2x",
              "speech": "F von x gleich x hoch drei minus 2 x Quadrat plus 2 x"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "F(3) = 27 - 18 + 6 = 15",
              "speech": "F von 3 gleich 27 minus 18 plus 6 gleich 15"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "F(1) = 1 - 2 + 2 = 1",
              "speech": "F von 1 gleich 1 minus 2 plus 2 gleich 1"
            },
            {
              "type": "text",
              "text": "; Integral "
            },
            {
              "type": "math",
              "tex": "= 15 - 1 = 14",
              "speech": "gleich 15 minus 1 gleich 14"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Der Begriff der Stammfunktion und das unbestimmte Integral: - Definition: Eine Funktion "
            },
            {
              "type": "math",
              "tex": "F"
            },
            {
              "type": "text",
              "text": " ist eine Stammfunktion von "
            },
            {
              "type": "math",
              "tex": "f"
            },
            {
              "type": "text",
              "text": ", wenn ihre Ableitung exakt mit "
            },
            {
              "type": "math",
              "tex": "f"
            },
            {
              "type": "text",
              "text": " übereinstimmt:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{F'(x) = f(x)}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Menge aller Stammfunktionen (Unbestimmtes Integral):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int f(x) \\,\\mathrm{d}x = F(x) + C} \\quad (C \\in \\mathbb{R} = \\text{Integrationskonstante})",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Grundlegende Integrationsregeln: - 1. Potenzregel:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int x^n \\,\\mathrm{d}x = \\frac{1}{n+1} x^{n+1} + C} \\quad (n \\in \\mathbb{R} \\setminus \\{-1\\})",
              "block": true
            },
            {
              "type": "text",
              "text": "   (z. B. "
            },
            {
              "type": "math",
              "tex": "\\int x^3 \\,\\mathrm{d}x = \\frac{1}{4}x^4 + C"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "\\int \\sqrt{x} \\,\\mathrm{d}x = \\int x^{1/2} \\,\\mathrm{d}x = \\frac{2}{3}x^{3/2} + C"
            },
            {
              "type": "text",
              "text": ") - 2. Faktorregel:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int c \\cdot f(x) \\,\\mathrm{d}x = c \\cdot \\int f(x) \\,\\mathrm{d}x} \\quad (c \\in \\mathbb{R})",
              "block": true
            },
            {
              "type": "text",
              "text": " - 3. Summenregel:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int (f(x) \\pm g(x)) \\,\\mathrm{d}x = \\int f(x) \\,\\mathrm{d}x \\pm \\int g(x) \\,\\mathrm{d}x}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Der Hauptsatz der Differential- und Integralrechnung (HDI): - Das bestimmte Integral "
            },
            {
              "type": "math",
              "tex": "\\int_a^b f(x)\\,\\mathrm{d}x"
            },
            {
              "type": "text",
              "text": " beschreibt den orientierten Flächeninhalt zwischen dem Graphen von "
            },
            {
              "type": "math",
              "tex": "f"
            },
            {
              "type": "text",
              "text": " und der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse im Intervall "
            },
            {
              "type": "math",
              "tex": "[a; b]"
            },
            {
              "type": "text",
              "text": ". - Berechnungsformel nach Newton und Leibniz:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int_a^b f(x) \\,\\mathrm{d}x = \\Big[ F(x) \\Big]_a^b = F(b) - F(a)}",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Durchrechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "\\int_1^3 (3x^2 - 4x + 2) \\,\\mathrm{d}x"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Bestimmung einer Stammfunktion "
            },
            {
              "type": "math",
              "tex": "F(x)"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "F(x) = 3 \\cdot \\left(\\frac{x^3}{3}\\right) - 4 \\cdot \\left(\\frac{x^2}{2}\\right) + 2x = \\mathbf{x^3 - 2x^2 + 2x}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Auswertung an den Integrationsgrenzen "
            },
            {
              "type": "math",
              "tex": "a = 1"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "b = 3"
            },
            {
              "type": "text",
              "text": ":   * Obere Grenze "
            },
            {
              "type": "math",
              "tex": "b = 3"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "F(3) = 3^3 - 2(3)^2 + 2(3) = 27 - 18 + 6 = \\mathbf{15}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Untere Grenze "
            },
            {
              "type": "math",
              "tex": "a = 1"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "F(1) = 1^3 - 2(1)^2 + 2(1) = 1 - 2 + 2 = \\mathbf{1}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 3: Differenz "
            },
            {
              "type": "math",
              "tex": "F(3) - F(1)"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\int_1^3 (3x^2 - 4x + 2) \\,\\mathrm{d}x = 15 - 1 = \\mathbf{14}",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
