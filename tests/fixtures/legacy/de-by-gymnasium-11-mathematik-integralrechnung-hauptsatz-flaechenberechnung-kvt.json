          "sample_solution": [
            {
              "type": "text",
              "text": "1. Geometrische Fläche vs. Orientierter Integralwert: - Das Integral "
            },
            {
              "type": "math",
              "tex": "\\int_a^b f(x)\\,\\mathrm{d}x"
            },
            {
              "type": "text",
              "text": " wertet Flächenstücke oberhalb der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse positiv ("
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": ") und unterhalb der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse negativ ("
            },
            {
              "type": "math",
              "tex": "-"
            },
            {
              "type": "text",
              "text": ") aus. - Geometrischer Flächeninhalt "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": ":   * Muss stets positiv sein ("
            },
            {
              "type": "math",
              "tex": "A \\ge 0"
            },
            {
              "type": "text",
              "text": "). Bei Vorzeichenwechseln (Nullstellen) muss das Intervall an jeder Nullstelle geteilt werden:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A = \\sum_{i} \\left| \\int_{x_i}^{x_{i+1}} f(x)\\,\\mathrm{d}x \\right|}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Flächeninhalt zwischen zwei Funktionsgraphen "
            },
            {
              "type": "math",
              "tex": "f"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "g"
            },
            {
              "type": "text",
              "text": ": - Liegt im Intervall "
            },
            {
              "type": "math",
              "tex": "[x_1; x_2]"
            },
            {
              "type": "text",
              "text": " der Graph von "
            },
            {
              "type": "math",
              "tex": "f"
            },
            {
              "type": "text",
              "text": " oberhalb des Graphen von "
            },
            {
              "type": "math",
              "tex": "g"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "f(x) \\ge g(x)"
            },
            {
              "type": "text",
              "text": "), so ist der Flächeninhalt die Differenz:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A = \\int_{x_1}^{x_2} \\big( f(x) - g(x) \\big) \\,\\mathrm{d}x}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Durchrechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "f(x) = -x^2 + 4"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "g(x) = x^2 - 4"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Schnittstellen berechnen ("
            },
            {
              "type": "math",
              "tex": "f(x) = g(x)"
            },
            {
              "type": "text",
              "text": "):   "
            },
            {
              "type": "math",
              "tex": "-x^2 + 4 = x^2 - 4 \\implies 2x^2 = 8 \\implies x^2 = 4 \\implies \\mathbf{x_1 = -2}, \\quad \\mathbf{x_2 = +2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Differenzfunktion "
            },
            {
              "type": "math",
              "tex": "d(x) = f(x) - g(x)"
            },
            {
              "type": "text",
              "text": ":   * Da "
            },
            {
              "type": "math",
              "tex": "f(0) = 4 > g(0) = -4"
            },
            {
              "type": "text",
              "text": ", verläuft "
            },
            {
              "type": "math",
              "tex": "f(x)"
            },
            {
              "type": "text",
              "text": " oben und "
            },
            {
              "type": "math",
              "tex": "g(x)"
            },
            {
              "type": "text",
              "text": " unten:     "
            },
            {
              "type": "math",
              "tex": "d(x) = (-x^2 + 4) - (x^2 - 4) = \\mathbf{8 - 2x^2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 3: Integration der Differenzfunktion:   "
            },
            {
              "type": "math",
              "tex": "A = \\int_{-2}^{2} (8 - 2x^2) \\,\\mathrm{d}x = \\left[ 8x - \\frac{2}{3}x^3 \\right]_{-2}^{2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 4: Auswertung an den Grenzen:   * Obere Grenze ("
            },
            {
              "type": "math",
              "tex": "x = 2"
            },
            {
              "type": "text",
              "text": "):     "
            },
            {
              "type": "math",
              "tex": "8(2) - \\frac{2}{3}(2)^3 = 16 - \\frac{16}{3} = \\frac{48 - 16}{3} = \\mathbf{\\frac{32}{3}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Untere Grenze ("
            },
            {
              "type": "math",
              "tex": "x = -2"
            },
            {
              "type": "text",
              "text": "):     "
            },
            {
              "type": "math",
              "tex": "8(-2) - \\frac{2}{3}(-2)^3 = -16 + \\frac{16}{3} = \\mathbf{-\\frac{32}{3}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Gesamter Flächeninhalt:     "
            },
            {
              "type": "math",
              "tex": "A = \\frac{32}{3} - \\left( -\\frac{32}{3} \\right) = \\frac{64}{3} = \\mathbf{21\\frac{1}{3}\\,\\text{FE (Flächeneinheiten)} \\approx 21{,}33\\,\\text{FE}}",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    }
  ]
