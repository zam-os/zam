          "question_segments": [
            {
              "type": "text",
              "text": "Wie lautet die unbestimmte Stammfunktion "
            },
            {
              "type": "math",
              "tex": "\\int x^n \\,\\mathrm{d}x",
              "speech": "Integral über x hoch n d x"
            },
