      "practice_items": [
        {
          "id": "01K8GB10000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Warum darf man zur Berechnung des geometrischen Flächeninhalts zwischen einem Graphen und der "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse nicht einfach über Nullstellen hinweg integrieren?"
            }
          ],
          "concept": "Weil Flächen unterhalb der x-Achse ein negatives Vorzeichen im Integral besitzen und sich mit Flächen oberhalb der x-Achse gegenseitig aufheben würden (orientierter Flächeninhalt)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Weil sich positive und negative Flächenanteile aufheben würden",
              "Weil das Integral an Nullstellen nicht definiert ist"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GB10000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die Methodik der geometrischen Flächenberechnung mit Integralen: 1. Fläche zwischen Funktionsgraph und "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse (Nullstellenzerlegung):   * Schritt 1: Bestimmung aller Nullstellen "
            },
            {
              "type": "math",
              "tex": "x_1, x_2, \\dots",
              "speech": "x eins, x zwei, und so weiter"
            },
            {
              "type": "text",
              "text": " im Intervall "
            },
            {
              "type": "math",
              "tex": "[a; b]",
              "speech": "Intervall von a bis b"
            },
            {
              "type": "text",
              "text": ".   * Schritt 2: Aufteilung des Integrals in Teilintervalle von Nullstelle zu Nullstelle.   * Schritt 3: Summation der Beträge der Teilintegrale:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A = |\\int_a^{x_1} f(x)\\,\\mathrm{d}x| + |\\int_{x_1}^b f(x)\\,\\mathrm{d}x|}",
              "block": true,
              "speech": "A gleich Betrag des Integrals von a bis x eins über f von x d x, plus Betrag des Integrals von x eins bis b über f von x d x"
            },
            {
              "type": "text",
              "text": " 2. Fläche zwischen zwei sich schneidenden Funktionsgraphen "
            },
            {
              "type": "math",
              "tex": "f(x)",
              "speech": "f von x"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "g(x)",
              "speech": "g von x"
            },
            {
              "type": "text",
              "text": ":   * Schritt 1: Schnittstellen bestimmen durch Gleichsetzen "
            },
            {
              "type": "math",
              "tex": "f(x) = g(x) \\implies d(x) = f(x) - g(x) = 0",
              "speech": "f von x gleich g von x, daraus folgt d von x gleich f von x minus g von x gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Schritt 2: Integration der Differenzfunktion ('obere Kurve minus untere Kurve'):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A = \\int_{x_1}^{x_2} (f(x) - g(x)) \\,\\mathrm{d}x}",
              "block": true,
              "speech": "A gleich Integral von x eins bis x zwei über, f von x minus g von x, d x"
            },
            {
              "type": "text",
              "text": " 3. Berechne den Inhalt der Fläche, die von den Parabeln "
            },
            {
              "type": "math",
              "tex": "f(x) = -x^2 + 4",
              "speech": "f von x gleich minus x Quadrat plus 4"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "g(x) = x^2 - 4",
              "speech": "g von x gleich x Quadrat minus 4"
            },
            {
              "type": "text",
              "text": " vollständig eingeschlossen wird."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Flächenberechnung: Nullstellenzerlegung; Fläche zwischen zwei Graphen "
            },
            {
              "type": "math",
              "tex": "A = \\int (\\text{obere Kurve} - \\text{untere Kurve})\\,dx",
              "speech": "A gleich Integral über, obere Kurve minus untere Kurve, d x"
            },
            {
              "type": "text",
              "text": "; Rechnung: Schnittstellen "
            },
            {
              "type": "math",
              "tex": "-x^2 + 4 = x^2 - 4 \\Rightarrow 2x^2 = 8 \\Rightarrow x = \\pm 2",
              "speech": "minus x Quadrat plus 4 gleich x Quadrat minus 4 daraus folgt 2 x Quadrat gleich 8 daraus folgt x gleich plus minus 2"
            },
            {
              "type": "text",
              "text": "; Differenz "
            },
            {
              "type": "math",
              "tex": "d(x) = 8 - 2x^2",
              "speech": "d von x gleich 8 minus 2 x Quadrat"
            },
            {
              "type": "text",
              "text": "; Stammfunktion "
            },
            {
              "type": "math",
              "tex": "D(x) = 8x - \\frac{2}{3} x^3",
              "speech": "D von x gleich 8 x minus zwei Drittel x hoch drei"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
