      "practice_items": [
        {
          "id": "01K4M7W0000000000000000J07",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "In welchem Verhältnis teilt der physikalische Schwerpunkt "
            },
            {
              "type": "math",
              "tex": "S",
              "speech": "S"
            },
            {
              "type": "text",
              "text": " eines Dreiecks jede der drei Seitenhalbierenden (vom Eckpunkt zur gegenüberliegenden Seite gemessen)?"
            }
          ],
          "concept": "Im festen Teilungsverhältnis 2 : 1 (zwei Teile vom Eckpunkt zum Schwerpunkt, ein Teil vom Schwerpunkt zum Seitenmittelpunkt)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Im Verhältnis 2 : 1 (Ecke zu Seite)",
              "Im Verhältnis 1 : 1 (genau in der Mitte)"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K4M7W0000000000000000J08",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Systematisiere die vier klassischen besonderen Punkte im Dreieck und ihre Linien: 1. Umkreismittelpunkt "
            },
            {
              "type": "math",
              "tex": "U",
              "speech": "U"
            },
            {
              "type": "text",
              "text": ": Schnittpunkt der 3 Mittelsenkrechten ("
            },
            {
              "type": "math",
              "tex": "m_a, m_b, m_c",
              "speech": "m a, m b, m c"
            },
            {
              "type": "text",
              "text": "); hat zu allen 3 Ecken den gleichen Abstand ("
            },
            {
              "type": "math",
              "tex": "r_u = |UA| = |UB| = |UC|",
              "speech": "r u gleich Länge U A gleich Länge U B gleich Länge U C"
            },
            {
              "type": "text",
              "text": "; liegt bei rechtwinkligen Dreiecken genau in der Mitte der Hypotenuse [Thaleskreis] und bei stumpfwinkligen außerhalb), 2. Inkreismittelpunkt "
            },
            {
              "type": "math",
              "tex": "I",
              "speech": "I"
            },
            {
              "type": "text",
              "text": ": Schnittpunkt der 3 Winkelhalbierenden ("
            },
            {
              "type": "math",
              "tex": "w_\\alpha, w_\\beta, w_\\gamma",
              "speech": "w Alpha, w Beta, w Gamma"
            },
            {
              "type": "text",
              "text": "); berührt alle 3 Dreiecksseiten von innen ("
            },
            {
              "type": "math",
              "tex": "r_i = d(I, a) = d(I, b) = d(I, c)",
              "speech": "r i gleich d von I und a gleich d von I und b gleich d von I und c"
            },
            {
              "type": "text",
              "text": "), 3. Schwerpunkt "
            },
            {
              "type": "math",
              "tex": "S",
              "speech": "S"
            },
            {
              "type": "text",
              "text": ": Schnittpunkt der 3 Seitenhalbierenden ("
            },
            {
              "type": "math",
              "tex": "s_a, s_b, s_c",
              "speech": "s a, s b, s c"
            },
            {
              "type": "text",
              "text": "); physikalischer Massenmittelpunkt mit Teilungsverhältnis 2:1, 4. Höhenschnittpunkt "
            },
            {
              "type": "math",
              "tex": "H",
              "speech": "H"
            },
            {
              "type": "text",
              "text": ": Schnittpunkt der 3 Höhengeraden ("
            },
            {
              "type": "math",
              "tex": "h_a, h_b, h_c",
              "speech": "h a, h b, h c"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "h_a \\perp a",
              "speech": "h a senkrecht zu a"
            },
            {
              "type": "text",
              "text": "); liegt bei stumpfwinkligen Dreiecken außerhalb, 5. Die Eulersche Gerade: "
            },
            {
              "type": "math",
              "tex": "U, S, H",
              "speech": "U, S, H"
            },
            {
              "type": "text",
              "text": " liegen auf einer gemeinsamen Geraden."
            }
          ],
          "concept": "4 Besondere Punkte: U (Mittelsenkrechte, Umkreis), I (Winkelhalbierende, Inkreis), S (Seitenhalbierende, Schwerpunkt 2:1), H (Höhen); Eulersche Gerade verbindet U, S, H mit HS : SU = 2 : 1.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Die vier klassischen merkwürdigen Punkte des Dreiecks: - 1. Der Umkreismittelpunkt "
            },
            {
              "type": "math",
              "tex": "U"
            },
            {
              "type": "text",
              "text": " (Schnittpunkt der Mittelsenkrechten "
            },
            {
              "type": "math",
              "tex": "m_a \\cap m_b \\cap m_c"
            },
            {
              "type": "text",
              "text": "):   * Eigenschaft: Da jeder Punkt auf "
            },
            {
              "type": "math",
              "tex": "m_c"
            },
            {
              "type": "text",
              "text": " gleichen Abstand zu "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": " hat und auf "
            },
            {
              "type": "math",
              "tex": "m_a"
            },
            {
              "type": "text",
              "text": " gleichen Abstand zu "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "C"
            },
            {
              "type": "text",
              "text": ", ist der Abstand von "
            },
            {
              "type": "math",
              "tex": "U"
            },
            {
              "type": "text",
              "text": " zu allen drei Ecken identisch:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{r_u = |\\overline{UA}| = |\\overline{UB}| = |\\overline{UC}|}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Lage: Bei spitzwinkligen Dreiecken im Inneren; bei rechtwinkligen Dreiecken exakt im Mittelpunkt der Hypotenuse (Satz des Thales); bei stumpfwinkligen Dreiecken außerhalb des Dreiecks. - 2. Der Inkreismittelpunkt "
            },
            {
              "type": "math",
              "tex": "I"
            },
            {
              "type": "text",
              "text": " (Schnittpunkt der Winkelhalbierenden "
            },
            {
              "type": "math",
              "tex": "w_\\alpha \\cap w_\\beta \\cap w_\\gamma"
            },
            {
              "type": "text",
              "text": "):   * Eigenschaft: Hat zu allen drei Begrenzungsgeraden "
            },
            {
              "type": "math",
              "tex": "a, b, c"
            },
            {
              "type": "text",
              "text": " denselben orthogonalen Abstand "
            },
            {
              "type": "math",
              "tex": "r_i"
            },
            {
              "type": "text",
              "text": ". Der Inkreis berührt alle drei Seiten von innen als Tangenten.   * Lage: Liegt immer im Inneren des Dreiecks. - 3. Der Schwerpunkt "
            },
            {
              "type": "math",
              "tex": "S"
            },
            {
              "type": "text",
              "text": " (Schnittpunkt der Seitenhalbierenden "
            },
            {
              "type": "math",
              "tex": "s_a \\cap s_b \\cap s_c"
            },
            {
              "type": "text",
              "text": "):   * Definition: Eine Seitenhalbierende verbindet einen Eckpunkt mit dem Mittelpunkt der gegenüberliegenden Seite (z. B. "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "M_a"
            },
            {
              "type": "text",
              "text": ").   * Teilungssatz: Der Schwerpunkt "
            },
            {
              "type": "math",
              "tex": "S"
            },
            {
              "type": "text",
              "text": " teilt jede Seitenhalbierende im Verhältnis "
            },
            {
              "type": "math",
              "tex": "2 : 1"
            },
            {
              "type": "text",
              "text": " (der längere Abschnitt liegt stets an der Dreiecksecke):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{|\\overline{AS}| : |\\overline{SM_a}| = 2 : 1}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Physik: Stützt man das homogene Dreieck im Schwerpunkt "
            },
            {
              "type": "math",
              "tex": "S"
            },
            {
              "type": "text",
              "text": ", befindet es sich im perfekten Drehmoment-Gleichgewicht. - 4. Der Höhenschnittpunkt "
            },
            {
              "type": "math",
              "tex": "H"
            },
            {
              "type": "text",
              "text": " (Schnittpunkt der Höhen "
            },
            {
              "type": "math",
              "tex": "h_a \\cap h_b \\cap h_c"
            },
            {
              "type": "text",
              "text": "):   * Definition: Eine Höhe ist das vom Eckpunkt auf die gegenüberliegende Seite (bzw. deren Trägergerade) gefällte Lot.   * Lage: Bei spitzwinkligen Dreiecken innen, beim rechtwinkligen Dreieck im Scheitel des rechten Winkels, beim stumpfwinkligen Dreieck außerhalb. 2. Die Eulersche Gerade: - In jedem nicht-gleichseitigen Dreieck liegen die drei Punkte Umkreismittelpunkt "
            },
            {
              "type": "math",
              "tex": "U"
            },
            {
              "type": "text",
              "text": ", Schwerpunkt "
            },
            {
              "type": "math",
              "tex": "S"
            },
            {
              "type": "text",
              "text": " und Höhenschnittpunkt "
            },
            {
              "type": "math",
              "tex": "H"
            },
            {
              "type": "text",
              "text": " auf einer einzigen gemeinsamen Geraden (Eulersche Gerade), wobei "
            },
            {
              "type": "math",
              "tex": "S"
            },
            {
              "type": "text",
              "text": " die Strecke "
            },
            {
              "type": "math",
              "tex": "[UH]"
            },
            {
              "type": "text",
              "text": " im Verhältnis "
            },
            {
              "type": "math",
              "tex": "|\\overline{HS}| : |\\overline{SU}| = 2 : 1"
            },
            {
              "type": "text",
              "text": " teilt."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    }
  ]
