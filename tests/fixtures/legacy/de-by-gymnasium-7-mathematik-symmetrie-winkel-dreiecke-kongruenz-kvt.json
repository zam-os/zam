      "practice_items": [
        {
          "id": "01K4M7W0000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Welche Ortslinie beschreibt die Menge aller Punkte der Ebene, die von zwei gegebenen Punkten "
            },
            {
              "type": "math",
              "tex": "A",
              "speech": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B",
              "speech": "B"
            },
            {
              "type": "text",
              "text": " den gleichen Abstand haben ("
            },
            {
              "type": "math",
              "tex": "d(P, A) = d(P, B)",
              "speech": "d von P und A gleich d von P und B"
            },
            {
              "type": "text",
              "text": ")?"
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Die Mittelsenkrechte "
            },
            {
              "type": "math",
              "tex": "m_{[AB]}",
              "speech": "Mittelsenkrechte der Strecke A B"
            },
            {
              "type": "text",
              "text": " der Strecke "
            },
            {
              "type": "math",
              "tex": "[AB]",
              "speech": "Strecke A B"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Die Mittelsenkrechte der Strecke [AB]",
              "Die Winkelhalbierende"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K4M7W0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Achsenspiegelung und Punktspiegelung sowie ihre elementaren Ortslinien: 1. Achsenspiegelung an der Geraden "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": ": Die Verbindungsstrecke "
            },
            {
              "type": "math",
              "tex": "[PP']",
              "speech": "Strecke P P Strich"
            },
            {
              "type": "text",
              "text": " wird von der Spiegelachse "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": " rechtwinklig halbiert ("
            },
            {
              "type": "math",
              "tex": "a \\perp [PP']",
              "speech": "a senkrecht zur Strecke P P Strich"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "d(P, a) = d(P', a)",
              "speech": "d von P und a gleich d von P Strich und a"
            },
            {
              "type": "text",
              "text": "); Eigenschaften: Längentreu, Winkeltreu, Kreistreu, Geradentreu, aber Orientierungssinn kehrt sich um (Gegensinnigkeit), 2. Punktspiegelung am Zentrum "
            },
            {
              "type": "math",
              "tex": "Z",
              "speech": "Z"
            },
            {
              "type": "text",
              "text": ": Das Zentrum "
            },
            {
              "type": "math",
              "tex": "Z",
              "speech": "Z"
            },
            {
              "type": "text",
              "text": " ist der Mittelpunkt der Strecke "
            },
            {
              "type": "math",
              "tex": "[PP']",
              "speech": "Strecke P P Strich"
            },
            {
              "type": "text",
              "text": "; entspricht einer Drehung um "
            },
            {
              "type": "math",
              "tex": "180^\\circ",
              "speech": "180 Grad"
            },
            {
              "type": "text",
              "text": "; Eigenschaften: Längen-, winkel- und gleichsinnig orientierungstreu, 3. Die beiden zentralen Ortslinien: Mittelsenkrechte "
            },
            {
              "type": "math",
              "tex": "m_{[AB]}",
              "speech": "Mittelsenkrechte der Strecke A B"
            },
            {
              "type": "text",
              "text": " (Punkte mit gleichem Abstand zu zwei Punkten) und Winkelhalbierende "
            },
            {
              "type": "math",
              "tex": "w_\\alpha",
              "speech": "w Alpha"
            },
            {
              "type": "text",
              "text": " (Punkte mit gleichem Abstand zu zwei sich schneidenden Geraden/Schenkeln)."
            }
          ],
          "concept": "Achsenspiegelung (Achse halbiert [PP'] orthogonal, gegensinnig); Punktspiegelung (Z halbiert [PP'], Drehung um 180°, gleichsinnig); Mittelsenkrechte (Abstand zu zwei Punkten gleich); Winkelhalbierende (Abstand zu zwei Geraden gleich).",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Achsenspiegelung (Geradenspiegelung "
            },
            {
              "type": "math",
              "tex": "S_a"
            },
            {
              "type": "text",
              "text": "): - Konstruktionsvorschrift: Zu jedem Punkt "
            },
            {
              "type": "math",
              "tex": "P"
            },
            {
              "type": "text",
              "text": " ist der Bildpunkt "
            },
            {
              "type": "math",
              "tex": "P'"
            },
            {
              "type": "text",
              "text": " so definiert, dass die Spiegelachse "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": " die Strecke "
            },
            {
              "type": "math",
              "tex": "[PP']"
            },
            {
              "type": "text",
              "text": " orthogonal halbiert. Punkte auf der Achse sind Fixpunkte ("
            },
            {
              "type": "math",
              "tex": "A = A'"
            },
            {
              "type": "text",
              "text": "). - Abbildungseigenschaften:   * Längentreu: "
            },
            {
              "type": "math",
              "tex": "|\\overline{AB}| = |\\overline{A'B'}|"
            },
            {
              "type": "text",
              "text": "   * Winkeltreu: "
            },
            {
              "type": "math",
              "tex": "\\sphericalangle ABC = \\sphericalangle A'B'C'"
            },
            {
              "type": "text",
              "text": "   * Geradentreu und Kreistreu   * Orientierungsumkehrend (Gegensinnig): Ein gegen den Uhrzeigersinn orientiertes Dreieck "
            },
            {
              "type": "math",
              "tex": "ABC"
            },
            {
              "type": "text",
              "text": " wird zu einem im Uhrzeigersinn orientierten Bilddreieck "
            },
            {
              "type": "math",
              "tex": "A'B'C'"
            },
            {
              "type": "text",
              "text": " (Spiegelbildcharakter). 2. Punktspiegelung (Zentrische Spiegelung "
            },
            {
              "type": "math",
              "tex": "S_Z"
            },
            {
              "type": "text",
              "text": "): - Konstruktionsvorschrift: Der Bildpunkt "
            },
            {
              "type": "math",
              "tex": "P'"
            },
            {
              "type": "text",
              "text": " liegt auf dem Strahl "
            },
            {
              "type": "math",
              "tex": "[PZ"
            },
            {
              "type": "text",
              "text": " so, dass das Zentrum "
            },
            {
              "type": "math",
              "tex": "Z"
            },
            {
              "type": "text",
              "text": " die Strecke "
            },
            {
              "type": "math",
              "tex": "[PP']"
            },
            {
              "type": "text",
              "text": " genau halbiert ("
            },
            {
              "type": "math",
              "tex": "|\\overline{PZ}| = |\\overline{ZP'}|"
            },
            {
              "type": "text",
              "text": "). - Eigenschaften: Entspricht mathematisch einer Drehung um den Winkel "
            },
            {
              "type": "math",
              "tex": "\\alpha = 180^\\circ"
            },
            {
              "type": "text",
              "text": " um das Drehzentrum "
            },
            {
              "type": "math",
              "tex": "Z"
            },
            {
              "type": "text",
              "text": ". Sie ist gleichsinnig orientierungstreu und jede Gerade ist zu ihrer Bildgeraden parallel ("
            },
            {
              "type": "math",
              "tex": "g \\parallel g'"
            },
            {
              "type": "text",
              "text": "). 3. Die fundamentalen Ortslinien der Geometrie: - 1. Mittelsenkrechte "
            },
            {
              "type": "math",
              "tex": "m_{[AB]}"
            },
            {
              "type": "text",
              "text": ":   * Ortsliniendefinition: "
            },
            {
              "type": "math",
              "tex": "\\{P \\mid d(P, A) = d(P, B)\\}"
            },
            {
              "type": "text",
              "text": ". Die Menge aller Punkte, die von "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": " denselben Abstand haben.   * Konstruktion: Zwei Kreise mit gleichem Radius "
            },
            {
              "type": "math",
              "tex": "r > \\frac{1}{2}|\\overline{AB}|"
            },
            {
              "type": "text",
              "text": " um "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": "; die Gerade durch die Schnittpunkte ist "
            },
            {
              "type": "math",
              "tex": "m_{[AB]}"
            },
            {
              "type": "text",
              "text": ". - 2. Winkelhalbierende "
            },
            {
              "type": "math",
              "tex": "w_\\alpha"
            },
            {
              "type": "text",
              "text": ":   * Ortsliniendefinition: "
            },
            {
              "type": "math",
              "tex": "\\{P \\mid d(P, g) = d(P, h)\\}"
            },
            {
              "type": "text",
              "text": ". Die Menge aller Punkte im Winkelraum, die von den beiden Schenkelgeraden "
            },
            {
              "type": "math",
              "tex": "g"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "h"
            },
            {
              "type": "text",
              "text": " den gleichen orthogonalen Abstand haben."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
