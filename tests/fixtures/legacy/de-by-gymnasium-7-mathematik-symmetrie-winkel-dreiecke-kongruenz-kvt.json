      "practice_items": [
        {
          "id": "01K4M7W0000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie groß ist die Summe der drei Innenwinkel "
            },
            {
              "type": "math",
              "tex": "\\alpha + \\beta + \\gamma",
              "speech": "Alpha plus Beta plus Gamma"
            },
            {
              "type": "text",
              "text": " in JEDEM beliebigen ebenen Dreieck der euklidischen Geometrie?"
            }
          ],
          "concept": "Exakt 180° (entspricht einem gestreckten Winkel)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Exakt 180°",
              "Exakt 360°"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K4M7W0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Erkläre und beweise die Winkelbeziehungen an geschnittenen Geraden und die Innenwinkelsumme: 1. Winkel an sich schneidenden Geraden: Scheitelwinkel sind gleich groß ("
            },
            {
              "type": "math",
              "tex": "\\alpha = \\alpha'",
              "speech": "Alpha gleich Alpha Strich"
            },
            {
              "type": "text",
              "text": "), Nebenwinkel ergänzen sich zu "
            },
            {
              "type": "math",
              "tex": "180^\\circ",
              "speech": "180 Grad"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "\\alpha + \\beta = 180^\\circ",
              "speech": "Alpha plus Beta gleich 180 Grad"
            },
            {
              "type": "text",
              "text": "), 2. Winkel an Parallelen mit einer schneidenden Geraden "
            },
            {
              "type": "math",
              "tex": "g",
              "speech": "g"
            },
            {
              "type": "text",
              "text": ": Stufenwinkel (F-Winkel) sind gleich groß ("
            },
            {
              "type": "math",
              "tex": "\\alpha = \\alpha_1",
              "speech": "Alpha gleich Alpha eins"
            },
            {
              "type": "text",
              "text": "), Wechselwinkel (Z-Winkel) sind gleich groß ("
            },
            {
              "type": "math",
              "tex": "\\alpha = \\alpha_2",
              "speech": "Alpha gleich Alpha zwei"
            },
            {
              "type": "text",
              "text": "), 3. Der mathematische Beweis der Dreieckswinkelsumme: Konstruktion einer Parallelen zur Grundseite "
            },
            {
              "type": "math",
              "tex": "AB",
              "speech": "A B"
            },
            {
              "type": "text",
              "text": " durch den Eckpunkt "
            },
            {
              "type": "math",
              "tex": "C",
              "speech": "C"
            },
            {
              "type": "text",
              "text": " und Nutzung von Wechselwinkeln "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "\\alpha + \\beta + \\gamma = 180^\\circ",
              "speech": "Alpha plus Beta plus Gamma gleich 180 Grad"
            },
            {
              "type": "text",
              "text": ", 4. Formel für die Innenwinkelsumme eines beliebigen konvexen "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": "-Ecks: "
            },
            {
              "type": "math",
              "tex": "S_n = (n - 2) \\cdot 180^\\circ",
              "speech": "S n gleich Klammer auf n minus 2 Klammer zu mal 180 Grad"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept": "Scheitelwinkel gleich; Nebenwinkel 180°; Stufenwinkel (F) & Wechselwinkel (Z) an Parallelen gleich; Beweis Dreieckswinkelsumme über Parallele durch C (Wechselwinkel ergeben gestreckten Winkel 180°); n-Eck Summe = (n-2) * 180°.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Winkelpaare an Geradenkreuzungen: - Scheitelwinkel: Liegen sich an einem Schnittpunkt zweier Geraden gegenüber "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " sind immer exakt gleich groß ("
            },
            {
              "type": "math",
              "tex": "\\alpha = \\alpha'"
            },
            {
              "type": "text",
              "text": "). - Nebenwinkel: Liegen nebeneinander an einer Geraden "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " ergänzen sich immer zu einem gestreckten Winkel: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\alpha + \\beta = 180^\\circ}"
            },
            {
              "type": "text",
              "text": ". 2. Winkel an Parallelen ("
            },
            {
              "type": "math",
              "tex": "g_1 \\parallel g_2"
            },
            {
              "type": "text",
              "text": " geschnitten von Gerade "
            },
            {
              "type": "math",
              "tex": "s"
            },
            {
              "type": "text",
              "text": "): - Stufenwinkel (F-Lage): Liegen auf derselben Seite der Schnittgeraden in derselben Relativlage zu den Parallelen "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " gleich groß: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\alpha = \\alpha_{\\text{Stufe}}}"
            },
            {
              "type": "text",
              "text": ". - Wechselwinkel (Z-Lage): Liegen auf entgegengesetzten Seiten der Schnittgeraden und zwischen den Parallelen "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " gleich groß: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\alpha = \\alpha_{\\text{Wechsel}}}"
            },
            {
              "type": "text",
              "text": ". - Nachbarwinkel (E-Lage): Ergänzen sich zu "
            },
            {
              "type": "math",
              "tex": "180^\\circ"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "\\alpha + \\delta = 180^\\circ"
            },
            {
              "type": "text",
              "text": "). 3. Geometrischer Beweis der Innenwinkelsumme im Dreieck: - Gegeben sei ein beliebiges Dreieck "
            },
            {
              "type": "math",
              "tex": "ABC"
            },
            {
              "type": "text",
              "text": " mit Innenwinkeln "
            },
            {
              "type": "math",
              "tex": "\\alpha, \\beta, \\gamma"
            },
            {
              "type": "text",
              "text": ". - Konstruktionsschritt: Wir zeichnen eine Hilfsgerade "
            },
            {
              "type": "math",
              "tex": "h"
            },
            {
              "type": "text",
              "text": " durch den oberen Eckpunkt "
            },
            {
              "type": "math",
              "tex": "C"
            },
            {
              "type": "text",
              "text": ", die parallel zur Basis "
            },
            {
              "type": "math",
              "tex": "AB"
            },
            {
              "type": "text",
              "text": " verläuft ("
            },
            {
              "type": "math",
              "tex": "h \\parallel AB"
            },
            {
              "type": "text",
              "text": "). - Winkelbetrachtung am Punkt "
            },
            {
              "type": "math",
              "tex": "C"
            },
            {
              "type": "text",
              "text": ":   * Der Winkel zur Linken ist der Wechselwinkel zu "
            },
            {
              "type": "math",
              "tex": "\\alpha"
            },
            {
              "type": "text",
              "text": " an den Parallelen "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Größe ist "
            },
            {
              "type": "math",
              "tex": "\\alpha"
            },
            {
              "type": "text",
              "text": ".   * Der Winkel in der Mitte ist der Innenwinkel "
            },
            {
              "type": "math",
              "tex": "\\gamma"
            },
            {
              "type": "text",
              "text": ".   * Der Winkel zur Rechten ist der Wechselwinkel zu "
            },
            {
              "type": "math",
              "tex": "\\beta"
            },
            {
              "type": "text",
              "text": " an den Parallelen "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Größe ist "
            },
            {
              "type": "math",
              "tex": "\\beta"
            },
            {
              "type": "text",
              "text": ". - Da alle drei Winkel zusammen auf der Geraden "
            },
            {
              "type": "math",
              "tex": "h"
            },
            {
              "type": "text",
              "text": " einen gestreckten Winkel bilden, gilt zwingend:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\alpha + \\beta + \\gamma = 180^\\circ} \\quad \\blacksquare",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Verallgemeinerung auf das konvexe "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": "-Eck: - Jedes "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": "-Eck kann von einem Eckpunkt aus in genau "
            },
            {
              "type": "math",
              "tex": "(n - 2)"
            },
            {
              "type": "text",
              "text": " Dreiecke zerlegt werden. - Daher beträgt die Summe aller Innenwinkel eines "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": "-Ecks:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{S_n = (n - 2) \\cdot 180^\\circ}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Z. B. Viereck: "
            },
            {
              "type": "math",
              "tex": "(4-2)\\cdot 180^\\circ = 360^\\circ"
            },
            {
              "type": "text",
              "text": "; Fünfeck: "
            },
            {
              "type": "math",
              "tex": "(5-2)\\cdot 180^\\circ = 540^\\circ"
            },
            {
              "type": "text",
              "text": ")."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
