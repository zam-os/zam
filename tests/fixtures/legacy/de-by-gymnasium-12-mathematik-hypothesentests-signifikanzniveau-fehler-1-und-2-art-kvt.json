      "practice_items": [
        {
          "id": "01K8GC20000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Ein Hersteller behauptet, dass mindestens 90 % seiner Akkus fehlerfrei sind ("
            },
            {
              "type": "math",
              "tex": "H_0: p \\ge 0{,}90",
              "speech": "H null: p größer gleich 0,90"
            },
            {
              "type": "text",
              "text": "). Ein Verbrauchermagazin vermutet eine schlechtere Qualität ("
            },
            {
              "type": "math",
              "tex": "H_1: p < 0{,}90",
              "speech": "H eins: p kleiner als 0,90"
            },
            {
              "type": "text",
              "text": "). Welcher Testtyp liegt vor und wo liegt der Ablehnungsbereich der Nullhypothese?"
            }
          ],
          "concept": "Ein linksseitiger Hypothesentest; der Ablehnungsbereich liegt links bei kleinen Trefferzahlen: A_bar = {0, 1, ..., k}",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Linksseitiger Hypothesentest (Ablehnung bei kleinen Werten {0, ..., k})",
              "Rechtsseitiger Hypothesentest"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GC20000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Strukturiere die Durchführung eines rechtsseitigen Hypothesentests: 1. Aufstellen der Hypothesen:   * "
            },
            {
              "type": "math",
              "tex": "H_0: p \\le p_0",
              "speech": "H null: p kleiner gleich p null"
            },
            {
              "type": "text",
              "text": " (Status quo / Behauptung, die widerlegt werden soll).   * "
            },
            {
              "type": "math",
              "tex": "H_1: p > p_0",
              "speech": "H eins: p größer als p null"
            },
            {
              "type": "text",
              "text": " (Forschungsvermutung), 2. Festlegung von Testgröße und Signifikanzniveau:   * Stichprobenumfang "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": ", Testgröße "
            },
            {
              "type": "math",
              "tex": "X \\sim B(n; p_0)",
              "speech": "X ist binomialverteilt mit n und p null"
            },
            {
              "type": "text",
              "text": ".   * Signifikanzniveau "
            },
            {
              "type": "math",
              "tex": "\\alpha",
              "speech": "Alpha"
            },
            {
              "type": "text",
              "text": " (z. B. "
            },
            {
              "type": "math",
              "tex": "\\alpha = 0{,}05",
              "speech": "Alpha gleich 0,05"
            },
            {
              "type": "text",
              "text": "), 3. Bestimmung der Entscheidungsregel:   * Ablehnungsbereich "
            },
            {
              "type": "math",
              "tex": "\\bar{A} = \\{k+1, \\dots, n\\}",
              "speech": "A quer gleich die Menge von k plus 1 bis n"
            },
            {
              "type": "text",
              "text": ".   * Bedingung: "
            },
            {
              "type": "math",
              "tex": "P_{p_0}(X \\in \\bar{A}) = P_{p_0}(X \\ge k+1) = 1 - P_{p_0}(X \\le k) \\le \\alpha \\iff P_{p_0}(X \\le k) \\ge 1 - \\alpha",
              "speech": "P p null von X Element von A quer gleich P p null von X größer gleich k plus 1 gleich 1 minus P p null von X kleiner gleich k kleiner gleich Alpha, genau dann, wenn P p null von X kleiner gleich k größer gleich 1 minus Alpha"
            },
            {
              "type": "text",
              "text": ", 4. Entscheidung & Interpretation:   * Fällt das Stichprobenergebnis "
            },
            {
              "type": "math",
              "tex": "x \\in \\bar{A}",
              "speech": "x Element von A quer"
            },
            {
              "type": "text",
              "text": ", wird "
            },
            {
              "type": "math",
              "tex": "H_0",
              "speech": "H null"
            },
            {
              "type": "text",
              "text": " zugunsten von "
            },
            {
              "type": "math",
              "tex": "H_1",
              "speech": "H eins"
            },
            {
              "type": "text",
              "text": " verworfen; fällt "
            },
            {
              "type": "math",
              "tex": "x \\in A",
              "speech": "x Element von A"
            },
            {
              "type": "text",
              "text": ", wird "
            },
            {
              "type": "math",
              "tex": "H_0",
              "speech": "H null"
            },
            {
              "type": "text",
              "text": " nicht verworfen."
            }
          ],
          "concept": "Hypothesentest: H0 vs. H1; Festlegung Testgröße X ~ B(n,p); Signifikanzniveau alpha; Ermittlung des kritischen Werts k über kumulierte Binomialverteilung; Entscheidungsregel.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Grundschema eines statistischen Hypothesentests: - Ziel: Überprüfung einer wissenschaftlichen oder ökonomischen Vermutung über einen unbekannten Parameter "
            },
            {
              "type": "math",
              "tex": "p"
            },
            {
              "type": "text",
              "text": " einer Grundgesamtheit anhand einer Zufallsstichprobe vom Umfang "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": ". 2. Systematischer Ablauf (4-Schritte-Plan): - Schritt 1: Hypothesenpaar formulieren:   * Die zu belegende Neuerung kommt stets in die Alternativhypothese "
            },
            {
              "type": "math",
              "tex": "H_1"
            },
            {
              "type": "text",
              "text": ".   * Rechtsseitiger Test: "
            },
            {
              "type": "math",
              "tex": "H_0: p \\le p_0"
            },
            {
              "type": "text",
              "text": " gegen "
            },
            {
              "type": "math",
              "tex": "H_1: p > p_0"
            },
            {
              "type": "text",
              "text": ".   * Linksseitiger Test: "
            },
            {
              "type": "math",
              "tex": "H_0: p \\ge p_0"
            },
            {
              "type": "text",
              "text": " gegen "
            },
            {
              "type": "math",
              "tex": "H_1: p < p_0"
            },
            {
              "type": "text",
              "text": ".   * Zweiseitiger Test: "
            },
            {
              "type": "math",
              "tex": "H_0: p = p_0"
            },
            {
              "type": "text",
              "text": " gegen "
            },
            {
              "type": "math",
              "tex": "H_1: p \\neq p_0"
            },
            {
              "type": "text",
              "text": ". - Schritt 2: Testgröße und Verteilung:   * Testgröße "
            },
            {
              "type": "math",
              "tex": "X"
            },
            {
              "type": "text",
              "text": ": Anzahl der Erfolge in der Stichprobe.   * Unter Annahme der Nullhypothese gilt: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{X \\sim B(n; p_0)}"
            },
            {
              "type": "text",
              "text": ". - Schritt 3: Bestimmung des Ablehnungsbereichs "
            },
            {
              "type": "math",
              "tex": "\\bar{A}"
            },
            {
              "type": "text",
              "text": " bei Signifikanzniveau "
            },
            {
              "type": "math",
              "tex": "\\alpha"
            },
            {
              "type": "text",
              "text": ":   * Rechtsseitig: "
            },
            {
              "type": "math",
              "tex": "\\bar{A} = \\{k+1, \\dots, n\\}"
            },
            {
              "type": "text",
              "text": " mit:     "
            },
            {
              "type": "math",
              "tex": "P_{p_0}(X \\ge k+1) \\le \\alpha \\iff P_{p_0}(X \\le k) \\ge 1 - \\alpha",
              "block": true
            },
            {
              "type": "text",
              "text": "     (Man sucht das kleinste "
            },
            {
              "type": "math",
              "tex": "k"
            },
            {
              "type": "text",
              "text": " in der Summentabelle der Binomialverteilung).   * Linksseitig: "
            },
            {
              "type": "math",
              "tex": "\\bar{A} = \\{0, \\dots, k\\}"
            },
            {
              "type": "text",
              "text": " mit:     "
            },
            {
              "type": "math",
              "tex": "P_{p_0}(X \\le k) \\le \\alpha",
              "block": true
            },
            {
              "type": "text",
              "text": "     (Man sucht das größte "
            },
            {
              "type": "math",
              "tex": "k"
            },
            {
              "type": "text",
              "text": ", für das der kumulierte Wert noch "
            },
            {
              "type": "math",
              "tex": "\\le \\alpha"
            },
            {
              "type": "text",
              "text": " ist). - Schritt 4: Stichprobenbefund und Testentscheidung:   * Liegt das reale Testergebnis "
            },
            {
              "type": "math",
              "tex": "x_{\\text{emp}}"
            },
            {
              "type": "text",
              "text": " im Ablehnungsbereich "
            },
            {
              "type": "math",
              "tex": "\\bar{A}"
            },
            {
              "type": "text",
              "text": ", so wird "
            },
            {
              "type": "math",
              "tex": "H_0"
            },
            {
              "type": "text",
              "text": " auf dem Signifikanzniveau "
            },
            {
              "type": "math",
              "tex": "\\alpha"
            },
            {
              "type": "text",
              "text": " abgelehnt (das Ergebnis ist statistisch signifikant). Liegt es im Annahmebereich "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": ", so reicht die Evidenz nicht aus "
            },
            {
              "type": "math",
              "tex": "\\implies H_0"
            },
            {
              "type": "text",
              "text": " wird beibehalten."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
