      "practice_items": [
        {
          "id": "01K8GA20000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie lautet die 1. Ableitung der Potenzfunktion "
            },
            {
              "type": "math",
              "tex": "f(x) = x^n",
              "speech": "f von x gleich x hoch n"
            },
            {
              "type": "text",
              "text": " nach der elementaren Potenzregel der Differentialrechnung?"
            }
          ],
          "concept_segments": [
            {
              "type": "math",
              "tex": "f'(x) = n \\cdot x^{n-1}",
              "speech": "f Strich von x gleich n mal x hoch, n minus 1"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              [
                {
                  "type": "math",
                  "tex": "f'(x) = n \\cdot x^{n-1}",
                  "speech": "f Strich von x gleich n mal x hoch, n minus 1"
                }
              ],
              [
                {
                  "type": "math",
                  "tex": "f'(x) = \\frac{x^{n+1}}{n+1}",
                  "speech": "f Strich von x gleich x hoch, n plus 1, geteilt durch n plus 1"
                }
              ]
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GA20000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere den Grenzübergang von der Sekantensteigung zur Ableitung und die elementaren Ableitungsregeln: 1. Mittlere Änderungsrate (Differenzenquotient / Sekantensteigung):   * In einem Intervall "
            },
            {
              "type": "math",
              "tex": "[x_0; x_0 + h]",
              "speech": "Intervall von x null bis x null plus h"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{m_{\\text{Sekante}} = \\frac{\\Delta y}{\\Delta x} = \\frac{f(x_0 + h) - f(x_0)}{h}}",
              "block": true,
              "speech": "m Sekante gleich Delta y durch Delta x gleich, f von x null plus h minus f von x null, geteilt durch h"
            },
            {
              "type": "text",
              "text": " 2. Lokale Änderungsrate (Differentialquotient / Ableitung / Tangentensteigung):   * Grenzwert des Differenzenquotienten für "
            },
            {
              "type": "math",
              "tex": "h \\rightarrow 0",
              "speech": "h gegen 0"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f'(x_0) = \\lim_{h \\rightarrow 0} \\frac{f(x_0 + h) - f(x_0)}{h}}",
              "block": true,
              "speech": "f Strich von x null gleich Limes für h gegen 0 von, f von x null plus h minus f von x null, geteilt durch h"
            },
            {
              "type": "text",
              "text": "   * Geometrische Bedeutung: Steigung der Tangente an den Graphen von "
            },
            {
              "type": "math",
              "tex": "f",
              "speech": "f"
            },
            {
              "type": "text",
              "text": " an der Stelle "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": ", 3. Die elementaren Ableitungsregeln:   * Potenzregel: "
            },
            {
              "type": "math",
              "tex": "(x^n)' = n \\cdot x^{n-1}",
              "speech": "Klammer auf x hoch n Klammer zu Strich gleich n mal x hoch n minus eins"
            },
            {
              "type": "text",
              "text": " (für alle "
            },
            {
              "type": "math",
              "tex": "n \\in \\mathbb{R}",
              "speech": "n Element der reellen Zahlen"
            },
            {
              "type": "text",
              "text": ").   * Konstantenregel: "
            },
            {
              "type": "math",
              "tex": "(c)' = 0",
              "speech": "c Strich gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Faktorregel: "
            },
            {
              "type": "math",
              "tex": "(c \\cdot f(x))' = c \\cdot f'(x)",
              "speech": "Klammer auf c mal f von x Klammer zu Strich gleich c mal f Strich von x"
            },
            {
              "type": "text",
              "text": ".   * Summenregel: "
            },
            {
              "type": "math",
              "tex": "(f(x) + g(x))' = f'(x) + g'(x)",
              "speech": "Klammer auf f von x plus g von x Klammer zu Strich gleich f Strich von x plus g Strich von x"
            },
            {
              "type": "text",
              "text": ", 4. Bestimme die 1. Ableitung der Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = 4x^3 - 5x^2 + 7x - 9",
              "speech": "f von x gleich 4 x hoch drei minus 5 x Quadrat plus 7 x minus 9"
            },
            {
              "type": "text",
              "text": " und berechne die Tangentensteigung an der Stelle "
            },
            {
              "type": "math",
              "tex": "x_0 = 2",
              "speech": "x null gleich 2"
            },
            {
              "type": "text",
              "text": "."
            }
