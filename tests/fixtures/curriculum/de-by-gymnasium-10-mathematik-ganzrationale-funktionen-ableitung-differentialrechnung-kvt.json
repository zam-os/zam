            {
              "type": "math",
              "tex": "f'(x)"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "f'(x) = 4 \\cdot (3x^2) - 5 \\cdot (2x) + 7 \\cdot (1) - 0 = \\mathbf{12x^2 - 10x + 7}",
              "block": true
            },
