          "question_segments": [
            {
              "type": "text",
              "text": "Welche algebraische Symmetriebedingung erfüllt der Graph einer Funktion "
            },
            {
              "type": "math",
              "tex": "f(x)",
              "speech": "f von x"
            },
            {
              "type": "text",
              "text": ", wenn er punktsymmetrisch zum Koordinatenursprung "
            },
            {
              "type": "math",
              "tex": "(0|0)",
              "speech": "Punkt null, null"
            },
            {
              "type": "text",
              "text": " ist?"
            }
          ],
          "concept": "f(-x) = -f(x) für alle x im Definitionsbereich (nur ungerade Exponenten bei Polynomen)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "f(-x) = -f(x) (Punktsymmetrie zum Ursprung)",
              "f(-x) = f(x) (Achsensymmetrie zur y-Achse)"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GA20000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere ganzrationale Funktionen (Polynome) systematisch: 1. Allgemeine Form & Grad:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(x) = a_n x^n + a_{n-1} x^{n-1} + \\dots + a_1 x + a_0} \\quad (a_n \\neq 0, n \\in \\mathbb{N}_0)",
              "block": true,
              "speech": "f von x gleich a n x hoch n plus a n minus 1 x hoch n minus 1 plus und so weiter plus a eins x plus a null, mit a n ungleich 0 und n Element von N null"
            },
            {
              "type": "text",
              "text": "   * Leitkoeffizient "
            },
            {
              "type": "math",
              "tex": "a_n",
              "speech": "a n"
            },
            {
              "type": "text",
              "text": " und Grad "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": " bestimmen das Globalverhalten für "
            },
            {
              "type": "math",
              "tex": "x \\rightarrow \\pm \\infty",
              "speech": "x gegen plus minus unendlich"
            },
            {
              "type": "text",
              "text": " (dominanter Summand "
            },
            {
              "type": "math",
              "tex": "a_n x^n",
              "speech": "a n x hoch n"
            },
            {
              "type": "text",
              "text": "), 2. Symmetriekriterien:   * Achsensymmetrie zur "
            },
            {
              "type": "math",
              "tex": "y",
              "speech": "y"
            },
            {
              "type": "text",
              "text": "-Achse: "
            },
            {
              "type": "math",
              "tex": "f(-x) = f(x) \\iff",
              "speech": "f von minus x gleich f von x genau dann, wenn"
            },
            {
              "type": "text",
              "text": " Polynom enthält ausschließlich gerade Exponenten von "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": " (inkl. "
            },
            {
              "type": "math",
              "tex": "a_0 = a_0 x^0",
              "speech": "a null gleich a null x hoch null"
            },
            {
              "type": "text",
              "text": ").   * Punktsymmetrie zum Ursprung "
            },
            {
              "type": "math",
              "tex": "(0|0)",
              "speech": "Punkt null, null"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "f(-x) = -f(x) \\iff",
              "speech": "f von minus x gleich minus f von x genau dann, wenn"
            },
            {
              "type": "text",
              "text": " Polynom enthält ausschließlich ungerade Exponenten von "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": ", 3. Nullstellen und ihre Vielfachheit:   * Zerlegung in Linearfaktoren: "
            },
            {
              "type": "math",
              "tex": "f(x) = a_n (x - x_1)^{k_1} (x - x_2)^{k_2} \\dots",
              "speech": "f von x gleich a n mal Klammer auf x minus x eins Klammer zu hoch k eins mal Klammer auf x minus x zwei Klammer zu hoch k zwei und so weiter"
            },
            {
              "type": "text",
              "text": "   * Einfache Nullstelle ("
            },
            {
              "type": "math",
              "tex": "k = 1",
              "speech": "k gleich 1"
            },
            {
              "type": "text",
              "text": "): Graph schneidet die "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse geradlinig.   * Doppelte/gerade Nullstelle ("
            },
            {
              "type": "math",
              "tex": "k = 2, 4",
              "speech": "k gleich 2 und 4"
            },
            {
              "type": "text",
              "text": "): Graph berührt die "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse ohne Vorzeichenwechsel (Extrempunkt).   * Dreifache/ungerade Nullstelle ("
            },
            {
              "type": "math",
              "tex": "k = 3, 5",
              "speech": "k gleich 3 und 5"
            },
            {
              "type": "text",
              "text": "): Graph schneidet mit Sattelpunkt (Terrassenpunkt) und Vorzeichenwechsel."
            }
          ],
          "concept": "Ganzrationale Funktionen: Grad n und Leitkoeffizient bestimmen Globalverhalten; Symmetrie (gerade Exponenten -> achsensymmetrisch f(-x)=f(x); ungerade Exponenten -> punktsymmetrisch f(-x)=-f(x)); Nullstellenvielfachheit k (k=1 Schnitt, k=2 Berührung/Extremum, k=3 Sattelpunkt).",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Struktur ganzrationaler Funktionen (Polynomfunktionen): - Funktionsterm:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(x) = a_n x^n + a_{n-1} x^{n-1} + \\dots + a_1 x + a_0} \\quad (n \\in \\mathbb{N}_0, a_n \\neq 0)",
              "block": true
            },
            {
              "type": "text",
              "text": " - Globalverhalten (Verhalten im Unendlichen):   * Für "
            },
            {
              "type": "math",
              "tex": "|x| \\rightarrow \\infty"
            },
            {
              "type": "text",
              "text": " bestimmt allein der Summand mit der höchsten Potenz "
            },
            {
              "type": "math",
              "tex": "\\mathbf{a_n x^n}"
            },
            {
              "type": "text",
              "text": " das Grenzverhalten:     * "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": " gerade, "
            },
            {
              "type": "math",
              "tex": "a_n > 0"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\rightarrow \\pm\\infty} f(x) = +\\infty"
            },
            {
              "type": "text",
              "text": " (von II nach I).     * "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": " gerade, "
            },
            {
              "type": "math",
              "tex": "a_n < 0"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\rightarrow \\pm\\infty} f(x) = -\\infty"
            },
            {
              "type": "text",
              "text": " (von III nach IV).     * "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": " ungerade, "
            },
            {
              "type": "math",
              "tex": "a_n > 0"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\rightarrow -\\infty} f(x) = -\\infty, \\lim_{x \\rightarrow +\\infty} f(x) = +\\infty"
            },
            {
              "type": "text",
              "text": " (von III nach I).     * "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": " ungerade, "
            },
            {
              "type": "math",
              "tex": "a_n < 0"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\rightarrow -\\infty} f(x) = +\\infty, \\lim_{x \\rightarrow +\\infty} f(x) = -\\infty"
            },
            {
              "type": "text",
              "text": " (von II nach IV). 2. Symmetrieeigenschaften: - 1. Achsensymmetrie zur "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achse:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(-x) = f(x)} \\quad \\forall x \\in \\mathbb{D}_f",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Bei Polynomen: Tritt genau dann auf, wenn nur gerade Potenzen von "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": " vorkommen (z. B. "
            },
            {
              "type": "math",
              "tex": "f(x) = 2x^4 - 5x^2 + 7"
            },
            {
              "type": "text",
              "text": "). - 2. Punktsymmetrie zum Koordinatenursprung:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(-x) = -f(x)} \\quad \\forall x \\in \\mathbb{D}_f",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Bei Polynomen: Tritt genau dann auf, wenn nur ungerade Potenzen von "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": " vorkommen und kein absolutes Glied existiert ("
            },
            {
              "type": "math",
              "tex": "a_0 = 0"
            },
            {
              "type": "text",
              "text": ", z. B. "
            },
            {
              "type": "math",
              "tex": "f(x) = x^5 - 4x^3 + 2x"
            },
            {
              "type": "text",
              "text": "). 3. Nullstellen und geometrische Vielfachheit: - Ist "
            },
            {
              "type": "math",
              "tex": "x_0"
            },
            {
              "type": "text",
              "text": " eine Nullstelle der Vielfachheit "
            },
            {
              "type": "math",
              "tex": "k"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "f(x) = (x - x_0)^k \\cdot g(x)"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "g(x_0) \\neq 0"
            },
            {
              "type": "text",
              "text": "):   * "
            },
            {
              "type": "math",
              "tex": "k = 1"
            },
            {
              "type": "text",
              "text": " (einfache Nullstelle): Der Graph schneidet die "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse mit von Null verschiedener Steigung (Vorzeichenwechsel von "
            },
            {
              "type": "math",
              "tex": "-"
            },
            {
              "type": "text",
              "text": " nach "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " oder "
            },
            {
              "type": "math",
              "tex": "+"
            },
            {
              "type": "text",
              "text": " nach "
            },
            {
              "type": "math",
              "tex": "-"
            },
            {
              "type": "text",
              "text": ").   * "
            },
            {
              "type": "math",
              "tex": "k = 2"
            },
            {
              "type": "text",
              "text": " (doppelte Nullstelle): Der Graph berührt die "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse im Scheitelpunkt einer Parabel ohne Vorzeichenwechsel (lokales Minimum oder Maximum).   * "
            },
            {
              "type": "math",
              "tex": "k = 3"
            },
            {
              "type": "text",
              "text": " (dreifache Nullstelle): Der Graph besitzt einen Terrassenpunkt (Sattelpunkt) auf der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse (horizontale Tangente mit Vorzeichenwechsel)."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
