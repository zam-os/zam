        {
          "id": "01K8G9E0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die Grundgleichungen der chemischen Stöchiometrie: 1. Stoffmenge "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": " & Molare Masse "
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "n = \\frac{m}{M} \\iff m = n \\cdot M",
              "block": true,
              "speech": "n gleich m durch M genau dann, wenn m gleich n mal M"
            },
            {
              "type": "text",
              "text": "   ("
            },
            {
              "type": "math",
              "tex": "n = \\text{Stoffmenge in mol}",
              "speech": "n gleich Stoffmenge in Mol"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "m = \\text{Masse in g}",
              "speech": "m gleich Masse in Gramm"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "M = \\text{molare Masse in } \\frac{\\text{g}}{\\text{mol}}",
              "speech": "M gleich molare Masse in Gramm pro Mol"
            },
            {
              "type": "text",
              "text": ", aus PSE als Summe der relativen Atommassen), 2. Teilchenanzahl "
            },
            {
              "type": "math",
              "tex": "N",
              "speech": "N"
            },
            {
              "type": "text",
              "text": " & Avogadro-Konstante "
            },
            {
              "type": "math",
              "tex": "N_A",
              "speech": "N A"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "N = n \\cdot N_A",
              "speech": "N gleich n mal N A"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "N_A \\approx 6{,}022 \\cdot 10^{23}\\,\\text{mol}^{-1}",
              "speech": "N A ungefähr 6,022 mal 10 hoch 23 pro Mol"
            },
            {
              "type": "text",
              "text": "), 3. Molares Gasvolumen "
            },
            {
              "type": "math",
              "tex": "V_m",
              "speech": "V m"
            },
            {
              "type": "text",
              "text": ": Bei Normbedingungen ("
            },
            {
              "type": "math",
              "tex": "T = 0^\\circ\\text{C}, p = 1013\\,\\text{hPa}",
              "speech": "T gleich 0 Grad Celsius, p gleich 1013 Hektopascal"
            },
            {
              "type": "text",
              "text": ") nimmt "
            },
            {
              "type": "math",
              "tex": "1\\,\\text{mol}",
              "speech": "1 Mol"
            },
            {
              "type": "text",
              "text": " jedes idealen Gases das Volumen "
            },
            {
              "type": "math",
              "tex": "V_m = 22{,}4\\,\\frac{\\text{l}}{\\text{mol}}",
              "speech": "V m gleich 22,4 Liter pro Mol"
            },
            {
              "type": "text",
              "text": " ein ("
            },
            {
              "type": "math",
              "tex": "V = n \\cdot V_m",
              "speech": "V gleich n mal V m"
            },
            {
              "type": "text",
              "text": "), 4. Stoffmengenkonzentration "
            },
            {
              "type": "math",
              "tex": "c",
              "speech": "c"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "c = \\frac{n}{V}",
              "speech": "c gleich n durch V"
            },
            {
              "type": "text",
              "text": " (in "
            },
            {
              "type": "math",
              "tex": "\\frac{\\text{mol}}{\\text{l}}",
              "speech": "Mol pro Liter"
            },
            {
              "type": "text",
              "text": "), 5. Berechne die Stoffmenge "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": " und die Anzahl der Moleküle "
            },
            {
              "type": "math",
              "tex": "N",
              "speech": "N"
            },
            {
              "type": "text",
              "text": " in "
            },
            {
              "type": "math",
              "tex": "36\\,\\text{g}",
              "speech": "36 Gramm"
            },
            {
              "type": "text",
              "text": " reinem Wasser "
            },
            {
              "type": "math",
              "tex": "H_2O",
              "speech": "H zwei O"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "M(H) = 1\\,\\frac{\\text{g}}{\\text{mol}}",
              "speech": "M von H gleich 1 Gramm pro Mol"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "M(O) = 16\\,\\frac{\\text{g}}{\\text{mol}}",
              "speech": "M von O gleich 16 Gramm pro Mol"
            },
            {
              "type": "text",
              "text": ")."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Stöchiometrie: "
            },
            {
              "type": "math",
              "tex": "n = \\frac{m}{M}",
              "speech": "n gleich m durch M"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "N = n \\cdot N_A",
              "speech": "N gleich n mal N A"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "V_m = 22{,}4",
              "speech": "V m gleich 22,4"
            },
            {
              "type": "text",
              "text": " l/mol bei STP; Konzentration "
            },
            {
              "type": "math",
              "tex": "c = \\frac{n}{V}",
              "speech": "c gleich n durch V"
            },
            {
              "type": "text",
              "text": "; Rechnung: "
            },
            {
              "type": "math",
              "tex": "M(\\text{H}_2\\text{O}) = 2 \\cdot 1 + 16 = 18",
              "speech": "M von H zwei O gleich 2 mal 1 plus 16 gleich 18"
            },
            {
              "type": "text",
              "text": " g/mol; "
            },
            {
              "type": "math",
              "tex": "n = \\frac{36\\,\\text{g}}{18\\,\\text{g/mol}} = 2",
              "speech": "n gleich 36 Gramm durch 18 Gramm pro Mol gleich 2"
            },
            {
              "type": "text",
              "text": " mol; "
            },
            {
              "type": "math",
              "tex": "N = 2 \\cdot 6{,}022 \\cdot 10^{23} = 1{,}2044 \\cdot 10^{24}",
              "speech": "N gleich 2 mal 6,022 mal 10 hoch 23 gleich 1,2044 mal 10 hoch 24"
            },
            {
              "type": "text",
              "text": " Moleküle."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Grundgrößen und Gleichungen der chemischen Stöchiometrie: - 1. Stoffmenge "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": " (Einheit: Mol [mol]):   * Die Basiseinheit zur Zählung chemischer Teilchenportionen:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{n = \\frac{m}{M}} \\quad \\iff \\quad \\mathbf{m = n \\cdot M}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "m"
            },
            {
              "type": "text",
              "text": ": Masse der Stoffportion in Gramm [g].   * "
            },
            {
              "type": "math",
              "tex": "M"
            },
            {
              "type": "text",
              "text": ": Molare Masse in "
            },
            {
              "type": "math",
              "tex": "\\frac{\\text{g}}{\\text{mol}}"
            },
            {
              "type": "text",
              "text": " (Zahlenwert entspricht exakt der relativen Molekülmasse "
            },
            {
              "type": "math",
              "tex": "u"
            },
            {
              "type": "text",
              "text": " aus dem PSE). - 2. Avogadro-Konstante "
            },
            {
              "type": "math",
              "tex": "N_A"
            },
            {
              "type": "text",
              "text": ":   * Die Anzahl der Atome in exakt 12 g des Kohlenstoffisotops "
            },
            {
              "type": "math",
              "tex": "^{12}\\text{C}"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{N_A \\approx 6{,}022 \\cdot 10^{23}\\,\\text{mol}^{-1}} \\implies \\mathbf{N = n \\cdot N_A}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 3. Molares Gasvolumen "
            },
            {
              "type": "math",
              "tex": "V_m"
            },
            {
              "type": "text",
              "text": " (Satz von Avogadro):   * Gleiche Volumina aller Gase enthalten bei gleichem Druck und gleicher Temperatur dieselbe Anzahl von Teilchen:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{V = n \\cdot V_m} \\quad (V_{m,\\text{Norm}} = 22{,}4\\,\\frac{\\text{l}}{\\text{mol}} \\text{ bei } 0^\\circ\\text{C}, 1013\\text{ hPa})",
              "block": true
            },
            {
              "type": "text",
              "text": " - 4. Stoffmengenkonzentration "
            },
            {
              "type": "math",
              "tex": "c"
            },
            {
              "type": "text",
              "text": " einer Lösung:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{c = \\frac{n}{V} = \\frac{m}{M \\cdot V}} \\quad (\\text{Einheit: } 1\\,\\frac{\\text{mol}}{\\text{l}} = 1\\,\\text{M} \\text{ [molar]})",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Durchrechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "m(\\text{H}_2\\text{O}) = 36\\,\\text{g}"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Molare Masse "
            },
            {
              "type": "math",
              "tex": "M(\\text{H}_2\\text{O})"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "M(\\text{H}_2\\text{O}) = 2 \\cdot M(\\text{H}) + 1 \\cdot M(\\text{O}) = 2 \\cdot 1{,}0\\,\\frac{\\text{g}}{\\text{mol}} + 16{,}0\\,\\frac{\\text{g}}{\\text{mol}} = \\mathbf{18{,}0\\,\\frac{\\text{g}}{\\text{mol}}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Stoffmenge "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "n(\\text{H}_2\\text{O}) = \\frac{m}{M} = \\frac{36\\,\\text{g}}{18\\,\\frac{\\text{g}}{\\text{mol}}} = \\mathbf{2{,}0\\,\\text{mol}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 3: Absolute Teilchenanzahl "
            },
            {
              "type": "math",
              "tex": "N"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "N = n \\cdot N_A = 2{,}0\\,\\text{mol} \\cdot 6{,}022 \\cdot 10^{23}\\,\\text{mol}^{-1} = \\mathbf{1{,}2044 \\cdot 10^{24}\\,\\text{Wassermoleküle}}",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
