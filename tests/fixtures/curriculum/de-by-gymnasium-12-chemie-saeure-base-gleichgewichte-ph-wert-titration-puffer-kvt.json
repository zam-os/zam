      "practice_items": [
        {
          "id": "01K8GC60000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie berechnet sich der pH-Wert einer schwachen einprotonigen Säure (z. B. Essigsäure mit "
            },
            {
              "type": "math",
              "tex": "pK_s = 4{,}75",
              "speech": "pK s gleich 4,75"
            },
            {
              "type": "text",
              "text": ") bei der Anfangskonzentration "
            },
            {
              "type": "math",
              "tex": "c_0",
              "speech": "c null"
            },
            {
              "type": "text",
              "text": " in sehr guter Näherung?"
            }
          ],
          "concept": "pH = 1/2 * (pK_s - log c_0)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "pH = 1/2 * (pK_s - log c_0)",
              "pH = -log c_0"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GC60000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Säure-Base-Gleichgewichte nach Brønsted und leite die Formeln zur pH-Wert-Berechnung her: 1. Brønsted-Lowry-Konzept & Autoprotolyse des Wassers:   * Säure = Protonendonator ("
            },
            {
              "type": "math",
              "tex": "HA \\rightarrow H^+ + A^-",
              "speech": "H A reagiert zu H plus plus A minus"
            },
            {
              "type": "text",
              "text": "); Base = Protonenakzeptor ("
            },
            {
              "type": "math",
              "tex": "B + H^+ \\rightarrow HB^+",
              "speech": "B plus H plus reagiert zu H B plus"
            },
            {
              "type": "text",
              "text": ").   * Autoprotolyse: "
            },
            {
              "type": "math",
              "tex": "2\\,\\text{H}_2\\text{O} \\rightleftharpoons \\text{H}_3\\text{O}^+ + \\text{OH}^-",
              "speech": "2 H zwei O im Gleichgewicht mit H drei O plus plus O H minus"
            },
            {
              "type": "text",
              "text": ".   * Ionenprodukt des Wassers ("
            },
            {
              "type": "math",
              "tex": "25^\\circ\\text{C}",
              "speech": "25 Grad Celsius"
            },
            {
              "type": "text",
              "text": "):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{K_w = c(\\text{H}_3\\text{O}^+) \\cdot c(\\text{OH}^-) = 10^{-14}\\,\\frac{\\text{mol}^2}{\\text{l}^2} \\iff \\mathbf{pH + pOH = 14}}",
              "block": true,
              "speech": "K w gleich c von H drei O plus mal c von O H minus gleich 10 hoch minus 14 Mol Quadrat pro Liter Quadrat, genau dann, wenn pH plus pOH gleich 14"
            },
            {
              "type": "text",
              "text": " 2. Säurestärke & "
            },
            {
              "type": "math",
              "tex": "pK_s",
              "speech": "pK s"
            },
            {
              "type": "text",
              "text": "-Wert:   * "
            },
            {
              "type": "math",
              "tex": "HA + \\text{H}_2\\text{O} \\rightleftharpoons \\text{H}_3\\text{O}^+ + A^- \\implies \\mathbf{K_s = \\frac{c(\\text{H}_3\\text{O}^+) \\cdot c(A^-)}{c(HA)}} \\implies \\mathbf{pK_s = -\\log(K_s)}",
              "speech": "H A plus H zwei O im Gleichgewicht mit H drei O plus plus A minus, daraus folgt K s gleich c von H drei O plus mal c von A minus, geteilt durch c von H A, daraus folgt pK s gleich minus Logarithmus von K s"
            },
            {
              "type": "text",
              "text": ".   * Je kleiner der "
            },
            {
              "type": "math",
              "tex": "pK_s",
              "speech": "pK s"
            },
            {
              "type": "text",
              "text": "-Wert, desto stärker ist die Säure, 3. Die fundamentalen Berechnungsformeln für den pH-Wert:   * 1. Starke Säuren ("
            },
            {
              "type": "math",
              "tex": "pK_s < 1",
              "speech": "pK s kleiner als 1"
            },
            {
              "type": "text",
              "text": ", z. B. "
            },
            {
              "type": "math",
              "tex": "HCl, HNO_3",
              "speech": "H C l, H N O drei"
            },
            {
              "type": "text",
              "text": "): Vollständige Protolyse "
            },
            {
              "type": "math",
              "tex": "\\implies \\mathbf{pH = -\\log(c_0)}",
              "speech": "daraus folgt p H gleich minus Logarithmus von c null"
            },
            {
              "type": "text",
              "text": ".   * 2. Schwache Säuren ("
            },
            {
              "type": "math",
              "tex": "pK_s > 4",
              "speech": "pK s größer als 4"
            },
            {
              "type": "text",
              "text": ", z. B. "
            },
            {
              "type": "math",
              "tex": "CH_3COOH",
              "speech": "C H drei C O O H"
            },
            {
              "type": "text",
              "text": "): Nur geringer Protolysegrad ("
            },
            {
              "type": "math",
              "tex": "c(HA) \\approx c_0",
              "speech": "c von H A ungefähr c null"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "c(H_3O^+) = c(A^-)",
              "speech": "c von H drei O plus gleich c von A minus"
            },
            {
              "type": "text",
              "text": "):     "
            },
            {
              "type": "math",
              "tex": "K_s = \\frac{c(\\text{H}_3\\text{O}^+)^2}{c_0} \\implies c(\\text{H}_3\\text{O}^+) = \\sqrt{K_s \\cdot c_0} \\implies \\mathbf{pH = \\frac{1}{2}\\left( pK_s - \\log(c_0) \\right)}",
              "block": true,
              "speech": "K s gleich c von H drei O plus zum Quadrat durch c null, daraus folgt c von H drei O plus gleich Wurzel aus K s mal c null, daraus folgt pH gleich ein halb mal, pK s minus Logarithmus von c null"
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Säure-Base 12: Brønsted-Paare; Autoprotolyse "
            },
            {
              "type": "math",
              "tex": "K_w = 10^{-14}",
              "speech": "K w gleich 10 hoch minus 14"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "\\text{pH} + \\text{pOH} = 14",
              "speech": "pH plus pOH gleich 14"
            },
            {
              "type": "text",
              "text": "); Säurekonstante "
            },
            {
              "type": "math",
              "tex": "K_s",
              "speech": "K s"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\text{p}K_s",
              "speech": "pK s"
            },
            {
              "type": "text",
              "text": "; pH-Berechnung stark ("
            },
            {
              "type": "math",
              "tex": "\\text{pH} = -\\log c_0",
              "speech": "pH gleich minus Logarithmus von c null"
            },
            {
              "type": "text",
              "text": ") vs. schwach ("
            },
            {
              "type": "math",
              "tex": "\\text{pH} = \\frac{1}{2} \\cdot (\\text{p}K_s - \\log c_0)",
              "speech": "pH gleich ein halb mal, pK s minus Logarithmus von c null"
            },
            {
              "type": "text",
              "text": ")."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Säure-Base-Theorie nach Johannes Brønsted und Thomas Lowry (1923): - Definitionen:   * Säure: Ein Molekül oder Ion, das Protonen ("
            },
            {
              "type": "math",
              "tex": "H^+"
            },
            {
              "type": "text",
              "text": ") abgibt (Protonendonator).   * Base: Ein Molekül oder Ion, das Protonen aufnimmt (Protonenakzeptor).   * Protolyse: Reversible Protonenübertragungsreaktion zwischen zwei korrespondierenden Säure-Base-Paaren:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\text{Säure}_1 + \\text{Base}_2 \\rightleftharpoons \\text{Base}_1 + \\text{Säure}_2}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Das Ionenprodukt des Wassers und der pH-Wert: - Auch reinstes destilliertes Wasser leitet minimal den elektrischen Strom durch Autoprotolyse:   "
            },
            {
              "type": "math",
              "tex": "2\\,\\text{H}_2\\text{O} \\rightleftharpoons \\text{H}_3\\text{O}^+ + \\text{OH}^-",
              "block": true
            },
            {
              "type": "text",
              "text": " - Aus dem Massenwirkungsgesetz folgt bei "
            },
            {
              "type": "math",
              "tex": "25^\\circ\\text{C}"
            },
            {
              "type": "text",
              "text": " das konstante Ionenprodukt:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{K_w = c(\\text{H}_3\\text{O}^+) \\cdot c(\\text{OH}^-) = 1{,}0 \\cdot 10^{-14}\\,\\frac{\\text{mol}^2}{\\text{l}^2}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Definition des pH- und pOH-Wertes nach Sørensen (1909):   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{pH = -\\log_{10}\\left( \\frac{c(\\text{H}_3\\text{O}^+)}{\\text{mol/l}} \\right)}"
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{pOH = -\\log_{10}\\left( \\frac{c(\\text{OH}^-)}{\\text{mol/l}} \\right)}"
            },
            {
              "type": "text",
              "text": "   * Durch Logarithmieren von "
            },
            {
              "type": "math",
              "tex": "K_w"
            },
            {
              "type": "text",
              "text": " gilt in allen wässrigen Lösungen: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{pH + pOH = 14}"
            },
            {
              "type": "text",
              "text": ". 3. Systematische Herleitung der pH-Berechnungsformeln: - Fall 1: Starke Säuren ("
            },
            {
              "type": "math",
              "tex": "pK_s \\le 1"
            },
            {
              "type": "text",
              "text": ", z. B. Salzsäure "
            },
            {
              "type": "math",
              "tex": "HCl"
            },
            {
              "type": "text",
              "text": ", Salpetersäure "
            },
            {
              "type": "math",
              "tex": "HNO_3"
            },
            {
              "type": "text",
              "text": "):   * Vollständige Dissoziation ("
            },
            {
              "type": "math",
              "tex": "100\\%"
            },
            {
              "type": "text",
              "text": "): Jedes Säuremolekül gibt sein Proton ab "
            },
            {
              "type": "math",
              "tex": "\\implies c(\\text{H}_3\\text{O}^+) = c_0(\\text{Säure})"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{pH = -\\log(c_0)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Beispiel: "
            },
            {
              "type": "math",
              "tex": "0{,}01\\,\\text{mol/l } HCl \\implies pH = -\\log(10^{-2}) = 2"
            },
            {
              "type": "text",
              "text": "). - Fall 2: Schwache Säuren ("
            },
            {
              "type": "math",
              "tex": "pK_s > 4"
            },
            {
              "type": "text",
              "text": ", z. B. Essigsäure mit "
            },
            {
              "type": "math",
              "tex": "pK_s = 4{,}75"
            },
            {
              "type": "text",
              "text": "):   * Protolysegleichgewicht: "
            },
            {
              "type": "math",
              "tex": "\\text{HA} + \\text{H}_2\\text{O} \\rightleftharpoons \\text{H}_3\\text{O}^+ + \\text{A}^-"
            },
            {
              "type": "text",
              "text": ".   * Säurekonstante:     "
            },
            {
              "type": "math",
              "tex": "K_s = \\frac{c(\\text{H}_3\\text{O}^+) \\cdot c(\\text{A}^-)}{c(\\text{HA})}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Vereinfachende Näherungsannahmen:     1. "
            },
            {
              "type": "math",
              "tex": "c(\\text{H}_3\\text{O}^+) = c(\\text{A}^-)"
            },
            {
              "type": "text",
              "text": " (jedes "
            },
            {
              "type": "math",
              "tex": "\\text{H}_3\\text{O}^+"
            },
            {
              "type": "text",
              "text": " erzeugt genau ein "
            },
            {
              "type": "math",
              "tex": "\\text{A}^-"
            },
            {
              "type": "text",
              "text": ").     2. Da nur winzige Bruchteile protolysieren, gilt: "
            },
            {
              "type": "math",
              "tex": "c(\\text{HA}) = c_0 - c(\\text{H}_3\\text{O}^+) \\approx c_0"
            },
            {
              "type": "text",
              "text": ".   * Einsetzen liefert:     "
            },
            {
              "type": "math",
              "tex": "K_s = \\frac{c(\\text{H}_3\\text{O}^+)^2}{c_0} \\implies c(\\text{H}_3\\text{O}^+) = \\sqrt{K_s \\cdot c_0}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Durch Logarithmieren ("
            },
            {
              "type": "math",
              "tex": "-\\log"
            },
            {
              "type": "text",
              "text": ") ergibt sich die Ostwaldsche Formel für schwache Säuren:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{pH = \\frac{1}{2} \\cdot \\left( pK_s - \\log(c_0) \\right)}",
              "block": true
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
