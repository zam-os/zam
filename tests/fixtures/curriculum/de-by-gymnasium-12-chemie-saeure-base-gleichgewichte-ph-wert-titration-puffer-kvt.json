      "practice_items": [
        {
          "id": "01K8GC60000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Welcher pH-Wert stellt sich bei der Titration einer schwachen Säure (z. B. Essigsäure) mit einer starken Base exakt am Halbäquivalenzpunkt (HÄP) ein?",
          "concept": "pH = pK_s (da am Halbäquivalenzpunkt exakt die Hälfte der Säure in ihre konjugierte Base überführt wurde: c(HA) = c(A-) und der Quotient im Logarithmus 1 ist)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "pH = pK_s (exakte Gleichheit von Säure und konjugierter Base)",
              "pH = 7,00"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K8GC60000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Titrationskurven, Äquivalenzpunkte und Puffersysteme: 1. Titrationskurven im Vergleich:   * Starke Säure / Starke Base ("
            },
            {
              "type": "math",
              "tex": "HCl",
              "speech": "H C l"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "NaOH",
              "speech": "N a O H"
            },
            {
              "type": "text",
              "text": "):     - Start: sehr tiefer pH ("
            },
            {
              "type": "math",
              "tex": "pH \\approx 1",
              "speech": "pH ungefähr 1"
            },
            {
              "type": "text",
              "text": ").     - Langer flacher Verlauf, extremer pH-Sprung von pH 4 auf pH 10.     - Äquivalenzpunkt (ÄP): Liegt exakt bei "
            },
            {
              "type": "math",
              "tex": "pH = 7{,}0",
              "speech": "pH gleich 7,0"
            },
            {
              "type": "text",
              "text": " (neutral, da "
            },
            {
              "type": "math",
              "tex": "NaCl",
              "speech": "N a C l"
            },
            {
              "type": "text",
              "text": " nicht hydrolysiert).   * Schwache Säure / Starke Base ("
            },
            {
              "type": "math",
              "tex": "CH_3COOH",
              "speech": "C H drei C O O H"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "NaOH",
              "speech": "N a O H"
            },
            {
              "type": "text",
              "text": "):     - Start: höherer pH ("
            },
            {
              "type": "math",
              "tex": "pH \\approx 2{,}9",
              "speech": "pH ungefähr 2,9"
            },
            {
              "type": "text",
              "text": ").     - Deutlicher Pufferbereich; Halbäquivalenzpunkt (HÄP) bei "
            },
            {
              "type": "math",
              "tex": "\\mathbf{pH = pK_s}",
              "speech": "pH gleich pK s"
            },
            {
              "type": "text",
              "text": ".     - Äquivalenzpunkt (ÄP): Liegt im Basischen ("
            },
            {
              "type": "math",
              "tex": "pH \\approx 8{,}5-9",
              "speech": "pH ungefähr 8,5 bis 9"
            },
            {
              "type": "text",
              "text": "), da das entstandene Acetat-Anion "
            },
            {
              "type": "math",
              "tex": "CH_3COO^-",
              "speech": "C H drei C O O minus"
            },
            {
              "type": "text",
              "text": " als schwache Base alkalisch reagiert ("
            },
            {
              "type": "math",
              "tex": "CH_3COO^- + H_2O \\rightleftharpoons CH_3COOH + OH^-",
