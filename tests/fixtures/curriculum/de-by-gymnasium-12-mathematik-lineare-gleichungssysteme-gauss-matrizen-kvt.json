      ],
      "practice_items": [
        {
          "id": "01K8GC10000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Welche Eigenschaft muss eine quadratische Matrix "
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": " zwingend aufweisen, um eine stochastische Übergangsmatrix darzustellen?"
            }
          ],
          "concept": "Alle Einträge m_ij müssen Wahrscheinlichkeiten sein (0 <= m_ij <= 1) und die Summe der Einträge jeder Spalte (bzw. Zeile je nach Vektorkonvention) muss exakt 1 betragen (Spaltensummen = 1)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Alle Einträge in [0; 1] und jede Spaltensumme beträgt exakt 1",
              "Die Determinante muss 0 sein"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GC10000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere stochastische Übergangsprozesse und berechne die stationäre Grenzverteilung (Fixvektor): 1. Stochastische Übergangsmatrix "
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": ":   * Beschreibt Zustandswechsel zwischen Zuständen "
            },
            {
              "type": "math",
              "tex": "Z_1, Z_2, \\dots, Z_k",
              "speech": "Z eins, Z zwei bis Z k"
            },
            {
              "type": "text",
              "text": ".   * Zustand nach "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": " Schritten: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{v}_n = M^n \\cdot \\vec{v}_0}",
              "speech": "Vektor v n gleich M hoch n mal Vektor v null"
            },
            {
              "type": "text",
              "text": ". 2. Der Fixvektor / Stationäre Zustand "
            },
            {
              "type": "math",
              "tex": "\\vec{v}_{\\text{stat}}",
              "speech": "Vektor v stat"
            },
            {
              "type": "text",
              "text": ":   * Ein Zustandsvektor, der sich bei Multiplikation mit "
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": " nicht mehr verändert:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{M \\cdot \\vec{v}_{\\text{stat}} = \\vec{v}_{\\text{stat}} \\iff (M - E) \\cdot \\vec{v}_{\\text{stat}} = \\vec{0}}",
              "block": true,
              "speech": "M mal Vektor v stat gleich Vektor v stat genau dann, wenn, M minus E, mal Vektor v stat gleich Nullvektor"
            },
            {
              "type": "text",
              "text": "   * Zusammen mit der Normierungsbedingung "
            },
            {
              "type": "math",
              "tex": "\\sum v_i = 1",
              "speech": "Summe der v i gleich 1"
            },
            {
              "type": "text",
              "text": " bzw. "
            },
            {
              "type": "math",
              "tex": "100\\%",
              "speech": "100 Prozent"
            },
            {
              "type": "text",
              "text": ", 3. Konkrete Berechnung:   * Gegeben ist die Übergangsmatrix zweier Smartphone-Hersteller A und B:     "
            },
            {
              "type": "math",
              "tex": "M = \\begin{pmatrix} 0{,}8 & 0{,}3 \\\\ 0{,}2 & 0{,}7 \\end{pmatrix}",
              "block": true,
              "speech": "M gleich die Matrix mit den Zeilen 0,8 und 0,3 sowie 0,2 und 0,7"
            },
            {
              "type": "text",
              "text": "   * Berechne den langfristigen stationären Marktanteil "
            },
            {
              "type": "math",
              "tex": "\\vec{v}_{\\text{stat}} = \\begin{pmatrix} x \\\\ y \\end{pmatrix}",
              "speech": "Vektor v stat gleich Spaltenvektor x, y"
            },
            {
              "type": "text",
              "text": " von A und B."
            }
          ],
          "concept": "Stochastische Prozesse: Übergangsmatrix M; Fixvektor M*v = v; LGS (M - E)*v = 0 mit x + y = 1; Rechnung: 0,8x + 0,3y = x -> -0,2x + 0,3y = 0 -> 2x = 3y; mit x + y = 1 -> x = 0,6 (60% für A), y = 0,4 (40% für B).",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Modellierung stochastischer Prozesse mit Übergangsmatrizen: - Übergangsmatrix "
            },
            {
              "type": "math",
              "tex": "M"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "M = \\begin{pmatrix} 0{,}8 & 0{,}3 \\\\ 0{,}2 & 0{,}7 \\end{pmatrix}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Interpretation: "
            },
            {
              "type": "math",
              "tex": "80\\%"
            },
            {
              "type": "text",
              "text": " der Kunden von A bleiben bei A, "
            },
            {
              "type": "math",
              "tex": "20\\%"
            },
            {
              "type": "text",
              "text": " wechseln zu B. "
            },
            {
              "type": "math",
              "tex": "30\\%"
            },
            {
              "type": "text",
              "text": " der Kunden von B wechseln zu A, "
            },
            {
              "type": "math",
              "tex": "70\\%"
            },
            {
              "type": "text",
              "text": " bleiben bei B.   * Spaltensummen: "
            },
            {
              "type": "math",
              "tex": "0{,}8 + 0{,}2 = 1"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "0{,}3 + 0{,}7 = 1"
            },
            {
              "type": "text",
              "text": ". 2. Bestimmung des Fixvektors "
            },
            {
              "type": "math",
              "tex": "\\vec{v}_{\\text{stat}} = \\begin{pmatrix} x \\\\ y \\end{pmatrix}"
            },
            {
              "type": "text",
              "text": ": - Fixvektorgleichung:   "
            },
            {
              "type": "math",
              "tex": "\\begin{pmatrix} 0{,}8 & 0{,}3 \\\\ 0{,}2 & 0{,}7 \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\end{pmatrix} = \\begin{pmatrix} x \\\\ y \\end{pmatrix}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Dies liefert das lineare Gleichungssystem:   "
            },
            {
              "type": "math",
              "tex": "\\begin{aligned}     (I)  & \\quad 0{,}8x + 0{,}3y = x \\implies -0{,}2x + 0{,}3y = 0 \\implies 2x = 3y \\\\     (II) & \\quad 0{,}2x + 0{,}7y = y \\implies 0{,}2x - 0{,}3y = 0 \\quad (\\text{äquivalent zu I})   \\end{aligned}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Normierungsbedingung (Gesamtwahrscheinlichkeit "
            },
            {
              "type": "math",
              "tex": "100\\%"
            },
            {
              "type": "text",
              "text": "):   "
            },
            {
              "type": "math",
              "tex": "(III) \\quad x + y = 1 \\implies y = 1 - x",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Auflösung: - Einsetzen von "
            },
            {
              "type": "math",
              "tex": "y = 1 - x"
            },
            {
              "type": "text",
              "text": " in "
            },
            {
              "type": "math",
              "tex": "2x = 3y"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "2x = 3(1 - x) = 3 - 3x \\implies 5x = 3 \\implies \\mathbf{x = \\frac{3}{5} = 0{,}6} \\quad (60\\%)",
              "block": true
            },
            {
              "type": "text",
              "text": " - Damit ergibt sich für "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{y = 1 - 0{,}6 = 0{,}4} \\quad (40\\%)",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Ergebnis & Interpretation: - Der stationäre Fixvektor lautet:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{v}_{\\text{stat}} = \\begin{pmatrix} 0{,}6 \\\\ 0{,}4 \\end{pmatrix}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Bedeutung: Unabhängig von den anfänglichen Marktanteilen "
            },
            {
              "type": "math",
              "tex": "\\vec{v}_0"
            },
            {
              "type": "text",
              "text": " stabilisieren sich die Marktanteile langfristig bei "
            },
            {
              "type": "math",
              "tex": "60\\%"
            },
            {
              "type": "text",
              "text": " für Hersteller A und "
            },
            {
              "type": "math",
              "tex": "40\\%"
            },
            {
              "type": "text",
              "text": " für Hersteller B."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    }
  ]
