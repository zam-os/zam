      "practice_items": [
        {
          "id": "01K8G8C0000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Wie lautet die fundamentale physikalische SI-Einheit für mechanische Arbeit und Energie?",
          "concept_segments": [
            {
              "type": "text",
              "text": "Joule (J) bzw. Newtonmeter: "
            },
            {
              "type": "math",
              "tex": "1\\,\\text{J} = 1\\,\\text{N} \\cdot \\text{m} = 1\\,\\text{kg} \\cdot \\text{m}^2/\\text{s}^2",
              "speech": "1 Joule gleich 1 Newton mal Meter gleich 1 Kilogramm mal Quadratmeter pro Sekunde Quadrat"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Joule (J) bzw. Newtonmeter (N * m)",
              "Watt (W)"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8G8C0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Energie, Arbeit, Leistung und den Energieerhaltungssatz: 1. Energieformen:   * Lageenergie (potentielle Energie): "
            },
            {
              "type": "math",
              "tex": "E_{\\text{pot}} = m \\cdot g \\cdot h",
              "speech": "E pot gleich m mal g mal h"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "g \\approx 9{,}81\\,\\frac{\\text{m}}{\\text{s}^2}",
              "speech": "g ungefähr 9,81 Meter pro Sekunde Quadrat"
            },
            {
              "type": "text",
              "text": ").   * Bewegungsenergie (kinetische Energie): "
            },
            {
              "type": "math",
              "tex": "E_{\\text{kin}} = \\frac{1}{2} m \\cdot v^2",
              "speech": "E kin gleich ein halb m mal v Quadrat"
            },
            {
              "type": "text",
              "text": ".   * Spannenergie: "
            },
            {
              "type": "math",
              "tex": "E_{\\text{spann}} = \\frac{1}{2} D \\cdot s^2",
              "speech": "E spann gleich ein halb D mal s Quadrat"
            },
            {
              "type": "text",
              "text": ", 2. Mechanische Arbeit: "
            },
            {
              "type": "math",
              "tex": "W = F \\cdot s",
              "speech": "W gleich F mal s"
            },
            {
              "type": "text",
              "text": " (Kraft in Wegrichtung); Formen: Hubarbeit ("
            },
            {
              "type": "math",
              "tex": "W_H = mgh",
              "speech": "W H gleich m g h"
            },
            {
              "type": "text",
              "text": "), Beschleunigungsarbeit, Reibungsarbeit, 3. Der Energieerhaltungssatz der Mechanik: In einem abgeschlossenen, reibungsfreien System ist die Summe aus potentieller und kinetischer Energie konstant: "
            },
            {
              "type": "math",
              "tex": "E_{\\text{ges}} = E_{\\text{pot}} + E_{\\text{kin}} = \\text{konstant}",
              "speech": "E ges gleich E pot plus E kin gleich konstant"
            },
            {
              "type": "text",
              "text": ", 4. Leistung & Wirkungsgrad: "
            },
            {
              "type": "math",
              "tex": "P = \\frac{W}{t}",
              "speech": "P gleich W durch t"
            },
            {
              "type": "text",
              "text": " (Einheit Watt: "
            },
            {
              "type": "math",
              "tex": "1\\,\\text{W} = 1\\,\\frac{\\text{J}}{\\text{s}}",
              "speech": "1 Watt gleich 1 Joule pro Sekunde"
            },
            {
              "type": "text",
              "text": "), "
            },
            {
              "type": "math",
              "tex": "\\eta = \\frac{E_{\\text{nutz}}}{E_{\\text{zu}}} = \\frac{P_{\\text{nutz}}}{P_{\\text{zu}}} < 1",
              "speech": "Eta gleich E nutz durch E zu gleich P nutz durch P zu kleiner als 1"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Mechanik: "
            },
            {
              "type": "math",
              "tex": "E_{\\text{pot}} = m \\cdot g \\cdot h",
              "speech": "E pot gleich m mal g mal h"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "E_{\\text{kin}} = \\frac{1}{2} \\cdot m \\cdot v^2",
              "speech": "E kin gleich ein halb mal m mal v Quadrat"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "E_{\\text{spann}} = \\frac{1}{2} \\cdot D \\cdot s^2",
              "speech": "E spann gleich ein halb mal D mal s Quadrat"
            },
            {
              "type": "text",
              "text": "; Arbeit "
            },
            {
              "type": "math",
              "tex": "W = F \\cdot s",
              "speech": "W gleich F mal s"
            },
            {
              "type": "text",
              "text": " (Hubarbeit "
            },
            {
              "type": "math",
              "tex": "m g h",
              "speech": "m g h"
            },
            {
              "type": "text",
              "text": "); Energieerhaltung "
            },
            {
              "type": "math",
              "tex": "E_{\\text{pot}} + E_{\\text{kin}} = \\text{const}",
              "speech": "E pot plus E kin gleich konstant"
            },
            {
              "type": "text",
              "text": "; Leistung "
            },
            {
              "type": "math",
              "tex": "P = \\frac{W}{t}",
              "speech": "P gleich W durch t"
            },
            {
              "type": "text",
              "text": " in Watt; Wirkungsgrad "
            },
            {
              "type": "math",
              "tex": "\\eta = \\frac{E_{\\text{nutz}}}{E_{\\text{zu}}}",
              "speech": "Eta gleich E nutz durch E zu"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Mechanische Energieformen: - Energie ist die Fähigkeit eines Körpers, physikalische Arbeit zu verrichten, Wärme abzugeben oder Strahlung auszusenden (Einheit: 1 Joule [J] = 1 N · m = 1 kg · m²/s²):   * 1. Potentielle Energie (Höhenenergie / Lageenergie):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E_{\\text{pot}} = m \\cdot g \\cdot h}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * 2. Kinetische Energie (Bewegungsenergie):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E_{\\text{kin}} = \\frac{1}{2} m \\cdot v^2}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * 3. Spannenergie einer Feder:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E_{\\text{spann}} = \\frac{1}{2} D \\cdot s^2} \\quad (D = \\text{Federkonstante in N/m})",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Mechanische Arbeit ("
            },
            {
              "type": "math",
              "tex": "W"
            },
            {
              "type": "text",
              "text": "): - Arbeit wird verrichtet, wenn ein Körper durch eine Kraft "
            },
            {
              "type": "math",
              "tex": "F"
            },
            {
              "type": "text",
              "text": " längs eines Weges "
            },
            {
              "type": "math",
              "tex": "s"
            },
            {
              "type": "text",
              "text": " bewegt oder verformt wird:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{W = F \\cdot s} \\quad (\\text{für } F \\parallel s)",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Hubarbeit: "
            },
            {
              "type": "math",
              "tex": "W_{\\text{Hub}} = F_G \\cdot h = m \\cdot g \\cdot h = \\Delta E_{\\text{pot}}"
            },
            {
              "type": "text",
              "text": ".   * Beschleunigungsarbeit: "
            },
            {
              "type": "math",
              "tex": "W_{\\text{Beschl}} = \\frac{1}{2} m v^2 = \\Delta E_{\\text{kin}}"
            },
            {
              "type": "text",
              "text": ". 3. Der Energieerhaltungssatz der Mechanik: - In einem abgeschlossenen System ohne Reibungsverluste kann Energie weder erzeugt noch vernichtet, sondern nur von einer Form in eine andere umgewandelt werden:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E_{\\text{ges}} = E_{\\text{pot}} + E_{\\text{kin}} = \\text{konstant}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Beispiel freier Fall aus Höhe "
            },
            {
              "type": "math",
              "tex": "h"
            },
            {
              "type": "text",
              "text": ": Am Start gilt "
            },
            {
              "type": "math",
              "tex": "E_{\\text{ges}} = mgh"
            },
            {
              "type": "text",
              "text": ", beim Aufprall "
            },
            {
              "type": "math",
              "tex": "E_{\\text{ges}} = \\frac{1}{2}mv^2 \\implies v = \\sqrt{2gh}"
            },
            {
              "type": "text",
              "text": "). 4. Physikalische Leistung ("
            },
            {
              "type": "math",
              "tex": "P"
            },
            {
              "type": "text",
              "text": ") und Wirkungsgrad ("
            },
            {
              "type": "math",
              "tex": "\\eta"
            },
            {
              "type": "text",
              "text": "): - Leistung "
            },
            {
              "type": "math",
              "tex": "P"
            },
            {
              "type": "text",
              "text": ": Gibt an, wie schnell eine bestimmte Arbeit verrichtet wird (Arbeit pro Zeitspanne):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P = \\frac{W}{t} = F \\cdot v} \\quad (\\text{Einheit: } 1\\text{ Watt [W]} = 1\\,\\frac{\\text{J}}{\\text{s}})",
              "block": true
            },
            {
              "type": "text",
              "text": " - Wirkungsgrad "
            },
            {
              "type": "math",
              "tex": "\\eta"
            },
            {
              "type": "text",
              "text": ": Das Verhältnis von nutzbarer Energie zu zugeführter Energie (stets "
            },
            {
              "type": "math",
              "tex": "\\eta < 100\\%"
            },
            {
              "type": "text",
              "text": " durch unvermeidliche Reibungswärme):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\eta = \\frac{E_{\\text{nutz}}}{E_{\\text{zu}}} = \\frac{P_{\\text{nutz}}}{P_{\\text{zu}}}} \\quad (0 \\le \\eta < 1)",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
