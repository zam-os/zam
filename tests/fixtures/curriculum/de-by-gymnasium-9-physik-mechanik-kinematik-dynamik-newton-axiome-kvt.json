          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Wie lautet das 2. Newtonsche Axiom (Grundgesetz der Dynamik / Aktionsprinzip)?",
          "concept_segments": [
            {
              "type": "math",
              "tex": "F = m \\cdot a",
              "speech": "F gleich m mal a"
            },
            {
              "type": "text",
              "text": " (Kraft = Masse · Beschleunigung, "
            },
            {
              "type": "math",
              "tex": "1\\,\\text{Newton} = 1\\,\\text{kg} \\cdot \\text{m}/\\text{s}^2",
              "speech": "1 Newton gleich 1 Kilogramm mal Meter pro Sekunde Quadrat"
            },
            {
              "type": "text",
              "text": ")"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
