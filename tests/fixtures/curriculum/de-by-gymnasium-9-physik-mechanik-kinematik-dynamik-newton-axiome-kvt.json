          "sample_solution": [
            {
              "type": "text",
              "text": "1. Grundgleichungen der geradlinigen Kinematik: - 1. Gleichförmige Bewegung ("
            },
            {
              "type": "math",
              "tex": "v = \\text{konst.}"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "a = 0"
            },
            {
              "type": "text",
              "text": "):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{s(t) = v \\cdot t} \\quad \\iff \\quad \\mathbf{v = \\frac{s}{t}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Im "
            },
            {
              "type": "math",
              "tex": "s"
            },
            {
              "type": "text",
              "text": "-"
            },
            {
              "type": "math",
              "tex": "t"
            },
            {
              "type": "text",
              "text": "-Diagramm: Ursprungsgerade mit der Steigung "
            },
            {
              "type": "math",
              "tex": "m = v"
            },
            {
              "type": "text",
              "text": ".   * Im "
            },
            {
              "type": "math",
              "tex": "v"
            },
            {
              "type": "text",
              "text": "-"
            },
            {
              "type": "math",
              "tex": "t"
            },
            {
              "type": "text",
              "text": "-Diagramm: Waagrechte Gerade; die Rechtecksfläche "
            },
            {
              "type": "math",
              "tex": "A = v \\cdot t"
            },
            {
              "type": "text",
              "text": " entspricht dem Weg "
            },
            {
              "type": "math",
              "tex": "s"
            },
            {
              "type": "text",
              "text": ". - 2. Gleichmäßig beschleunigte Bewegung ("
            },
            {
              "type": "math",
              "tex": "a = \\text{konst.}"
            },
            {
              "type": "text",
              "text": "):   * Definition der Beschleunigung:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{a = \\frac{\\Delta v}{\\Delta t}} \\quad (\\text{Einheit: } \\frac{\\text{m}}{\\text{s}^2})",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Geschwindigkeit-Zeit-Gesetz (aus der Ruhe "
            },
            {
              "type": "math",
              "tex": "v_0 = 0"
            },
            {
              "type": "text",
              "text": "):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{v(t) = a \\cdot t}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Weg-Zeit-Gesetz:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{s(t) = \\frac{1}{2} a \\cdot t^2} = \\frac{1}{2} \\cdot v \\cdot t",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Zusammenhang zwischen Endgeschwindigkeit und Weg:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{v = \\sqrt{2 \\cdot a \\cdot s}}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Der Freie Fall als Sonderfall: - Erdbeschleunigung im Vakuum: "
            },
            {
              "type": "math",
              "tex": "g \\approx 9{,}81\\,\\frac{\\text{m}}{\\text{s}^2}"
            },
            {
              "type": "text",
              "text": ".   * Fallzeit aus Höhe "
            },
            {
              "type": "math",
              "tex": "h"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "t = \\sqrt{\\frac{2h}{g}}"
            },
            {
              "type": "text",
              "text": ".   * Aufprallgeschwindigkeit: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{v = \\sqrt{2gh}}"
            },
            {
              "type": "text",
              "text": " (folgt auch direkt aus dem Energieerhaltungssatz "
            },
            {
              "type": "math",
              "tex": "mgh = \\frac{1}{2}mv^2"
            },
            {
              "type": "text",
              "text": "). 3. Durchrechnung des Beispiels: - Gegeben: "
            },
            {
              "type": "math",
              "tex": "v_0 = 0"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "t = 5\\,\\text{s}"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "v = 108\\,\\frac{\\text{km}}{\\text{h}} = \\frac{108}{3{,}6}\\,\\frac{\\text{m}}{\\text{s}} = \\mathbf{30\\,\\frac{\\text{m}}{\\text{s}}}"
            },
            {
              "type": "text",
              "text": ". - Schritt 1: Beschleunigung "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "a = \\frac{v}{t} = \\frac{30\\,\\frac{\\text{m}}{\\text{s}}}{5\\,\\text{s}} = \\mathbf{6\\,\\frac{\\text{m}}{\\text{s}^2}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Zurückgelegter Weg "
            },
            {
              "type": "math",
              "tex": "s"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "s = \\frac{1}{2} a \\cdot t^2 = \\frac{1}{2} \\cdot 6\\,\\frac{\\text{m}}{\\text{s}^2} \\cdot (5\\,\\text{s})^2 = 3 \\cdot 25\\,\\text{m} = \\mathbf{75\\,\\text{m}}",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
