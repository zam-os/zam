              "speech": "R"
            },
            {
              "type": "text",
              "text": " nach dem Ohmschen Gesetz?"
            }
          ],
          "concept": "R = U / I (Widerstand = Spannung / Stromstärke, Einheit: 1 Ohm = 1 V / A)",
