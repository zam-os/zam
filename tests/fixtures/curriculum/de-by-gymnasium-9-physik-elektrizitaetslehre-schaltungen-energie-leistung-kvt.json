          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie verhalten sich die Teilströme "
            },
            {
              "type": "math",
              "tex": "I_1",
              "speech": "I eins"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "I_2",
              "speech": "I zwei"
            },
            {
              "type": "text",
              "text": " in einer Parallelschaltung zweier Widerstände zum Gesamtstrom "
            },
            {
              "type": "math",
              "tex": "I_{\\text{ges}}",
              "speech": "I ges"
            },
            {
              "type": "text",
              "text": " (1. Kirchhoffsche Knotenregel)?"
            }
          ],
          "concept": "Die Summe der Teilströme ist gleich dem Gesamtstrom: I_ges = I_1 + I_2",
          "fast_check": {
