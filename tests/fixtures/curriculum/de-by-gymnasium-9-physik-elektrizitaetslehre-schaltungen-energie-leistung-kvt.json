              "tex": "\\mathbf{W = P \\cdot t = U \\cdot I \\cdot t} \\quad (\\text{Einheit: } 1\\text{ J} = 1\\text{ Ws}; \\quad 1\\text{ kWh} = 1000\\text{ W} \\cdot 3600\\text{ s} = \\mathbf{3{,}6\\,\\text{MJ}})",
