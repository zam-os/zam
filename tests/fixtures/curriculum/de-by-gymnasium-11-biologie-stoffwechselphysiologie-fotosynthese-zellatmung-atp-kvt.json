      "practice_items": [
        {
          "id": "01K8GBH0000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Aus welchem Molekül stammt der bei der pflanzlichen Fotosynthese an die Erdatmosphäre freigesetzte molekulare Sauerstoff ("
            },
            {
              "type": "math",
              "tex": "O_2",
              "speech": "O zwei"
            },
            {
              "type": "text",
              "text": ")?"
            }
          ],
          "concept": "Aus dem Wasser (H2O) durch die lichtgetriebene Photolyse des Wassers am Mangan-Komplex des Fotosystems II (und nicht aus dem Kohlendioxid)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Aus dem Wasser (H2O durch Photolyse am Fotosystem II)",
              "Aus dem aufgenommenen Kohlendioxid (CO2)"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GBH0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die biochemischen Reaktionen der Fotosynthese im Chloroplasten: 1. Bruttogleichung der oxygenen Fotosynthese:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{6\\,\\text{CO}_2 + 12\\,\\text{H}_2\\text{O} \\xrightarrow{h\\nu, \\text{Chlorophyll}} \\text{C}_6\\text{H}_{12}\\text{O}_6 + 6\\,\\text{O}_2 + 6\\,\\text{H}_2\\text{O}}",
              "block": true,
              "speech": "6 C O zwei plus 12 H zwei O reagiert mit Licht und Chlorophyll zu C sechs H zwölf O sechs plus 6 O zwei plus 6 H zwei O"
            },
            {
              "type": "text",
              "text": " 2. Die Lichtreaktion (Thylakoidmembran):   * Fotosystem II ("
            },
            {
              "type": "math",
              "tex": "P_{680}",
              "speech": "P 680"
            },
            {
              "type": "text",
              "text": "): Absorption von Lichtenergie "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " Anregung von Elektronen "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " Photolyse des Wassers:     "
            },
            {
              "type": "math",
              "tex": "2\\,\\text{H}_2\\text{O} \\rightarrow \\text{O}_2 + 4\\,\\text{H}^+ + 4\\,e^-",
              "block": true,
              "speech": "2 H zwei O reagiert zu O zwei plus 4 H plus plus 4 Elektronen"
            },
            {
              "type": "text",
              "text": "   * Elektronentransportkette (Z-Schema): Plastochinon "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " Cytochrom-"
            },
            {
              "type": "math",
              "tex": "b_6f",
              "speech": "Cytochrom b sechs f"
            },
            {
              "type": "text",
              "text": "-Komplex (pumpt "
            },
            {
              "type": "math",
              "tex": "H^+",
              "speech": "H plus"
            },
            {
              "type": "text",
              "text": " in das Thylakoidlumen) "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " Plastocyanin "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " Fotosystem I ("
            },
            {
              "type": "math",
              "tex": "P_{700}",
              "speech": "P 700"
            },
            {
              "type": "text",
              "text": ") "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " Ferredoxin "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "\\text{NADP}^+",
              "speech": "N A D P plus"
            },
            {
              "type": "text",
              "text": "-Reduktase:     "
            },
            {
              "type": "math",
              "tex": "\\text{NADP}^+ + 2\\,e^- + 2\\,\\text{H}^+ \\rightarrow \\mathbf{\\text{NADPH} + \\text{H}^+}",
              "block": true,
              "speech": "N A D P plus plus 2 Elektronen plus 2 H plus reagiert zu N A D P H plus H plus"
            },
            {
              "type": "text",
              "text": "   * Photophosphorylierung (Peter Mitchells Chemiosmose): Protonengradient (hohe "
            },
            {
              "type": "math",
              "tex": "H^+",
              "speech": "H plus"
            },
            {
              "type": "text",
              "text": "-Konzentration im Lumen) treibt die rotorartige ATP-Synthase im Stroma an "
            },
            {
              "type": "math",
              "tex": "\\implies \\mathbf{\\text{ADP} + \\text{P}_i \\rightarrow \\text{ATP}}",
              "speech": "daraus folgt A D P plus anorganisches Phosphat reagiert zu A T P"
            },
            {
              "type": "text",
              "text": ", 3. Die Dunkelreaktion / Calvin-Zyklus (im Stroma):   * 1. Phase ("
            },
            {
              "type": "math",
              "tex": "\\text{CO}_2",
              "speech": "C O zwei"
            },
            {
              "type": "text",
              "text": "-Fixierung): Enzym RuBisCO fixiert "
            },
            {
              "type": "math",
              "tex": "\\text{CO}_2",
              "speech": "C O zwei"
            },
            {
              "type": "text",
              "text": " an Ribulose-1,5-bisphosphat ("
            },
            {
              "type": "math",
              "tex": "C_5",
              "speech": "C fünf"
            },
            {
              "type": "text",
              "text": ") "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " zerfällt in "
            },
            {
              "type": "math",
              "tex": "2 \\times",
              "speech": "2 mal"
            },
            {
              "type": "text",
              "text": " 3-Phosphoglycerat ("
            },
            {
              "type": "math",
              "tex": "C_3",
              "speech": "C drei"
            },
            {
              "type": "text",
              "text": ").   * 2. Phase (Reduktion): Verbrauch von "
            },
            {
              "type": "math",
              "tex": "\\text{ATP}",
              "speech": "A T P"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\text{NADPH/H}^+",
              "speech": "N A D P H und H plus"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " Bildung von Glycerinaldehyd-3-phosphat (GAP / Triosephosphat) "
            },
            {
              "type": "math",
              "tex": "\\rightarrow",
              "speech": "führt zu"
            },
            {
              "type": "text",
              "text": " Synthese von Glucose.   * 3. Phase (Regeneration): Rückbildung von Ribulose-1,5-bisphosphat unter erneutem "
            },
            {
              "type": "math",
              "tex": "\\text{ATP}",
              "speech": "A T P"
            },
            {
              "type": "text",
              "text": "-Verbrauch."
            }
          ],
          "concept": "Fotosynthese: Bruttogleichung; Lichtreaktion (Fotosystem II P680 mit Photolyse von H2O -> O2, Z-Schema, Fotosystem I P700, NADPH-Bildung, ATP-Synthase über Protonengradienten); Calvin-Zyklus (RuBisCO, CO2-Fixierung an C5, Reduktion mit ATP/NADPH zu Glucose, Regeneration).",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Gesamtreaktion und energetische Bedeutung der Fotosynthese: - Bruttogleichung:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{6\\,\\text{CO}_2 + 12\\,\\text{H}_2\\text{O} \\xrightarrow{\\text{Licht, Chlorophyll}} \\text{C}_6\\text{H}_{12}\\text{O}_6 + 6\\,\\text{O}_2 + 6\\,\\text{H}_2\\text{O}} \\quad (\\Delta G^\\circ = +2870\\,\\text{kJ/mol})",
              "block": true
            },
            {
              "type": "text",
              "text": " - Funktion: Photoautotrophe Umwandlung von energiearmer anorganischer Strahlungsenergie in chemisch gebundene Energie organischer Kohlenhydrate. 2. Die primären photochemischen Reaktionen (Lichtreaktion): - Ort: In der Thylakoidmembran der Chloroplasten. - 1. Fotosystem II ("
            },
            {
              "type": "math",
              "tex": "P_{680}"
            },
            {
              "type": "text",
              "text": "):   * Lichtabsorption regt das Reaktionszentrum "
            },
            {
              "type": "math",
              "tex": "P_{680}"
            },
            {
              "type": "text",
              "text": " an. Das abgegebene Elektron wird durch Elektronen aus der Photolyse des Wassers (Wasserspaltung am Sauerstoff-Entwicklungskomplex mit "
            },
            {
              "type": "math",
              "tex": "Mn_4CaO_5"
            },
            {
              "type": "text",
              "text": "-Cluster) ersetzt:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{2\\,\\text{H}_2\\text{O} \\xrightarrow{h\\nu} \\text{O}_2 \\uparrow + 4\\,\\text{H}^+_{\\text{Lumen}} + 4\\,e^-}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Elektronentransportkette (Das Z-Schema):   * Elektronen fließen bergab über Plastochinon, den Cytochrom-"
            },
            {
              "type": "math",
              "tex": "b_6f"
            },
            {
              "type": "text",
              "text": "-Komplex (der aktiv zusätzliche Protonen "
            },
            {
              "type": "math",
              "tex": "H^+"
            },
            {
              "type": "text",
              "text": " aus dem Stroma ins Thylakoidlumen pumpt) und Plastocyanin zum Fotosystem I ("
            },
            {
              "type": "math",
              "tex": "P_{700}"
            },
            {
              "type": "text",
              "text": ").   * Nach erneuter Lichtanregung fließen die Elektronen über Ferredoxin zur "
            },
            {
              "type": "math",
              "tex": "\\text{NADP}^+"
            },
            {
              "type": "text",
              "text": "-Reduktase:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\text{NADP}^+ + 2\\,e^- + 2\\,\\text{H}^+_{\\text{Stroma}} \\rightarrow \\text{NADPH} + \\text{H}^+}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 3. Chemiosmotische ATP-Synthese:   * Die Protonenakkumulation erzeugt einen steilen elektrochemischen Gradienten (Lumen "
            },
            {
              "type": "math",
              "tex": "pH \\approx 5"
            },
            {
              "type": "text",
              "text": ", Stroma "
            },
            {
              "type": "math",
              "tex": "pH \\approx 8 \\implies \\Delta pH = 3"
            },
            {
              "type": "text",
              "text": ").   * Der Rückstrom der Protonen durch den Kanal der ATP-Synthase ins Stroma treibt die rotierende Synthese von ATP aus ADP und Phosphat an (Photophosphorylierung). 3. Die sekundären biochemischen Reaktionen (Calvin-Benson-Zyklus): - Ort: Im Stroma der Chloroplasten (lichtunabhängig, benötigt jedoch die Produkte ATP und NADPH der Lichtreaktion): - 1. "
            },
            {
              "type": "math",
              "tex": "\\text{CO}_2"
            },
            {
              "type": "text",
              "text": "-Fixierung:   * Das Schlüsselenzym RuBisCO (Ribulose-1,5-bisphosphat-Carboxylase/-Oxygenase) bindet "
            },
            {
              "type": "math",
              "tex": "6\\,\\text{CO}_2"
            },
            {
              "type": "text",
              "text": " an sechs "
            },
            {
              "type": "math",
              "tex": "C_5"
            },
            {
              "type": "text",
              "text": "-Körper (Ribulose-1,5-bisphosphat) "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Entstehung von 12 Molekülen 3-Phosphoglycerat ("
            },
            {
              "type": "math",
              "tex": "C_3"
            },
            {
              "type": "text",
              "text": "). - 2. Reduktionsphase:   * Unter Verbrauch von "
            },
            {
              "type": "math",
              "tex": "12\\,\\text{ATP}"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "12\\,\\text{NADPH} + \\text{H}^+"
            },
            {
              "type": "text",
              "text": " wird 3-Phosphoglycerat zu 12 Molekülen Glycerinaldehyd-3-phosphat (GAP) reduziert.   * 2 Moleküle GAP ("
            },
            {
              "type": "math",
              "tex": "2 \\times C_3"
            },
            {
              "type": "text",
              "text": ") werden aus dem Zyklus ausgeschleust und zur Biosynthese von 1 Molekül Glucose ("
            },
            {
              "type": "math",
              "tex": "C_6H_{12}O_6"
            },
            {
              "type": "text",
              "text": ") bzw. Stärke genutzt. - 3. Regenerationsphase:   * Die verbliebenen 10 Moleküle GAP ("
            },
            {
              "type": "math",
              "tex": "10 \\times C_3 = 30\\,\\text{C}"
            },
            {
              "type": "text",
              "text": ") werden unter Verbrauch von "
            },
            {
              "type": "math",
              "tex": "6\\,\\text{ATP}"
            },
            {
              "type": "text",
              "text": " zu sechs Molekülen des Ausgangszuckers Ribulose-1,5-bisphosphat ("
            },
            {
              "type": "math",
              "tex": "6 \\times C_5 = 30\\,\\text{C}"
            },
            {
              "type": "text",
              "text": ") regeneriert."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
