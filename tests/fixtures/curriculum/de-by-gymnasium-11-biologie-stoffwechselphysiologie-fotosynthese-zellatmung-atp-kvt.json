      "practice_items": [
        {
          "id": "01K8GBH0000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Was dient am Ende der mitochondrialen Atmungskette (Komplex IV / Cytochrom-c-Oxidase) als finaler Elektronenakzeptor?",
          "concept": "Molekularer Sauerstoff (O2), der zusammen mit Elektronen und Protonen zu Wasser (H2O) reduziert wird (Knallgasreaktion in kontrollierten Stufen)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Molekularer Sauerstoff (O2, wird zu H2O reduziert)",
              "Kohlendioxid (CO2)"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K8GBH0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die 4 Teilschritte der aeroben Zellatmung und die Gesamt-ATP-Bilanz: 1. Gesamtgleichung der aeroben Dissimilation:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\text{C}_6\\text{H}_{12}\\text{O}_6 + 6\\,\\text{O}_2 + 6\\,\\text{H}_2\\text{O} \\longrightarrow 6\\,\\text{CO}_2 + 12\\,\\text{H}_2\\text{O} + \\text{Energie (ca. 30–32 ATP)}}",
              "block": true,
              "speech": "C sechs H zwölf O sechs plus 6 O zwei plus 6 H zwei O führt zu 6 C O zwei plus 12 H zwei O plus Energie, etwa 30 bis 32 A T P"
            },
            {
              "type": "text",
              "text": " 2. Die 4 Teilschritte im Detail:   * 1. Glykolyse (Zytoplasma): Spaltung von "
            },
            {
              "type": "math",
              "tex": "1\\,\\text{Glucose } (C_6)",
              "speech": "1 Glucose, C sechs"
            },
            {
              "type": "text",
              "text": " in "
            },
            {
              "type": "math",
              "tex": "2\\,\\text{Pyruvat } (C_3)",
              "speech": "2 Pyruvat, C drei"
            },
            {
              "type": "text",
              "text": ". Ausbeute: "
            },
            {
              "type": "math",
              "tex": "+2\\,\\text{ATP}",
              "speech": "plus 2 A T P"
            },
            {
              "type": "text",
              "text": " (Substratkettenphosphorylierung) und "
            },
            {
              "type": "math",
              "tex": "+2\\,\\text{NADH/H}^+",
              "speech": "plus 2 NADH und H plus"
            },
            {
              "type": "text",
              "text": ".   * 2. Oxidative Decarboxylierung (Mitochondrienmatrix): "
            },
            {
              "type": "math",
              "tex": "2\\,\\text{Pyruvat} \\rightarrow 2\\,\\text{Acetyl-CoA } (C_2) + 2\\,\\text{CO}_2 + 2\\,\\text{NADH/H}^+",
              "speech": "2 Pyruvat reagiert zu 2 Acetyl-CoA, C zwei, plus 2 C O zwei plus 2 NADH und H plus"
            },
            {
              "type": "text",
              "text": ".   * 3. Citratzyklus / Krebs-Zyklus (Matrix): Acetyl-CoA ("
            },
            {
              "type": "math",
              "tex": "C_2",
              "speech": "C zwei"
            },
            {
              "type": "text",
              "text": ") wird an Oxalacetat ("
            },
            {
              "type": "math",
              "tex": "C_4",
              "speech": "C vier"
            },
            {
              "type": "text",
              "text": ") zu Citrat ("
            },
            {
              "type": "math",
              "tex": "C_6",
              "speech": "C sechs"
            },
            {
              "type": "text",
              "text": ") gebunden. Vollständige Oxidation unter Abspaltung von "
            },
            {
              "type": "math",
              "tex": "4\\,\\text{CO}_2",
              "speech": "4 C O zwei"
            },
