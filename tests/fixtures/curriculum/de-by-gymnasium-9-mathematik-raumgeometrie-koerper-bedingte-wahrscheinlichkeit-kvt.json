      "practice_items": [
        {
          "id": "01K8G9B0000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wann heißen zwei stochastische Ereignisse "
            },
            {
              "type": "math",
              "tex": "A",
              "speech": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B",
              "speech": "B"
            },
            {
              "type": "text",
              "text": " im mathematischen Sinne stochastisch unabhängig?"
            }
          ],
          "concept": "Wenn das Eintreffen von A die Wahrscheinlichkeit von B nicht beeinflusst: P(A geschnitten B) = P(A) * P(B) bzw. P_A(B) = P(B)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "P(A geschnitten B) = P(A) * P(B)",
              "P(A geschnitten B) = 0"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8G9B0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere bedingte Wahrscheinlichkeiten, Vierfeldertafeln und stochastische Unabhängigkeit: 1. Bedingte Wahrscheinlichkeit:   * Definition: Die Wahrscheinlichkeit, dass "
            },
            {
              "type": "math",
              "tex": "B",
              "speech": "B"
            },
            {
              "type": "text",
              "text": " eintritt, unter der Voraussetzung, dass "
            },
            {
              "type": "math",
              "tex": "A",
              "speech": "A"
            },
            {
              "type": "text",
              "text": " bereits eingetreten ist ("
            },
            {
              "type": "math",
              "tex": "P(A) > 0",
              "speech": "P von A größer als 0"
            },
            {
              "type": "text",
              "text": "):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P_A(B) = P(B \\mid A) = \\frac{P(A \\cap B)}{P(A)}}",
              "block": true,
              "speech": "P A von B gleich P von B unter der Bedingung A gleich P von A geschnitten mit B durch P von A"
            },
            {
              "type": "text",
              "text": " 2. Die Vierfeldertafel: Systematische Darstellung der Schnittmengen "
            },
            {
              "type": "math",
              "tex": "P(A \\cap B), P(A \\cap \\overline{B}), P(\\overline{A} \\cap B), P(\\overline{A} \\cap \\overline{B})",
              "speech": "P von A geschnitten mit B, P von A geschnitten mit B quer, P von A quer geschnitten mit B, P von A quer geschnitten mit B quer"
            },
            {
              "type": "text",
              "text": " und der Randwahrscheinlichkeiten "
            },
            {
              "type": "math",
              "tex": "P(A), P(\\overline{A}), P(B), P(\\overline{B})",
              "speech": "P von A, P von A quer, P von B, P von B quer"
            },
            {
              "type": "text",
              "text": ", 3. Stochastische Unabhängigkeit: "
            },
            {
              "type": "math",
              "tex": "A",
              "speech": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B",
              "speech": "B"
            },
            {
              "type": "text",
              "text": " sind stochastisch unabhängig "
            },
            {
              "type": "math",
              "tex": "\\iff P(A \\cap B) = P(A) \\cdot P(B) \\iff P_A(B) = P(B)",
              "speech": "genau dann, wenn P von A geschnitten mit B gleich P von A mal P von B genau dann, wenn P A von B gleich P von B"
            },
            {
              "type": "text",
              "text": ", 4. In einer Schule treiben "
            },
            {
              "type": "math",
              "tex": "60\\%",
              "speech": "60 Prozent"
            },
            {
              "type": "text",
              "text": " der Schüler Sport ("
            },
            {
              "type": "math",
              "tex": "S",
              "speech": "S"
            },
            {
              "type": "text",
              "text": "), "
            },
            {
              "type": "math",
              "tex": "40\\%",
              "speech": "40 Prozent"
            },
            {
              "type": "text",
              "text": " spielen ein Musikinstrument ("
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": ") und "
            },
            {
              "type": "math",
              "tex": "24\\%",
              "speech": "24 Prozent"
            },
            {
              "type": "text",
              "text": " tun beides ("
            },
            {
              "type": "math",
              "tex": "S \\cap M",
              "speech": "S geschnitten mit M"
            },
            {
              "type": "text",
              "text": "). Prüfe rechnerisch, ob Sporttreiben und Musizieren stochastisch unabhängig sind."
            }
          ],
          "concept": "Bedingte Wahrscheinlichkeit: P_A(B) = P(A geschnitten B) / P(A); Vierfeldertafel; Stochastische Unabhängigkeit: P(A geschnitten B) = P(A) * P(B); Rechnung: P(S)*P(M) = 0,60 * 0,40 = 0,24 = P(S geschnitten M) -> Ereignisse sind stochastisch unabhängig!",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Das Konzept der bedingten Wahrscheinlichkeit: - Beschreibt die Neubewertung der Wahrscheinlichkeit eines Ereignisses "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": ", wenn bekannt ist, dass die Vorbedingung "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " bereits eingetreten ist:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P_A(B) = \\frac{P(A \\cap B)}{P(A)}} \\quad (\\text{für } P(A) > 0)",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Äquivalente Multiplikationsregel: "
            },
            {
              "type": "math",
              "tex": "P(A \\cap B) = P(A) \\cdot P_A(B)"
            },
            {
              "type": "text",
              "text": ". 2. Die Vierfeldertafel (Wahrscheinlichkeiten): | | "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "\\overline{B}"
            },
            {
              "type": "text",
              "text": " | Summe (Rand) | | :--- | :--- | :--- | :--- | | "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(A \\cap B)"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(A \\cap \\overline{B})"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(A)"
            },
            {
              "type": "text",
              "text": " | | "
            },
            {
              "type": "math",
              "tex": "\\overline{A}"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(\\overline{A} \\cap B)"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(\\overline{A} \\cap \\overline{B})"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(\\overline{A})"
            },
            {
              "type": "text",
              "text": " | | Summe | "
            },
            {
              "type": "math",
              "tex": "P(B)"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "P(\\overline{B})"
            },
            {
              "type": "text",
              "text": " | "
            },
            {
              "type": "math",
              "tex": "1{,}00"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "100\\%"
            },
            {
              "type": "text",
              "text": ") | 3. Definition der stochastischen Unabhängigkeit: - Zwei Ereignisse "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": " heißen stochastisch unabhängig, wenn das Eintreten von "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " keinerlei Information über das Eintreten von "
            },
            {
              "type": "math",
              "tex": "B"
            },
            {
              "type": "text",
              "text": " liefert:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P(A \\cap B) = P(A) \\cdot P(B)} \\iff \\mathbf{P_A(B) = P(B)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Achtung: Nicht zu verwechseln mit 'unvereinbar' "
            },
            {
              "type": "math",
              "tex": "A \\cap B = \\emptyset"
            },
            {
              "type": "text",
              "text": "! Unvereinbare Ereignisse mit "
            },
            {
              "type": "math",
              "tex": "P > 0"
            },
            {
              "type": "text",
              "text": " sind niemals unabhängig). 4. Berechnung der Beispielfrage: - Gegeben:   * "
            },
            {
              "type": "math",
              "tex": "P(S) = 0{,}60"
            },
            {
              "type": "text",
              "text": " (Sportler)   * "
            },
            {
              "type": "math",
              "tex": "P(M) = 0{,}40"
            },
            {
              "type": "text",
              "text": " (Musiker)   * "
            },
            {
              "type": "math",
              "tex": "P(S \\cap M) = 0{,}24"
            },
            {
              "type": "text",
              "text": " (beides) - Prüfung auf Unabhängigkeit:   "
            },
            {
              "type": "math",
              "tex": "P(S) \\cdot P(M) = 0{,}60 \\cdot 0{,}40 = \\mathbf{0{,}24}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Vergleich:   "
            },
            {
              "type": "math",
              "tex": "P(S \\cap M) = 0{,}24 = P(S) \\cdot P(M)",
              "block": true
            },
            {
              "type": "text",
              "text": " - Ergebnis: Das Produkt der Einzelwahrscheinlichkeiten stimmt exakt mit der Schnittmengenwahrscheinlichkeit überein "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Die beiden Hobbys Sporttreiben und Musizieren sind stochastisch unabhängig."
            }
          ],
          "materiality": "cosmetic"
        }
