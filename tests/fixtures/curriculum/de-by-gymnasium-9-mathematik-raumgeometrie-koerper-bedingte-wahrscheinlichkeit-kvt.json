          "question_segments": [
            {
              "type": "text",
              "text": "Systematisiere die Raumgeometrie spitzer und runder Körper: 1. Spitzkörper (Pyramide und Kegel):   * Pyramide: "
            },
            {
              "type": "math",
              "tex": "V = \\frac{1}{3} G \\cdot h",
              "speech": "V gleich ein Drittel G mal h"
            },
            {
              "type": "text",
              "text": ", Oberfläche "
            },
            {
              "type": "math",
              "tex": "O = G + M",
              "speech": "O gleich G plus M"
            },
            {
              "type": "text",
              "text": " (Summe der Dreiecksflächen).   * Kreiskegel (Radius "
            },
            {
              "type": "math",
              "tex": "r",
              "speech": "r"
            },
            {
              "type": "text",
              "text": ", Höhe "
            },
            {
              "type": "math",
              "tex": "h",
              "speech": "h"
            },
            {
              "type": "text",
              "text": ", Mantellinie "
            },
            {
              "type": "math",
              "tex": "s = \\sqrt{r^2 + h^2}",
              "speech": "s gleich Wurzel aus r Quadrat plus h Quadrat"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "V = \\frac{1}{3} \\pi r^2 h",
              "speech": "V gleich ein Drittel Pi r Quadrat h"
            },
            {
              "type": "text",
              "text": ", Mantelfläche "
            },
            {
              "type": "math",
              "tex": "M = \\pi r s",
              "speech": "M gleich Pi r s"
            },
            {
              "type": "text",
              "text": ", Gesamtoberfläche "
            },
            {
              "type": "math",
              "tex": "O = \\pi r^2 + \\pi r s",
              "speech": "O gleich Pi r Quadrat plus Pi r s"
            },
            {
              "type": "text",
              "text": ", 2. Die Kugel:   * Volumen: "
            },
            {
              "type": "math",
              "tex": "V = \\frac{4}{3}\\pi r^3",
              "speech": "V gleich vier Drittel Pi r hoch drei"
            },
            {
              "type": "text",
              "text": ".   * Oberfläche: "
            },
            {
              "type": "math",
              "tex": "O = 4\\pi r^2",
              "speech": "O gleich 4 Pi r Quadrat"
            },
            {
              "type": "text",
              "text": ", 3. Prinzip von Cavalieri: Haben zwei Körper dieselbe Höhe und sind ihre Schnittflächen in jeder parallelen Schnittebene flächengleich, so besitzen beide Körper dasselbe Volumen, 4. Berechne das Volumen "
            },
            {
              "type": "math",
              "tex": "V",
              "speech": "V"
            },
            {
              "type": "text",
              "text": " und die Mantelfläche "
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": " eines geraden Kreiskegels mit Radius "
            },
            {
              "type": "math",
              "tex": "r = 6\\,\\text{cm}",
              "speech": "r gleich 6 Zentimeter"
            },
            {
              "type": "text",
              "text": " und Höhe "
            },
            {
              "type": "math",
              "tex": "h = 8\\,\\text{cm}",
              "speech": "h gleich 8 Zentimeter"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Stereometrie: Pyramide "
            },
            {
              "type": "math",
              "tex": "V = \\frac{1}{3} \\cdot G \\cdot h",
              "speech": "V gleich ein Drittel mal G mal h"
            },
            {
              "type": "text",
              "text": "; Kegel "
            },
            {
              "type": "math",
              "tex": "V = \\frac{1}{3} \\cdot \\pi \\cdot r^2 \\cdot h",
              "speech": "V gleich ein Drittel mal Pi mal r Quadrat mal h"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "M = \\pi \\cdot r \\cdot s",
              "speech": "M gleich Pi mal r mal s"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "s = \\sqrt{r^2 + h^2}",
              "speech": "s gleich Wurzel aus r Quadrat plus h Quadrat"
            },
            {
              "type": "text",
              "text": "; Kugel "
            },
            {
              "type": "math",
              "tex": "V = \\frac{4}{3} \\cdot \\pi \\cdot r^3",
              "speech": "V gleich vier Drittel mal Pi mal r hoch drei"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "O = 4 \\cdot \\pi \\cdot r^2",
              "speech": "O gleich 4 mal Pi mal r Quadrat"
            },
            {
              "type": "text",
              "text": "; Cavalieri-Prinzip; Rechnung: "
            },
            {
              "type": "math",
              "tex": "s = \\sqrt{36 + 64} = 10\\,\\text{cm}",
              "speech": "s gleich Wurzel aus 36 plus 64, gleich 10 Zentimeter"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "V = \\frac{1}{3} \\cdot \\pi \\cdot 36 \\cdot 8 = 96\\pi\\,\\text{cm}^3 \\approx 301{,}59\\,\\text{cm}^3",
              "speech": "V gleich ein Drittel mal Pi mal 36 mal 8 gleich 96 Pi Kubikzentimeter ungefähr 301,59 Kubikzentimeter"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "M = \\pi \\cdot 6 \\cdot 10 = 60\\pi\\,\\text{cm}^2 \\approx 188{,}50\\,\\text{cm}^2",
              "speech": "M gleich Pi mal 6 mal 10 gleich 60 Pi Quadratzentimeter ungefähr 188,50 Quadratzentimeter"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Formelsammlung der Raumkörper (Stereometrie): - 1. Pyramide:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{V = \\frac{1}{3} \\cdot G \\cdot h}, \\quad \\mathbf{O = G + M}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (mit Grundfläche "
            },
            {
              "type": "math",
              "tex": "G"
            },
            {
              "type": "text",
              "text": " und Mantelfläche "
            },
            {
              "type": "math",
              "tex": "M = \\sum A_{\\triangle}"
            },
            {
              "type": "text",
              "text": "). - 2. Kreiskegel:   * Mantellinie über Pythagoras: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{s = \\sqrt{r^2 + h^2}}"
            },
            {
              "type": "text",
              "text": ".   * Volumen: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{V = \\frac{1}{3} \\pi r^2 h}"
            },
            {
              "type": "text",
              "text": ".   * Mantelfläche: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{M = \\pi \\cdot r \\cdot s}"
            },
            {
              "type": "text",
              "text": ".   * Gesamtoberfläche: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{O = G + M = \\pi r^2 + \\pi r s = \\pi r (r + s)}"
            },
            {
              "type": "text",
              "text": ". - 3. Kugel:   * Volumen: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{V = \\frac{4}{3} \\pi r^3}"
            },
            {
              "type": "text",
              "text": ".   * Oberfläche: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{O = 4 \\pi r^2}"
            },
            {
              "type": "text",
              "text": ". 2. Das Prinzip von Cavalieri (Bonaventura Cavalieri): - Liegen zwei Körper auf derselben Grundebene und haben sie die gleiche Höhe "
            },
            {
              "type": "math",
              "tex": "h"
            },
            {
              "type": "text",
              "text": ", und sind ihre Schnittflächen parallel zur Grundebene in jeder beliebigen Höhe flächengleich ("
            },
            {
              "type": "math",
              "tex": "A_1(z) = A_2(z)"
            },
            {
              "type": "text",
              "text": "), so gilt:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{V_1 = V_2}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Begründet, warum schiefe Prismen/Zylinder/Pyramiden exakt dasselbe Volumen haben wie gerade Körper derselben Höhe). 3. Durchrechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "r = 6\\,\\text{cm}, h = 8\\,\\text{cm}"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Mantellinie "
            },
            {
              "type": "math",
              "tex": "s"
            },
            {
              "type": "text",
              "text": " berechnen:   "
            },
            {
              "type": "math",
              "tex": "s = \\sqrt{r^2 + h^2} = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = \\sqrt{100} = \\mathbf{10\\,\\text{cm}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Volumen "
            },
            {
              "type": "math",
              "tex": "V"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "V = \\frac{1}{3} \\pi r^2 h = \\frac{1}{3} \\pi \\cdot 6^2 \\cdot 8 = \\frac{1}{3} \\pi \\cdot 36 \\cdot 8 = \\mathbf{96\\pi\\,\\text{cm}^3} \\approx 301{,}59\\,\\text{cm}^3",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 3: Mantelfläche "
            },
            {
              "type": "math",
              "tex": "M"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "M = \\pi \\cdot r \\cdot s = \\pi \\cdot 6 \\cdot 10 = \\mathbf{60\\pi\\,\\text{cm}^2} \\approx 188{,}50\\,\\text{cm}^2",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
