        },
        {
          "id": "01K8GB30000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die Binomialverteilung "
            },
            {
              "type": "math",
              "tex": "B(n; p)",
              "speech": "B von n und p"
            },
            {
              "type": "text",
              "text": " und ihre statistischen Kenngrößen: 1. Die Formel von Bernoulli:   * Die Zufallsgröße "
            },
            {
              "type": "math",
              "tex": "X",
              "speech": "X"
            },
            {
              "type": "text",
              "text": " zählt die Anzahl der Treffer:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P(X = k) = B(n; p; k) = \\binom{n}{k} \\cdot p^k \\cdot (1 - p)^{n - k}} \\quad (k \\in \\{0, 1, \\dots, n\\})",
              "block": true,
              "speech": "P von X gleich k gleich B von n, p, k gleich n über k mal p hoch k mal, 1 minus p, hoch n minus k, für k Element von 0, 1, bis n"
            },
            {
              "type": "text",
              "text": "   * Kumulierte Wahrscheinlichkeit ('höchstens "
            },
            {
              "type": "math",
              "tex": "k",
              "speech": "k"
            },
            {
              "type": "text",
              "text": " Treffer'):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P(X \\le k) = F(n; p; k) = \\sum_{i=0}^k \\binom{n}{i} \\cdot p^i \\cdot (1 - p)^{n - i}}",
              "block": true,
              "speech": "P von X kleiner gleich k gleich F von n, p, k gleich Summe für i gleich 0 bis k von n über i mal p hoch i mal, 1 minus p, hoch n minus i"
            },
            {
              "type": "text",
              "text": "   * 'Mindestens "
            },
            {
              "type": "math",
              "tex": "k",
              "speech": "k"
            },
            {
              "type": "text",
              "text": " Treffer': "
            },
            {
              "type": "math",
              "tex": "P(X \\ge k) = 1 - P(X \\le k - 1)",
              "speech": "P von X größer gleich k gleich 1 minus P von X kleiner gleich k minus 1"
            },
            {
              "type": "text",
              "text": ", 2. Statistische Kenngrößen einer Binomialverteilung:   * Erwartungswert "
            },
            {
              "type": "math",
              "tex": "\\mu",
              "speech": "My"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\mu = E(X) = n \\cdot p",
              "speech": "My gleich E von X gleich n mal p"
            },
            {
              "type": "text",
              "text": ".   * Varianz "
            },
            {
              "type": "math",
              "tex": "\\operatorname{Var}(X)",
              "speech": "Varianz von X"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\sigma^2 = n \\cdot p \\cdot (1 - p)",
              "speech": "Sigma Quadrat gleich n mal p mal, 1 minus p"
            },
            {
              "type": "text",
              "text": ".   * Standardabweichung "
            },
            {
              "type": "math",
              "tex": "\\sigma",
              "speech": "Sigma"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\sigma = \\sqrt{n \\cdot p \\cdot (1 - p)}",
              "speech": "Sigma gleich Wurzel aus n mal p mal, 1 minus p"
            },
            {
              "type": "text",
              "text": ", 3. Sigma-Regeln (für "
            },
            {
              "type": "math",
              "tex": "\\sigma > 3",
              "speech": "Sigma größer als 3"
            },
            {
              "type": "text",
              "text": ", Laplace-Bedingung):   * "
            },
            {
              "type": "math",
              "tex": "1\\sigma",
              "speech": "1 Sigma"
            },
            {
              "type": "text",
              "text": "-Intervall: "
            },
            {
              "type": "math",
              "tex": "P(\\mu - \\sigma \\le X \\le \\mu + \\sigma) \\approx 68{,}3\\%",
              "speech": "P von My minus Sigma kleiner gleich X kleiner gleich My plus Sigma ungefähr 68,3 Prozent"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "2\\sigma",
              "speech": "2 Sigma"
            },
            {
              "type": "text",
              "text": "-Intervall: "
            },
            {
              "type": "math",
              "tex": "P(\\mu - 2\\sigma \\le X \\le \\mu + 2\\sigma) \\approx 95{,}4\\%",
              "speech": "P von My minus 2 Sigma kleiner gleich X kleiner gleich My plus 2 Sigma ungefähr 95,4 Prozent"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "3\\sigma",
              "speech": "3 Sigma"
            },
            {
              "type": "text",
              "text": "-Intervall: "
            },
            {
              "type": "math",
              "tex": "P(\\mu - 3\\sigma \\le X \\le \\mu + 3\\sigma) \\approx 99{,}7\\%",
              "speech": "P von My minus 3 Sigma kleiner gleich X kleiner gleich My plus 3 Sigma ungefähr 99,7 Prozent"
            },
            {
              "type": "text",
              "text": ", 4. Ein Medikament heilt eine Erkrankung mit Wahrscheinlichkeit "
            },
            {
              "type": "math",
              "tex": "p = 0{,}8",
              "speech": "p gleich 0,8"
            },
            {
              "type": "text",
              "text": ". Es wird an "
            },
            {
              "type": "math",
              "tex": "n = 100",
              "speech": "n gleich 100"
            },
            {
              "type": "text",
              "text": " Patienten getestet. Berechne den Erwartungswert "
            },
            {
              "type": "math",
              "tex": "\\mu",
              "speech": "My"
            },
            {
              "type": "text",
              "text": " und die Standardabweichung "
            },
            {
              "type": "math",
              "tex": "\\sigma",
              "speech": "Sigma"
            },
            {
              "type": "text",
