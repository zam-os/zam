          "question_segments": [
            {
              "type": "text",
              "text": "Wie berechnet sich der Erwartungswert "
            },
            {
              "type": "math",
              "tex": "\\mu = E(X)",
              "speech": "My gleich E von X"
            },
            {
              "type": "text",
              "text": " einer nach "
            },
            {
              "type": "math",
              "tex": "B(n; p)",
              "speech": "B von n und p"
            },
            {
              "type": "text",
              "text": " binomialverteilten Zufallsgröße "
            },
            {
              "type": "math",
              "tex": "X",
              "speech": "X"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept": "mu = n * p (Kettenlänge multipliziert mit der Trefferwahrscheinlichkeit)",
          "fast_check": {
