              "type": "text",
              "text": " - Schlussfolgerung:   * Dies widerspricht der Pumping-Lemma-Bedingung "
            },
            {
              "type": "math",
              "tex": "x y^i z \\in L"
            },
            {
              "type": "text",
              "text": " für alle "
            },
            {
              "type": "math",
              "tex": "i"
            },
            {
              "type": "text",
              "text": ".   * Die Annahme ist falsch "
            },
            {
              "type": "math",
              "tex": "\\implies \\mathbf{L = \\{a^n b^n \\mid n \\ge 1\\} \\text{ ist NICHT regulär}}"
            },
            {
              "type": "text",
              "text": "!"
            }
