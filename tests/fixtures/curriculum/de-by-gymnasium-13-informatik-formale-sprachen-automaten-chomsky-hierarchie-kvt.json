            },
            {
              "type": "math",
              "tex": "w' = x y^2 z = a^{p-k-m} \\cdot (a^k)^2 \\cdot a^m b^p = a^{p+k} b^p",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Da "
            },
            {
              "type": "math",
              "tex": "k \\ge 1"
