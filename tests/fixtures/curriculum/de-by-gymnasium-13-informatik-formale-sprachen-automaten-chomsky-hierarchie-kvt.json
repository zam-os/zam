            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": "'s nun "
            },
            {
              "type": "math",
              "tex": "p + k > p"
            },
            {
              "type": "text",
              "text": ", während die Anzahl der "
            },
            {
              "type": "math",
              "tex": "b"
            },
            {
              "type": "text",
              "text": "'s unverändert "
            },
            {
              "type": "math",
              "tex": "p"
            },
            {
              "type": "text",
              "text": " beträgt.   * Da die Anzahl von "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": "'s und "
            },
            {
              "type": "math",
              "tex": "b"
            },
