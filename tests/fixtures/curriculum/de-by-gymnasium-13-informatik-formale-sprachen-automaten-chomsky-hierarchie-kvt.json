      "practice_items": [
        {
          "id": "01K8GD70000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Aus wie vielen formalen Komponenten besteht die mathematische Definition eines Deterministischen Endlichen Automaten (DEA) als 5-Tupel M = (Z, Sigma, delta, z_0, F)?",
          "concept": "Aus 5 Komponenten: Zustandsmenge Z, Eingabealphabet Sigma, Übergangsfunktion delta: Z x Sigma -> Z, Startzustand z_0 und Endzustandsmenge F subseteq Z",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "5 Komponenten: (Z, Sigma, delta, z_0, F)",
              "3 Komponenten: (CPU, RAM, Harddrive)"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K8GD70000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere den Deterministischen Endlichen Automaten (DEA), die Potenzmengenkonstruktion und das Pumping-Lemma: 1. Formale Definition eines DEA:   * "
            },
            {
              "type": "math",
              "tex": "M = (Z, \\Sigma, \\delta, z_0, F)",
              "speech": "M gleich das Tupel aus Z, großes Sigma, Delta, z null und F"
            },
            {
              "type": "text",
              "text": " mit:     - "
            },
            {
              "type": "math",
              "tex": "Z",
              "speech": "Z"
            },
            {
              "type": "text",
              "text": ": Endliche Menge von Zuständen.     - "
            },
            {
              "type": "math",
              "tex": "\\Sigma",
              "speech": "großes Sigma"
            },
            {
              "type": "text",
              "text": ": Endliches Eingabealphabet.     - "
            },
            {
              "type": "math",
              "tex": "\\delta: Z \\times \\Sigma \\to Z",
              "speech": "Delta bildet Z kreuz großes Sigma ab nach Z"
            },
            {
              "type": "text",
              "text": ": Deterministische Übergangsfunktion (jedes Paar aus Zustand und Zeichen führt zu genau einem Folgezustand).     - "
            },
            {
              "type": "math",
              "tex": "z_0 \\in Z",
              "speech": "z null Element von Z"
            },
            {
              "type": "text",
              "text": ": Startzustand.     - "
            },
            {
              "type": "math",
              "tex": "F \\subseteq Z",
              "speech": "F Teilmenge von Z"
            },
            {
              "type": "text",
              "text": ": Menge der akzeptierenden Endzustände.   * Wortakzeptanz: Ein Wort "
            },
            {
              "type": "math",
              "tex": "w = a_1 a_2 \\dots a_n",
              "speech": "w gleich a eins a zwei bis a n"
            },
            {
              "type": "text",
              "text": " wird akzeptiert, wenn die erweiterte Übergangsfunktion "
            },
            {
              "type": "math",
              "tex": "\\delta^*(z_0, w) \\in F",
              "speech": "Delta Stern von z null und w ist Element von F"
            },
            {
              "type": "text",
              "text": " liefert, 2. NEA und Potenzmengenkonstruktion (Rabin-Scott, Turing-Award 1976):   * Bei einem NEA kann "
            },
            {
              "type": "math",
              "tex": "\\delta(z, a)",
              "speech": "Delta von z und a"
            },
            {
              "type": "text",
              "text": " eine Menge von Folgezuständen oder "
            },
            {
              "type": "math",
              "tex": "\\varepsilon",
              "speech": "Epsilon"
            },
            {
              "type": "text",
              "text": "-Übergänge enthalten.   * Jeder NEA mit "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": " Zuständen kann äquivalent in einen DEA mit maximal "
            },
            {
              "type": "math",
              "tex": "2^n",
              "speech": "2 hoch n"
            },
            {
              "type": "text",
              "text": " Zuständen (Potenzmenge "
            },
            {
              "type": "math",
              "tex": "\\mathcal{P}(Z)",
              "speech": "Potenzmenge von Z"
            },
            {
              "type": "text",
              "text": ") transformiert werden "
            },
            {
