          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Mit welcher trigonometrischen Funktion berechnet man den Schnittwinkel "
            },
            {
              "type": "math",
              "tex": "\\beta",
              "speech": "Beta"
            },
            {
              "type": "text",
              "text": " zwischen einer Geraden mit Richtungsvektor "
            },
            {
              "type": "math",
              "tex": "\\vec{u}",
              "speech": "Vektor u"
            },
            {
              "type": "text",
              "text": " und einer Ebene mit Normalenvektor "
            },
            {
              "type": "math",
              "tex": "\\vec{n}",
              "speech": "Vektor n"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept_segments": [
            {
              "type": "math",
              "tex": "\\sin(\\beta) = \\frac{|\\vec{u} \\cdot \\vec{n}|}{|\\vec{u}| \\cdot |\\vec{n}|}",
              "speech": "Sinus von Beta gleich Betrag von Vektor u mal Vektor n durch Betrag von Vektor u mal Betrag von Vektor n"
            },
            {
              "type": "text",
              "text": " (weil der Normalenvektor senkrecht auf der Ebene steht und daher das Komplement "
            },
            {
              "type": "math",
              "tex": "90^\\circ - \\beta",
              "speech": "90 Grad minus Beta"
            },
            {
              "type": "text",
              "text": " erfasst)"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              [
                {
                  "type": "math",
                  "tex": "\\sin(\\beta) = \\frac{|\\vec{u} \\cdot \\vec{n}|}{|\\vec{u}| \\cdot |\\vec{n}|}",
                  "speech": "Sinus von Beta gleich Betrag von Vektor u mal Vektor n durch Betrag von Vektor u mal Betrag von Vektor n"
                }
              ],
              [
                {
                  "type": "math",
                  "tex": "\\cos(\\beta) = \\frac{|\\vec{u} \\cdot \\vec{n}|}{|\\vec{u}| \\cdot |\\vec{n}|}",
                  "speech": "Kosinus von Beta gleich Betrag von Vektor u mal Vektor n, durch Betrag von Vektor u, mal Betrag von Vektor n"
                }
              ]
            ],
            "correct_index": 0
          },
