        },
        {
          "id": "01K8GD10000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere metrische Abstands- und Winkelprobleme im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ": 1. Die Hessesche Normalenform (HNF):   * Gegeben Ebene "
            },
            {
              "type": "math",
              "tex": "E: n_1 x_1 + n_2 x_2 + n_3 x_3 - d = 0",
              "speech": "Ebene E: n eins x eins plus n zwei x zwei plus n drei x drei minus d gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Normierung durch Division durch den Betrag "
            },
            {
              "type": "math",
              "tex": "|\\vec{n}| = \\sqrt{n_1^2 + n_2^2 + n_3^2}",
              "speech": "Betrag von Vektor n gleich Wurzel aus n eins Quadrat plus n zwei Quadrat plus n drei Quadrat"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\text{HNF: } \\frac{n_1 x_1 + n_2 x_2 + n_3 x_3 - d}{\\sqrt{n_1^2 + n_2^2 + n_3^2}} = 0}",
              "block": true,
              "speech": "Hessesche Normalform: n eins x eins plus n zwei x zwei plus n drei x drei minus d, geteilt durch Wurzel aus n eins Quadrat plus n zwei Quadrat plus n drei Quadrat, gleich 0"
            },
            {
              "type": "text",
              "text": "   * Der Abstand eines beliebigen Punktes "
            },
            {
              "type": "math",
              "tex": "P(p_1, p_2, p_3)",
              "speech": "Punkt P mit den Koordinaten p eins, p zwei und p drei"
            },
            {
              "type": "text",
              "text": " zur Ebene "
            },
            {
              "type": "math",
              "tex": "E",
              "speech": "E"
            },
            {
              "type": "text",
              "text": " ergibt sich durch direktes Einsetzen in die linke Seite der HNF:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{d(P, E) = \\left| \\frac{n_1 p_1 + n_2 p_2 + n_3 p_3 - d}{|\\vec{n}|} \\right|}",
              "block": true,
              "speech": "d von P und E gleich Betrag von, n eins p eins plus n zwei p zwei plus n drei p drei minus d, geteilt durch Betrag von Vektor n"
            },
            {
              "type": "text",
              "text": ", 2. Abstand zweier windschiefer Geraden "
            },
            {
              "type": "math",
              "tex": "g",
              "speech": "g"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "h",
              "speech": "h"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "g: \\vec{x} = \\vec{a} + r \\vec{u}_g",
              "speech": "g: Vektor x gleich Vektor a plus r Vektor u g"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "h: \\vec{x} = \\vec{b} + s \\vec{u}_h",
              "speech": "h: Vektor x gleich Vektor b plus s Vektor u h"
            },
            {
              "type": "text",
              "text": ".   * Gemeinsamer Normalenvektor: "
            },
            {
              "type": "math",
              "tex": "\\vec{n}_0 = \\frac{\\vec{u}_g \\times \\vec{u}_h}{|\\vec{u}_g \\times \\vec{u}_h|}",
              "speech": "Vektor n null gleich Vektor u g kreuz Vektor u h, geteilt durch den Betrag von Vektor u g kreuz Vektor u h"
            },
            {
              "type": "text",
              "text": ".   * Abstand: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{d(g, h) = |(\\vec{b} - \\vec{a}) \\cdot \\vec{n}_0|}",
              "speech": "d von g und h gleich Betrag von, Vektor b minus Vektor a, mal Vektor n null"
            },
            {
              "type": "text",
              "text": ", 3. Konkrete Aufgabe:   * Gegeben Ebene "
            },
            {
              "type": "math",
              "tex": "E: 2x_1 - x_2 + 2x_3 - 9 = 0",
              "speech": "Ebene E: 2 x eins minus x zwei plus 2 x drei minus 9 gleich 0"
            },
            {
              "type": "text",
              "text": " und Punkt "
            },
            {
              "type": "math",
              "tex": "P(5 \\mid 4 \\mid 8)",
              "speech": "Punkt P mit den Koordinaten 5, 4 und 8"
            },
            {
              "type": "text",
              "text": ".   * a) Bestimme den Abstand "
            },
            {
              "type": "math",
              "tex": "d(P, E)",
              "speech": "d von P und E"
            },
            {
              "type": "text",
              "text": ".   * b) Berechne den Lotfußpunkt "
            },
            {
              "type": "math",
              "tex": "F",
              "speech": "F"
            },
            {
              "type": "text",
              "text": " des Punktes "
            },
            {
              "type": "math",
              "tex": "P",
              "speech": "P"
            },
            {
              "type": "text",
              "text": " auf der Ebene "
            },
            {
              "type": "math",
              "tex": "E",
              "speech": "E"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept": "HNF & Abstände 13: |n| = sqrt(4+1+4) = 3; HNF (2x1 - x2 + 2x3 - 9)/3 = 0; d(P, E) = |2(5) - 4 + 2(8) - 9|/3 = |10 - 4 + 16 - 9|/3 = |13|/3 = 13/3 LE; Lotfußpunkt F = P - d * n_0 = (5, 4, 8) - 13/3 * 1/3(2, -1, 2) = (19/9, 49/9, 46/9).",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Metrische Beziehungen im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3"
            },
            {
              "type": "text",
              "text": ": - Winkelformeln:   * Gerade-Gerade: "
            },
            {
              "type": "math",
              "tex": "\\cos(\\alpha) = \\frac{|\\vec{u}_1 \\cdot \\vec{u}_2|}{|\\vec{u}_1| \\cdot |\\vec{u}_2|}"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "0^\\circ \\le \\alpha \\le 90^\\circ"
            },
            {
              "type": "text",
              "text": ").   * Ebene-Ebene: "
            },
            {
              "type": "math",
              "tex": "\\cos(\\gamma) = \\frac{|\\vec{n}_1 \\cdot \\vec{n}_2|}{|\\vec{n}_1| \\cdot |\\vec{n}_2|}"
            },
            {
              "type": "text",
              "text": ".   * Gerade-Ebene: "
            },
            {
              "type": "math",
              "tex": "\\sin(\\beta) = \\frac{|\\vec{u} \\cdot \\vec{n}|}{|\\vec{u}| \\cdot |\\vec{n}|}"
            },
            {
              "type": "text",
              "text": ". 2. Vollständige Berechnung der Aufgabe: - a) HNF und Abstand des Punktes "
            },
            {
              "type": "math",
              "tex": "P(5 \\mid 4 \\mid 8)"
            },
            {
              "type": "text",
              "text": ":   * Ebenengleichung: "
            },
            {
              "type": "math",
              "tex": "2x_1 - x_2 + 2x_3 - 9 = 0"
            },
            {
              "type": "text",
              "text": ".   * Normalenvektor: "
            },
            {
              "type": "math",
              "tex": "\\vec{n} = \\begin{pmatrix} 2 \\\\ -1 \\\\ 2 \\end{pmatrix}"
            },
            {
              "type": "text",
              "text": ".   * Betrag: "
            },
            {
              "type": "math",
              "tex": "|\\vec{n}| = \\sqrt{2^2 + (-1)^2 + 2^2} = \\sqrt{4 + 1 + 4} = \\sqrt{9} = \\mathbf{3}"
            },
            {
              "type": "text",
              "text": ".   * HNF der Ebene "
            },
            {
              "type": "math",
              "tex": "E"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\frac{2x_1 - x_2 + 2x_3 - 9}{3} = 0",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Abstand "
            },
            {
              "type": "math",
              "tex": "d(P, E)"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "d(P, E) = \\left| \\frac{2(5) - (4) + 2(8) - 9}{3} \\right| = \\left| \\frac{10 - 4 + 16 - 9}{3} \\right| = \\left| \\frac{13}{3} \\right| = \\mathbf{\\frac{13}{3}\\,\\text{Längeneinheiten (LE)} \\approx 4{,}33\\,\\text{LE}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - b) Bestimmung des Lotfußpunktes "
            },
            {
              "type": "math",
              "tex": "F"
            },
            {
              "type": "text",
              "text": ":   * Die Lotgerade "
            },
            {
              "type": "math",
              "tex": "\\ell"
            },
            {
              "type": "text",
              "text": " geht durch "
            },
            {
              "type": "math",
              "tex": "P"
            },
            {
              "type": "text",
              "text": " mit Richtungsvektor "
            },
            {
              "type": "math",
              "tex": "\\vec{n}"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\ell: \\vec{x} = \\begin{pmatrix} 5 \\\\ 4 \\\\ 8 \\end{pmatrix} + t \\begin{pmatrix} 2 \\\\ -1 \\\\ 2 \\end{pmatrix}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Schneiden von "
            },
            {
              "type": "math",
              "tex": "\\ell"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "E"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "2(5 + 2t) - (4 - t) + 2(8 + 2t) - 9 = 0",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "10 + 4t - 4 + t + 16 + 4t - 9 = 0",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "9t + 13 = 0 \\implies \\mathbf{t = -\\frac{13}{9}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Einsetzen von "
            },
            {
              "type": "math",
              "tex": "t"
            },
            {
              "type": "text",
              "text": " in die Geradengleichung:     "
            },
            {
              "type": "math",
              "tex": "\\vec{f} = \\begin{pmatrix} 5 \\\\ 4 \\\\ 8 \\end{pmatrix} - \\frac{13}{9} \\begin{pmatrix} 2 \\\\ -1 \\\\ 2 \\end{pmatrix} = \\begin{pmatrix} 5 - \\frac{26}{9} \\\\[4pt] 4 + \\frac{13}{9} \\\\[4pt] 8 - \\frac{26}{9} \\end{pmatrix} = \\begin{pmatrix} \\frac{19}{9} \\\\[4pt] \\frac{49}{9} \\\\[4pt] \\frac{46}{9} \\end{pmatrix}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{F\\left( \\frac{19}{9} \\;\\middle|\\; \\frac{49}{9} \\;\\middle|\\; \\frac{46}{9} \\right)}",
              "block": true
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
