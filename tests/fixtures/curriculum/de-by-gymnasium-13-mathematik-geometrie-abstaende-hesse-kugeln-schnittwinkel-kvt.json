      "practice_items": [
        {
          "id": "01K8GD10000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Wie berechnet man den Radius r_k des Schnittkreises, der entsteht, wenn eine Ebene im Abstand d < r eine Kugel mit Mittelpunkt M und Kugelradius r schneidet?",
          "concept_segments": [
            {
              "type": "math",
              "tex": "r_k = \\sqrt{r^2 - d^2}",
              "speech": "r k gleich Wurzel aus r Quadrat minus d Quadrat"
            },
            {
              "type": "text",
              "text": " (nach dem Satz des Pythagoras am rechtwinkligen Dreieck aus Kugelmittelpunkt, Kreismittelpunkt und Kreisrand)"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              [
                {
                  "type": "math",
                  "tex": "r_k = \\sqrt{r^2 - d^2}",
                  "speech": "r k gleich Wurzel aus r Quadrat minus d Quadrat"
                }
              ],
              "r_k = r - d"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GD10000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Kugelgleichungen und Schnittbeziehungen zwischen Kugel und Ebene: 1. Kugelgleichung im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ":   * Vektorielle Form: "
            },
            {
              "type": "math",
              "tex": "(\\vec{x} - \\vec{m})^2 = r^2",
              "speech": "Klammer auf Vektor x minus Vektor m Klammer zu Quadrat gleich r Quadrat"
            },
            {
              "type": "text",
              "text": ".   * Koordinatenform: "
            },
            {
              "type": "math",
              "tex": "(x_1 - m_1)^2 + (x_2 - m_2)^2 + (x_3 - m_3)^2 = r^2",
              "speech": "Klammer auf x eins minus m eins Klammer zu Quadrat plus Klammer auf x zwei minus m zwei Klammer zu Quadrat plus Klammer auf x drei minus m drei Klammer zu Quadrat gleich r Quadrat"
            },
            {
              "type": "text",
              "text": ", 2. Lagebeziehung Kugel "
            },
            {
              "type": "math",
              "tex": "K(M; r)",
              "speech": "K von M und r"
            },
            {
              "type": "text",
              "text": " und Ebene "
            },
            {
              "type": "math",
              "tex": "E",
              "speech": "E"
            },
            {
              "type": "text",
              "text": ":   * Bestimme den Abstand "
            },
            {
              "type": "math",
              "tex": "d = d(M, E)",
              "speech": "d gleich d von M und E"
            },
            {
              "type": "text",
              "text": " des Kugelmittelpunkts "
            },
            {
              "type": "math",
              "tex": "M",
              "speech": "M"
            },
            {
              "type": "text",
              "text": " zur Ebene "
            },
            {
              "type": "math",
              "tex": "E",
              "speech": "E"
            },
            {
              "type": "text",
              "text": ":     - "
            },
            {
              "type": "math",
              "tex": "d > r",
              "speech": "d größer als r"
            },
            {
              "type": "text",
              "text": " (Passantenebene): Kein Schnittpunkt ("
            },
            {
