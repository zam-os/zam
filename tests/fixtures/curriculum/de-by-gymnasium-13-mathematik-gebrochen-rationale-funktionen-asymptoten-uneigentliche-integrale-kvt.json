      "practice_items": [
        {
          "id": "01K8GD00000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Wann besitzt eine gebrochen-rationale Funktion f(x) = Z(x)/N(x) für x -> +-unendlich eine schiefe/schräge Asymptote y = m*x + t (mit m != 0)?",
          "concept": "Genau dann, wenn der Zählergrad um genau 1 größer ist als der Nennergrad (Grad(Z) = Grad(N) + 1)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Wenn der Zählergrad genau um 1 größer ist als der Nennergrad",
              "Wenn der Nennergrad größer als der Zählergrad ist"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K8GD00000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere gebrochen-rationale Funktionen und führe eine vollständige Asymptotenbestimmung durch: 1. Klassifikation der Definitionslücken bei "
            },
            {
              "type": "math",
              "tex": "f(x) = \\frac{Z(x)}{N(x)}",
              "speech": "f von x gleich Z von x durch N von x"
            },
            {
              "type": "text",
              "text": ":   * Hebbare Definitionslücke bei "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": ": Wenn "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": " Nullstelle von Zähler und Nenner mit gleicher oder höherer Vielfachheit im Zähler ist "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " der Faktor "
            },
            {
              "type": "math",
              "tex": "(x - x_0)",
              "speech": "x minus x null"
            },
            {
              "type": "text",
              "text": " lässt sich vollständig herauskürzen; der Grenzwert "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to x_0} f(x) = y_0",
              "speech": "Limes für x gegen x null f von x gleich y null"
            },
            {
              "type": "text",
              "text": " existiert.   * Polstelle (senkrechte Asymptote) bei "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": ": Wenn nach dem Kürzen eine Nennernullstelle verbleibt "
            },
            {
              "type": "math",
              "tex": "\\implies \\lim_{x \\to x_0} f(x) = \\pm \\infty",
              "speech": "daraus folgt Limes für x gegen x null f von x gleich plus minus unendlich"
            },
            {
              "type": "text",
              "text": " (mit VZW bei ungerader Polstellen-Ordnung, ohne VZW bei gerader Ordnung), 2. Grenzverhalten im Unendlichen:   * "
            },
            {
              "type": "math",
              "tex": "\\operatorname{Grad}(Z) < \\operatorname{Grad}(N) \\implies",
              "speech": "Grad von Z kleiner als Grad von N, daraus folgt"
            },
            {
              "type": "text",
              "text": " waagrechte Asymptote "
            },
            {
              "type": "math",
              "tex": "y = 0",
              "speech": "y gleich 0"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "\\operatorname{Grad}(Z) = \\operatorname{Grad}(N) \\implies",
              "speech": "Grad von Z gleich Grad von N, daraus folgt"
            },
            {
              "type": "text",
              "text": " waagrechte Asymptote "
            },
            {
              "type": "math",
              "tex": "y = \\frac{a_n}{b_n}",
              "speech": "y gleich a n durch b n"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "\\operatorname{Grad}(Z) = \\operatorname{Grad}(N) + 1 \\implies",
              "speech": "Grad von Z gleich Grad von N plus 1, daraus folgt"
            },
            {
              "type": "text",
              "text": " schiefe Asymptote "
            },
            {
              "type": "math",
              "tex": "y = m x + t",
              "speech": "y gleich m x plus t"
            },
            {
              "type": "text",
              "text": " durch Polynomdivision "
            },
            {
              "type": "math",
              "tex": "f(x) = m x + t + \\frac{R(x)}{N(x)}",
              "speech": "f von x gleich m x plus t plus R von x durch N von x"
            },
            {
              "type": "text",
              "text": ", 3. Konkrete Aufgabe:   * Gegeben ist die Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = \\frac{2x^3 - 4x^2 - 2x + 4}{x^2 - 1}",
              "speech": "f von x gleich Bruch: 2 x hoch drei minus 4 x Quadrat minus 2 x plus 4, durch x Quadrat minus 1"
            },
            {
              "type": "text",
              "text": ".   * a) Bestimme die maximale Definitionsmenge "
            },
            {
              "type": "math",
              "tex": "D_f",
              "speech": "D f"
            },
            {
              "type": "text",
              "text": ".   * b) Untersuche alle Definitionslücken auf hebbare Lücken bzw. Polstellen.   * c) Bestimme die Gleichung der schiefen Asymptote "
            },
            {
              "type": "math",
              "tex": "y = m x + t",
              "speech": "y gleich m x plus t"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept": "Gebrochen-rationale Funktionen 13: D_f = R \\ {-1, 1}; Faktorisierung Zähler 2(x-1)(x+1)(x-2) -> hebbare Lücken bei x = 1 und x = -1; gekürzte Funktion f(x) = 2x - 4 (Gerade mit zwei Löchern); schiefe Asymptote y = 2x - 4.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Theorie gebrochen-rationaler Funktionen: - Eine gebrochen-rationale Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = \\frac{Z(x)}{N(x)}"
            },
            {
              "type": "text",
              "text": " ist überall dort definiert, wo "
            },
            {
              "type": "math",
              "tex": "N(x) \\neq 0"
            },
            {
              "type": "text",
              "text": ". - Verhalten an den Lücken:   * Lässt sich der Linearfaktor "
            },
            {
              "type": "math",
              "tex": "(x - x_0)"
            },
            {
              "type": "text",
              "text": " durch Kürzen restlos aus dem Nenner entfernen, liegt eine hebbare Lücke vor. Der Graph hat dort ein punktförmiges 'Loch' bei "
            },
            {
              "type": "math",
              "tex": "(x_0 \\mid y_0)"
            },
            {
              "type": "text",
              "text": ".   * Bleibt "
            },
            {
              "type": "math",
              "tex": "(x - x_0)^k"
            },
            {
              "type": "text",
              "text": " im Nenner stehen, ist "
            },
            {
              "type": "math",
              "tex": "x_0"
            },
            {
              "type": "text",
              "text": " eine Polstelle "
            },
            {
              "type": "math",
              "tex": "k"
            },
            {
              "type": "text",
              "text": "-ter Ordnung mit senkrechter Asymptote "
            },
            {
              "type": "math",
              "tex": "x = x_0"
            },
            {
              "type": "text",
              "text": ". 2. Vollständige Bearbeitung der Aufgabe: - a) Definitionsbereich "
            },
            {
              "type": "math",
              "tex": "D_f"
            },
            {
              "type": "text",
              "text": ":   * Nennernullstellen: "
            },
            {
              "type": "math",
              "tex": "x^2 - 1 = 0 \\implies x_1 = 1, \\; x_2 = -1"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{D_f = \\mathbb{R} \\setminus \\{-1; 1\\}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - b) Untersuchung der Definitionslücken:   * Wir faktorisieren Zähler und Nenner:     - Nenner: "
            },
            {
              "type": "math",
              "tex": "N(x) = (x - 1)(x + 1)"
            },
            {
              "type": "text",
              "text": ".     - Zähler: "
            },
            {
              "type": "math",
              "tex": "Z(x) = 2x^3 - 4x^2 - 2x + 4 = 2x^2(x - 2) - 2(x - 2) = 2(x^2 - 1)(x - 2) = 2(x - 1)(x + 1)(x - 2)"
            },
            {
              "type": "text",
              "text": ".   * Kürzen für alle "
            },
            {
              "type": "math",
              "tex": "x \\in D_f"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "f(x) = \\frac{2(x - 1)(x + 1)(x - 2)}{(x - 1)(x + 1)} = \\mathbf{2x - 4}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Ergebnis: Sowohl "
            },
            {
              "type": "math",
              "tex": "x = 1"
            },
            {
              "type": "text",
              "text": " als auch "
            },
            {
              "type": "math",
              "tex": "x = -1"
            },
            {
              "type": "text",
              "text": " sind hebbare Definitionslücken (keine Polstellen!).     - Lücke 1: "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to 1} f(x) = 2(1) - 4 = -2 \\implies \\mathbf{L_1(1 \\mid -2)}"
            },
            {
              "type": "text",
              "text": ".     - Lücke 2: "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to -1} f(x) = 2(-1) - 4 = -6 \\implies \\mathbf{L_2(-1 \\mid -6)}"
            },
            {
              "type": "text",
              "text": ". - c) Asymptote für "
            },
            {
              "type": "math",
              "tex": "x \\to \\pm \\infty"
            },
            {
              "type": "text",
              "text": ":   * Da die gekürzte Funktion exakt mit der linearen Geradengleichung "
            },
            {
              "type": "math",
              "tex": "y = 2x - 4"
            },
            {
              "type": "text",
              "text": " übereinstimmt, ist die schiefe Asymptote identisch mit der Geraden:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{y = 2x - 4}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Der Graph von "
            },
            {
              "type": "math",
              "tex": "f"
            },
            {
              "type": "text",
              "text": " ist eine Gerade mit Steigung "
            },
            {
              "type": "math",
              "tex": "m = 2"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achsenabschnitt "
            },
            {
              "type": "math",
              "tex": "t = -4"
            },
            {
              "type": "text",
              "text": ", die an den Stellen "
            },
            {
              "type": "math",
              "tex": "x = 1"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "x = -1"
            },
            {
              "type": "text",
              "text": " zwei punktförmige Löcher besitzt)."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
