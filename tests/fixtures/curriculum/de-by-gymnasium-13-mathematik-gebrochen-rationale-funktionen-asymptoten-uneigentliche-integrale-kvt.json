            },
            {
              "type": "text",
              "text": ", auf der alle Extrempunkte sämtlicher Kurven der Schar liegen. 2. Berechnung des uneigentlichen Integrals: - Schritt 1: Partielle Integration von "
            },
            {
              "type": "math",
              "tex": "\\int x \\cdot e^{-2x}\\,dx"
            },
            {
              "type": "text",
              "text": ":   * Formel: "
            },
            {
              "type": "math",
              "tex": "\\int u(x) \\cdot v'(x)\\,dx = u(x) \\cdot v(x) - \\int u'(x) \\cdot v(x)\\,dx"
            },
            {
              "type": "text",
              "text": ".   * Wähle: "
            },
            {
              "type": "math",
              "tex": "u(x) = x \\implies u'(x) = 1"
            },
            {
              "type": "text",
              "text": ".   * Wähle: "
            },
            {
              "type": "math",
              "tex": "v'(x) = e^{-2x} \\implies v(x) = -\\frac{1}{2} e^{-2x}"
            },
            {
              "type": "text",
              "text": ".   * Einsetzen:     "
            },
            {
              "type": "math",
              "tex": "\\int x \\cdot e^{-2x}\\,dx = -\\frac{1}{2} x \\cdot e^{-2x} - \\int 1 \\cdot \\left(-\\frac{1}{2} e^{-2x}\\right) dx",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "= -\\frac{1}{2} x \\cdot e^{-2x} + \\frac{1}{2} \\int e^{-2x}\\,dx",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "= -\\frac{1}{2} x \\cdot e^{-2x} - \\frac{1}{4} e^{-2x} + C = \\mathbf{-e^{-2x} \\left( \\frac{1}{2}x + \\frac{1}{4} \\right) + C}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Bestimmtes Integral mit oberer variabler Grenze "
            },
            {
              "type": "math",
              "tex": "u > 0"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "I(u) = \\int_{0}^{u} x \\cdot e^{-2x}\\,dx = \\left[ -e^{-2x} \\left( \\frac{1}{2}x + \\frac{1}{4} \\right) \\right]_0^u",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "I(u) = \\left( -e^{-2u} \\left( \\frac{1}{2}u + \\frac{1}{4} \\right) \\right) - \\left( -e^{0} \\left( 0 + \\frac{1}{4} \\right) \\right)",
              "block": true
            },
