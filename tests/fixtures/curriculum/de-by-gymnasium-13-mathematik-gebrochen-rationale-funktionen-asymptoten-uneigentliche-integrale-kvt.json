      "practice_items": [
        {
          "id": "01K8GD00000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Für welche reellen Exponenten "
            },
            {
              "type": "math",
              "tex": "p",
              "speech": "p"
            },
            {
              "type": "text",
              "text": " konvergiert das uneigentliche Integral "
            },
            {
              "type": "math",
              "tex": "\\int_{1}^{\\infty} \\frac{1}{x^p} \\, dx",
              "speech": "Integral von 1 bis unendlich über 1 durch x hoch p d x"
            },
            {
              "type": "text",
              "text": " gegen einen endlichen Flächeninhalt?"
            }
          ],
          "concept": "Für alle p > 1 (für p <= 1 divergiert das Integral gegen unendlich)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Für alle p > 1",
              "Für alle p < 1"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GD00000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Kurvenscharen, Ortskurven und berechne uneigentliche Integrale: 1. Bestimmung von Ortskurven für Scharen "
            },
            {
              "type": "math",
              "tex": "f_k(x)",
              "speech": "f k von x"
            },
            {
              "type": "text",
              "text": ":   * Bestimme die Koordinaten des charakteristischen Punktes in Abhängigkeit von "
            },
            {
              "type": "math",
              "tex": "k",
              "speech": "k"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "x = x(k)",
              "speech": "x gleich x von k"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "y = y(k)",
              "speech": "y gleich y von k"
            },
            {
              "type": "text",
              "text": ".   * Löse die Gleichung "
            },
            {
              "type": "math",
              "tex": "x = x(k)",
              "speech": "x gleich x von k"
            },
            {
              "type": "text",
              "text": " nach dem Parameter "
            },
            {
              "type": "math",
              "tex": "k",
              "speech": "k"
            },
            {
              "type": "text",
              "text": " auf: "
            },
            {
              "type": "math",
              "tex": "k = g(x)",
              "speech": "k gleich g von x"
            },
            {
              "type": "text",
              "text": ".   * Setze "
            },
            {
              "type": "math",
              "tex": "k = g(x)",
              "speech": "k gleich g von x"
            },
            {
              "type": "text",
              "text": " in die "
            },
            {
              "type": "math",
              "tex": "y",
              "speech": "y"
            },
            {
              "type": "text",
              "text": "-Gleichung ein "
            },
            {
              "type": "math",
              "tex": "\\implies \\mathbf{y = y(g(x))}",
              "speech": "daraus folgt y gleich y von g von x"
            },
            {
              "type": "text",
              "text": " (Gleichung der Ortskurve), 2. Definition des Uneigentlichen Integrals:   * 1. Art (unbeschränkte Grenze): "
            },
            {
              "type": "math",
              "tex": "\\int_{a}^{\\infty} f(x)\\,dx = \\lim_{u \\to \\infty} \\int_{a}^{u} f(x)\\,dx",
              "speech": "Integral von a bis unendlich über f von x d x gleich Limes für u gegen unendlich Integral von a bis u über f von x d x"
            },
            {
              "type": "text",
              "text": ".   * 2. Art (unbeschränkter Integrand bei "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "\\int_{x_0}^{b} f(x)\\,dx = \\lim_{u \\to x_0^+} \\int_{u}^{b} f(x)\\,dx",
              "speech": "Integral von x null bis b über f von x d x gleich Limes für u gegen x null von rechts, Integral von u bis b über f von x d x"
            },
            {
              "type": "text",
              "text": ".   * Wenn der Grenzwert existiert und endlich ist, nennt man das Integral konvergent, andernfalls divergent, 3. Berechnungsaufgabe:   * Gegeben ist die Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = x \\cdot e^{-2x}",
              "speech": "f von x gleich x mal e hoch minus 2 x"
            },
            {
              "type": "text",
              "text": " für "
            },
            {
              "type": "math",
              "tex": "x \\ge 0",
              "speech": "x größer gleich 0"
            },
            {
              "type": "text",
              "text": ".   * a) Bestimme das unbestimmte Integral "
            },
            {
              "type": "math",
              "tex": "\\int x \\cdot e^{-2x}\\,dx",
              "speech": "Integral über x mal e hoch minus 2 x d x"
            },
            {
              "type": "text",
              "text": " mittels partieller Integration.   * b) Berechne den Flächeninhalt "
            },
            {
              "type": "math",
              "tex": "A = \\int_{0}^{\\infty} x \\cdot e^{-2x}\\,dx",
              "speech": "A gleich Integral von 0 bis unendlich über x mal e hoch minus 2 x d x"
            },
            {
              "type": "text",
              "text": ", den der Graph von "
            },
            {
              "type": "math",
              "tex": "f",
              "speech": "f"
            },
            {
              "type": "text",
              "text": " mit der positiven "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse vollständig einschließt."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Ortskurven & Uneigentliche Integrale 13: Partielle Integration "
            },
            {
              "type": "math",
              "tex": "\\int x \\cdot e^{-2x}\\,dx = -\\frac{1}{2} x e^{-2x} - \\frac{1}{4} e^{-2x}",
              "speech": "Integral über x mal e hoch minus 2 x d x gleich minus ein halb x e hoch minus 2 x minus ein Viertel e hoch minus 2 x"
            },
            {
