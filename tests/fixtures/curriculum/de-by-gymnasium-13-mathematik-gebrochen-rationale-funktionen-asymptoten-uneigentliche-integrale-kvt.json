              "tex": "\\lim_{u \\to \\infty} \\frac{\\frac{1}{2}u + \\frac{1}{4}}{e^{2u}} = \\lim_{u \\to \\infty} \\frac{\\frac{1}{2}}{2e^{2u}} = 0",
              "block": true
            },
