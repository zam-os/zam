      "practice_items": [
        {
          "id": "01K8GB20000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie stehen die beiden Richtungsvektoren "
            },
            {
              "type": "math",
              "tex": "\\vec{u}",
              "speech": "Vektor u"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{v}",
              "speech": "Vektor v"
            },
            {
              "type": "text",
              "text": " einer Ebene zum resultierenden Vektor ihres Kreuzprodukts (Vektorprodukts) "
            },
            {
              "type": "math",
              "tex": "\\vec{n} = \\vec{u} \\times \\vec{v}",
              "speech": "Vektor n gleich Vektor u kreuz Vektor v"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept": "Der Normalenvektor n steht orthogonal (senkrecht) auf beiden Richtungsvektoren u und v (und damit senkrecht auf der gesamten Ebene)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Der Normalenvektor steht senkrecht auf beiden Richtungsvektoren",
              "Der Normalenvektor verläuft parallel zu beiden Vektoren"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GB20000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die drei Darstellungsformen einer Ebene und das Kreuzprodukt im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ": 1. Die drei Darstellungsformen einer Ebene:   * 1. Parameterform: "
            },
            {
              "type": "math",
              "tex": "E: \\vec{X} = \\vec{A} + r \\cdot \\vec{u} + s \\cdot \\vec{v}",
              "speech": "Ebene E: Vektor X gleich Vektor A plus r mal Vektor u plus s mal Vektor v"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "r, s \\in \\mathbb{R}",
              "speech": "r, s Element der reellen Zahlen"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "\\vec{u} \\not\\parallel \\vec{v}",
              "speech": "Vektor u nicht parallel zu Vektor v"
            },
            {
              "type": "text",
              "text": ").   * 2. Normalenform: "
            },
            {
              "type": "math",
              "tex": "E: (\\vec{X} - \\vec{A}) \\circ \\vec{n} = 0",
              "speech": "Ebene E: Klammer auf Vektor X minus Vektor A Klammer zu mal Vektor n gleich 0"
            },
            {
              "type": "text",
              "text": " (mit Normalenvektor "
            },
            {
              "type": "math",
              "tex": "\\vec{n} \\perp E",
              "speech": "Vektor n senkrecht zu E"
            },
            {
              "type": "text",
              "text": ").   * 3. Koordinatenform (Kartesische Form): "
            },
            {
              "type": "math",
              "tex": "E: n_1 x_1 + n_2 x_2 + n_3 x_3 = d",
              "speech": "Ebene E: n eins x eins plus n zwei x zwei plus n drei x drei gleich d"
            },
            {
              "type": "text",
              "text": " (mit "
            },
            {
              "type": "math",
              "tex": "d = \\vec{A} \\circ \\vec{n}",
              "speech": "d gleich Vektor A mal Vektor n"
            },
            {
              "type": "text",
              "text": "), 2. Das Vektorprodukt (Kreuzprodukt):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{u} \\times \\vec{v} = \\begin{pmatrix} u_1 \\\\ u_2 \\\\ u_3 \\end{pmatrix} \\times \\begin{pmatrix} v_1 \\\\ v_2 \\\\ v_3 \\end{pmatrix} = \\begin{pmatrix} u_2 v_3 - u_3 v_2 \\\\ u_3 v_1 - u_1 v_3 \\\\ u_1 v_2 - u_2 v_1 \\end{pmatrix}}",
              "block": true,
              "speech": "Vektor u kreuz Vektor v gleich Vektor u eins, u zwei, u drei kreuz Vektor v eins, v zwei, v drei gleich Vektor u zwei v drei minus u drei v zwei, u drei v eins minus u eins v drei, u eins v zwei minus u zwei v eins"
            },
            {
              "type": "text",
              "text": "   * Geometrische Bedeutung des Betrags: "
            },
            {
              "type": "math",
              "tex": "|\\vec{u} \\times \\vec{v}|",
              "speech": "Betrag von Vektor u kreuz Vektor v"
            },
            {
              "type": "text",
              "text": " ist exakt die Fläche des von "
            },
            {
              "type": "math",
              "tex": "\\vec{u}",
              "speech": "Vektor u"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{v}",
              "speech": "Vektor v"
            },
            {
              "type": "text",
              "text": " aufgespannten Parallelogramms, 3. Wandle die Ebene "
            },
            {
              "type": "math",
              "tex": "E: \\vec{X} = \\begin{pmatrix} 1 \\\\ 2 \\\\ 0 \\end{pmatrix} + r \\begin{pmatrix} 1 \\\\ 0 \\\\ 2 \\end{pmatrix} + s \\begin{pmatrix} 0 \\\\ 1 \\\\ -1 \\end{pmatrix}",
              "speech": "Ebene E: Vektor X gleich Spaltenvektor 1, 2, 0 plus r mal Spaltenvektor 1, 0, 2 plus s mal Spaltenvektor 0, 1, minus 1"
            },
            {
              "type": "text",
              "text": " in die Koordinatenform um."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Ebenen: Parameterform, Normalenform, Koordinatenform; Kreuzprodukt "
            },
            {
              "type": "math",
              "tex": "\\vec{n} = \\vec{u} \\times \\vec{v}",
              "speech": "Vektor n gleich Vektor u kreuz Vektor v"
            },
            {
              "type": "text",
              "text": "; Umwandlung: "
            },
            {
              "type": "math",
              "tex": "\\vec{n} = (1, 0, 2)^T \\times (0, 1, -1)^T = (0 - 2, 0 - (-1), 1 - 0)^T = (-2, 1, 1)^T",
              "speech": "Vektor n gleich Spaltenvektor 1, 0, 2 kreuz Spaltenvektor 0, 1, minus 1, gleich Spaltenvektor 0 minus 2, 0 minus minus 1, 1 minus 0, gleich Spaltenvektor minus 2, 1, 1"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "d = \\vec{A} \\cdot \\vec{n} = 1 \\cdot (-2) + 2 \\cdot 1 + 0 \\cdot 1 = 0 \\Rightarrow E: -2x_1 + x_2 + x_3 = 0",
              "speech": "d gleich Vektor A mal Vektor n gleich 1 mal minus 2 plus 2 mal 1 plus 0 mal 1 gleich 0, daraus folgt Ebene E: minus 2 x eins plus x zwei plus x drei gleich 0"
            },
            {
              "type": "text",
              "text": " (bzw. "
            },
            {
              "type": "math",
              "tex": "2x_1 - x_2 - x_3 = 0",
              "speech": "2 x eins minus x zwei minus x drei gleich 0"
            },
            {
              "type": "text",
              "text": ")."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Die drei mathematischen Darstellungsformen einer Ebene: - 1. Parameterform:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E: \\vec{x} = \\vec{a} + r \\cdot \\vec{u} + s \\cdot \\vec{v}} \\quad (r, s \\in \\mathbb{R})",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\vec{a}"
            },
            {
              "type": "text",
              "text": ": Stützvektor; "
            },
            {
              "type": "math",
              "tex": "\\vec{u}, \\vec{v}"
            },
            {
              "type": "text",
              "text": ": linear unabhängige Spannvektoren. - 2. Normalenform:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E: (\\vec{x} - \\vec{a}) \\circ \\vec{n} = 0}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\vec{n} \\neq \\vec{0}"
            },
            {
              "type": "text",
              "text": ": Ein Vektor, der senkrecht auf der Ebene steht (Normalenvektor). - 3. Koordinatenform (Kartesische Ebenengleichung):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E: n_1 x_1 + n_2 x_2 + n_3 x_3 = d} \\quad \\text{mit} \\quad d = \\vec{a} \\circ \\vec{n}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Das Kreuzprodukt (Vektorprodukt): - Berechnet aus zwei linear unabhängigen Vektoren "
            },
            {
              "type": "math",
              "tex": "\\vec{u}"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{v}"
            },
            {
              "type": "text",
              "text": " einen neuen Vektor "
            },
            {
              "type": "math",
              "tex": "\\vec{n}"
            },
            {
              "type": "text",
              "text": ", der auf beiden senkrecht steht (Rechte-Hand-Regel):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{n} = \\begin{pmatrix} u_1 \\\\ u_2 \\\\ u_3 \\end{pmatrix} \\times \\begin{pmatrix} v_1 \\\\ v_2 \\\\ v_3 \\end{pmatrix} = \\begin{pmatrix} u_2 v_3 - u_3 v_2 \\\\ u_3 v_1 - u_1 v_3 \\\\ u_1 v_2 - u_2 v_1 \\end{pmatrix}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Flächeninhalt:   * Fläche des aufgespannten Parallelogramms: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A_{\\text{Parallelogramm}} = |\\vec{u} \\times \\vec{v}|}"
            },
            {
              "type": "text",
              "text": ".   * Dreiecksfläche: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A_{\\text{Dreieck}} = \\frac{1}{2} |\\vec{u} \\times \\vec{v}|}"
            },
            {
              "type": "text",
              "text": ". 3. Durchrechnung der Ebenenumwandlung: - Gegeben: "
            },
            {
              "type": "math",
              "tex": "\\vec{a} = \\begin{pmatrix} 1 \\\\ 2 \\\\ 0 \\end{pmatrix}, \\; \\vec{u} = \\begin{pmatrix} 1 \\\\ 0 \\\\ 2 \\end{pmatrix}, \\; \\vec{v} = \\begin{pmatrix} 0 \\\\ 1 \\\\ -1 \\end{pmatrix}"
            },
            {
              "type": "text",
              "text": " - Schritt 1: Kreuzprodukt zur Bestimmung von "
            },
            {
              "type": "math",
              "tex": "\\vec{n}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\vec{n} = \\begin{pmatrix} 1 \\\\ 0 \\\\ 2 \\end{pmatrix} \\times \\begin{pmatrix} 0 \\\\ 1 \\\\ -1 \\end{pmatrix} = \\begin{pmatrix} 0 \\cdot (-1) - 2 \\cdot 1 \\\\ 2 \\cdot 0 - 1 \\cdot (-1) \\\\ 1 \\cdot 1 - 0 \\cdot 0 \\end{pmatrix} = \\mathbf{\\begin{pmatrix} -2 \\\\ 1 \\\\ 1 \\end{pmatrix}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Bestimmung der Konstanten "
            },
            {
              "type": "math",
              "tex": "d = \\vec{a} \\circ \\vec{n}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "d = \\begin{pmatrix} 1 \\\\ 2 \\\\ 0 \\end{pmatrix} \\circ \\begin{pmatrix} -2 \\\\ 1 \\\\ 1 \\end{pmatrix} = 1 \\cdot (-2) + 2 \\cdot 1 + 0 \\cdot 1 = -2 + 2 + 0 = \\mathbf{0}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 3: Aufstellen der Koordinatenform:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E: -2x_1 + x_2 + x_3 = 0} \\quad \\text{bzw.} \\quad \\mathbf{E: 2x_1 - x_2 - x_3 = 0}",
              "block": true
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
    {
