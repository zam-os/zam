              "type": "math",
              "tex": "\\mathbf{\\frac{n_1 x_1 + n_2 x_2 + n_3 x_3 - d}{|\\vec{n}|} = 0} \\quad \\text{mit} \\quad |\\vec{n}| = \\sqrt{n_1^2 + n_2^2 + n_3^2}",
