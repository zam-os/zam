      "practice_items": [
        {
          "id": "01K8GB20000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Welche Eigenschaft besitzt der Normalenvektor "
            },
            {
              "type": "math",
              "tex": "\\vec{n}_0",
              "speech": "Vektor n null"
            },
            {
              "type": "text",
              "text": " in der Hesseschen Normalform (HNF) einer Ebene?"
            }
          ],
          "concept": "Er ist ein normierter Einheitsvektor mit der exakten Länge |n_0| = 1 (n_0 = n / |n|)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Er ist ein Einheitsvektor mit der Länge |n_0| = 1",
              "Er hat immer ganzzahlige Koordinaten"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GB20000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere die Hessesche Normalform und die Abstandsberechnung im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ": 1. Die Hessesche Normalform (HNF nach Otto Hesse):   * Aus der Koordinatenform "
            },
            {
              "type": "math",
              "tex": "n_1 x_1 + n_2 x_2 + n_3 x_3 - d = 0",
              "speech": "n eins x eins plus n zwei x zwei plus n drei x drei minus d gleich 0"
            },
            {
              "type": "text",
              "text": " durch Division durch den Betrag des Normalenvektors "
            },
            {
              "type": "math",
              "tex": "|\\vec{n}| = \\sqrt{n_1^2 + n_2^2 + n_3^2}",
              "speech": "Betrag von Vektor n gleich Wurzel aus n eins Quadrat plus n zwei Quadrat plus n drei Quadrat"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\text{HNF}: \\frac{n_1 x_1 + n_2 x_2 + n_3 x_3 - d}{\\sqrt{n_1^2 + n_2^2 + n_3^2}} = 0}",
              "block": true,
              "speech": "Hessesche Normalform: n eins x eins plus n zwei x zwei plus n drei x drei minus d, geteilt durch Wurzel aus n eins Quadrat plus n zwei Quadrat plus n drei Quadrat, gleich 0"
            },
            {
              "type": "text",
              "text": " 2. Abstandsformel Punkt-Ebene:   * Der kürzeste (senkrechte) Abstand eines Punktes "
            },
            {
              "type": "math",
              "tex": "P(p_1|p_2|p_3)",
              "speech": "Punkt P mit den Koordinaten p eins, p zwei und p drei"
            },
            {
              "type": "text",
              "text": " zu einer Ebene "
            },
            {
              "type": "math",
              "tex": "E",
              "speech": "E"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{d(P; E) = \\left| \\frac{n_1 p_1 + n_2 p_2 + n_3 p_3 - d}{|\\vec{n}|} \\right|}",
              "block": true,
              "speech": "d von P und E gleich Betrag von, n eins p eins plus n zwei p zwei plus n drei p drei minus d, geteilt durch Betrag von Vektor n"
            },
            {
              "type": "text",
              "text": " 3. Lagebeziehung Gerade-Ebene:   * Gerade "
            },
            {
              "type": "math",
              "tex": "g: \\vec{X} = \\vec{P} + \\lambda \\vec{v}",
              "speech": "g: Vektor X gleich Vektor P plus Lambda Vektor v"
            },
            {
              "type": "text",
              "text": " in Ebene "
            },
            {
              "type": "math",
              "tex": "E: \\vec{n} \\circ \\vec{X} = d",
              "speech": "Ebene E: Vektor n mal Vektor X gleich d"
            },
            {
              "type": "text",
              "text": " einsetzen "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " Bestimmung des Durchstoßpunkts "
            },
            {
              "type": "math",
              "tex": "S",
              "speech": "S"
            },
            {
              "type": "text",
              "text": ", 4. Gegeben ist die Ebene "
            },
            {
              "type": "math",
              "tex": "E: 2x_1 - x_2 + 2x_3 = 12",
              "speech": "Ebene E: 2 x eins minus x zwei plus 2 x drei gleich 12"
            },
            {
              "type": "text",
              "text": " und der Punkt "
            },
            {
              "type": "math",
              "tex": "P(4 \\mid 1 \\mid 7)",
              "speech": "Punkt P mit den Koordinaten 4, 1 und 7"
            },
            {
              "type": "text",
              "text": ". Berechne den Abstand "
            },
            {
              "type": "math",
              "tex": "d(P; E)",
              "speech": "d von P und E"
            },
            {
              "type": "text",
              "text": " und bestimme den Lotfußpunkt "
            },
            {
              "type": "math",
              "tex": "L",
              "speech": "L"
            },
            {
              "type": "text",
              "text": " auf der Ebene."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "HNF: "
            },
            {
              "type": "math",
              "tex": "d(P; E) = \\frac{|n_1 p_1 + n_2 p_2 + n_3 p_3 - d|}{\\sqrt{n_1^2 + n_2^2 + n_3^2}}",
              "speech": "d von P und E gleich Betrag von n eins p eins plus n zwei p zwei plus n drei p drei minus d, geteilt durch Wurzel aus n eins Quadrat plus n zwei Quadrat plus n drei Quadrat"
            },
            {
              "type": "text",
              "text": "; Lotgerade "
            },
            {
              "type": "math",
