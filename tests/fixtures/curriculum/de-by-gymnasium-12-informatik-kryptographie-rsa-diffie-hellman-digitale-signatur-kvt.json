      "practice_items": [
        {
          "id": "01K8GC90000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Auf welchem mathematischen Problem basiert die Einwegfunktion und damit die Sicherheit des asymmetrischen RSA-Kryptoverfahrens?",
          "concept": "Auf der praktischen Unmöglichkeit, das Produkt zweier sehr großer Primzahlen (N = p * q) in vertretbarer Rechenzeit in seine Primfaktoren zu zerlegen (Faktorisierungsproblem)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Faktorisierungsproblem (Zerlegung des RSA-Moduls N in Primzahlen)",
              "Lösen linearer Gleichungen"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K8GC90000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere das asymmetrische RSA-Verfahren (Ron Rivest, Adi Shamir, Leonard Adleman, 1977): 1. Schlüsselerzeugung (Key Generation):   * Wähle zwei große Primzahlen "
            },
            {
              "type": "math",
              "tex": "p",
              "speech": "p"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "q",
              "speech": "q"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "p \\neq q",
              "speech": "p ungleich q"
            },
            {
              "type": "text",
              "text": ").   * Berechne den RSA-Modul: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{N = p \\cdot q}",
              "speech": "N gleich p mal q"
            },
            {
              "type": "text",
              "text": ".   * Berechne die Eulersche Phi-Funktion: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\varphi(N) = (p - 1) \\cdot (q - 1)}",
              "speech": "Phi von N gleich, p minus 1, mal, q minus 1"
            },
            {
              "type": "text",
              "text": ".   * Wähle einen öffentlichen Exponenten "
            },
            {
              "type": "math",
              "tex": "e",
              "speech": "e"
            },
            {
              "type": "text",
              "text": ", sodass "
            },
            {
              "type": "math",
              "tex": "1 < e < \\varphi(N)",
              "speech": "1 kleiner als e kleiner als Phi von N"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\operatorname{ggT}(e, \\varphi(N)) = 1",
              "speech": "größter gemeinsamer Teiler von e und Phi von N gleich 1"
            },
            {
              "type": "text",
              "text": ".   * Berechne den privaten Schlüssel "
            },
            {
              "type": "math",
              "tex": "d",
              "speech": "d"
            },
            {
              "type": "text",
              "text": " als multiplikatives Inverses von "
            },
            {
              "type": "math",
              "tex": "e",
              "speech": "e"
            },
            {
              "type": "text",
              "text": " modulo "
            },
            {
              "type": "math",
              "tex": "\\varphi(N)",
              "speech": "Phi von N"
            },
            {
              "type": "text",
              "text": " (mit dem erweiterten euklidischen Algorithmus):     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{e \\cdot d \\equiv 1 \\pmod{\\varphi(N)}}",
              "block": true,
              "speech": "e mal d kongruent 1 modulo Phi von N"
            },
            {
              "type": "text",
              "text": "   * Öffentlicher Schlüssel: "
            },
            {
              "type": "math",
              "tex": "(e, N)",
              "speech": "das Paar e und N"
            },
            {
              "type": "text",
              "text": "; Privater Schlüssel: "
            },
            {
              "type": "math",
              "tex": "(d, N)",
              "speech": "das Paar d und N"
            },
            {
              "type": "text",
              "text": ", 2. Verschlüsselung & Entschlüsselung:   * Verschlüsselung: Für Klartext "
            },
            {
              "type": "math",
              "tex": "m < N",
              "speech": "m kleiner als N"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\mathbf{c \\equiv m^e \\pmod N}",
              "speech": "c kongruent m hoch e modulo N"
            },
            {
              "type": "text",
              "text": ".   * Entschlüsselung: Für Geheimtext "
            },
            {
              "type": "math",
              "tex": "c",
              "speech": "c"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\mathbf{m \\equiv c^d \\pmod N}",
              "speech": "m kongruent c hoch d modulo N"
            },
            {
              "type": "text",
              "text": ", 3. Beispielrechnung mit kleinen Zahlen:   * Gegeben: "
            },
            {
              "type": "math",
              "tex": "p = 3, q = 11, e = 3",
              "speech": "p gleich 3, q gleich 11, e gleich 3"
            },
            {
              "type": "text",
              "text": ".   * a) Berechne "
            },
            {
              "type": "math",
              "tex": "N, \\varphi(N)",
              "speech": "N, Phi von N"
            },
            {
              "type": "text",
              "text": " und den privaten Schlüssel "
            },
            {
              "type": "math",
              "tex": "d",
              "speech": "d"
            },
            {
              "type": "text",
              "text": ".   * b) Verschlüssele die Nachricht "
            },
            {
              "type": "math",
              "tex": "m = 4",
              "speech": "m gleich 4"
            },
            {
              "type": "text",
              "text": " und entschlüssele das Chiffrat "
            },
            {
              "type": "math",
              "tex": "c",
              "speech": "c"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "RSA 12: "
            },
            {
              "type": "math",
              "tex": "N = p \\cdot q",
              "speech": "N gleich p mal q"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "\\varphi(N) = (p - 1) \\cdot (q - 1)",
              "speech": "Phi von N gleich, p minus 1, mal, q minus 1"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "e \\cdot d \\equiv 1 \\pmod{\\varphi(N)}",
              "speech": "e mal d kongruent 1 modulo Phi von N"
            },
            {
              "type": "text",
              "text": "; Verschlüsselung "
            },
            {
              "type": "math",
              "tex": "c = m^e \\text{ mod } N",
              "speech": "c gleich m hoch e modulo N"
            },
            {
              "type": "text",
              "text": "; Entschlüsselung "
            },
            {
              "type": "math",
              "tex": "m = c^d \\text{ mod } N",
              "speech": "m gleich c hoch d modulo N"
            },
            {
              "type": "text",
              "text": "; Rechnung: "
            },
            {
              "type": "math",
              "tex": "N = 33",
              "speech": "N gleich 33"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "\\varphi(N) = 20",
              "speech": "Phi von N gleich 20"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "e = 3 \\Rightarrow d = 7",
              "speech": "e gleich 3, daraus folgt d gleich 7"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "3 \\cdot 7 = 21 \\equiv 1 \\pmod{20}",
              "speech": "3 mal 7 gleich 21 kongruent 1 modulo 20"
            },
            {
              "type": "text",
              "text": "); "
            },
            {
              "type": "math",
              "tex": "c = 4^3 \\text{ mod } 33 = 64 \\text{ mod } 33 = 31",
              "speech": "c gleich 4 hoch 3 modulo 33 gleich 64 modulo 33 gleich 31"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "m = 31^7 \\text{ mod } 33 = 4",
              "speech": "m gleich 31 hoch 7 modulo 33 gleich 4"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Mathematische Grundlagen des RSA-Kryptosystems: - Das Prinzip der asymmetrischen Verschlüsselung:   * Im Gegensatz zu symmetrischen Verfahren (AES) gibt es zwei verschiedene Schlüssel:     - Public Key (Öffentlicher Schlüssel): Kann weltweit publiziert werden; dient nur zum Verschlüsseln.     - Private Key (Geheimer Schlüssel): Verbleibt streng geheim beim Empfänger; dient zum Entschlüsseln. - Der Satz von Euler / Kleiner Fermatscher Satz:   * Für alle zu "
            },
            {
              "type": "math",
              "tex": "N"
            },
            {
              "type": "text",
              "text": " teilerfremden Zahlen "
            },
            {
              "type": "math",
              "tex": "m"
            },
            {
              "type": "text",
              "text": " gilt: "
            },
            {
              "type": "math",
              "tex": "m^{\\varphi(N)} \\equiv 1 \\pmod N"
            },
            {
              "type": "text",
              "text": ".   * Da "
            },
            {
              "type": "math",
              "tex": "e \\cdot d \\equiv 1 \\pmod{\\varphi(N)} \\implies e \\cdot d = k \\cdot \\varphi(N) + 1"
            },
            {
              "type": "text",
              "text": ", folgt:     "
            },
            {
              "type": "math",
              "tex": "(m^e)^d = m^{e \\cdot d} = m^{k \\cdot \\varphi(N) + 1} = (m^{\\varphi(N)})^k \\cdot m \\equiv 1^k \\cdot m \\equiv \\mathbf{m \\pmod N}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Vollständige Durchrechnung des Beispiels: - Schritt 1: Parameter berechnen:   * "
            },
            {
              "type": "math",
              "tex": "p = 3, \\; q = 11"
            },
            {
              "type": "text",
              "text": ".   * RSA-Modul: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{N = 3 \\cdot 11 = 33}"
            },
            {
              "type": "text",
              "text": ".   * Eulersche Phi-Funktion: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\varphi(N) = (3 - 1) \\cdot (11 - 1) = 2 \\cdot 10 = 20}"
            },
            {
              "type": "text",
              "text": ". - Schritt 2: Privater Schlüssel "
            },
            {
              "type": "math",
              "tex": "d"
            },
            {
              "type": "text",
              "text": ":   * Gegeben "
            },
            {
              "type": "math",
              "tex": "e = 3"
            },
            {
              "type": "text",
              "text": ". Gesucht ist "
            },
            {
              "type": "math",
              "tex": "d"
            },
            {
              "type": "text",
              "text": ", sodass "
            },
            {
              "type": "math",
              "tex": "3 \\cdot d \\equiv 1 \\pmod{20}"
            },
            {
              "type": "text",
              "text": ".   * Testen der Vielfachen: "
            },
            {
              "type": "math",
              "tex": "3 \\cdot 7 = 21 = 1 \\cdot 20 + 1 \\implies \\mathbf{d = 7}"
            },
            {
              "type": "text",
              "text": ".   * Public Key: "
            },
            {
              "type": "math",
              "tex": "(e=3, N=33)"
            },
            {
              "type": "text",
              "text": "; Private Key: "
            },
            {
              "type": "math",
              "tex": "(d=7, N=33)"
            },
            {
              "type": "text",
              "text": ". - Schritt 3: Verschlüsselung von "
            },
            {
              "type": "math",
              "tex": "m = 4"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "c = m^e \\pmod N = 4^3 \\pmod{33} = 64 \\pmod{33} = \\mathbf{31}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 4: Entschlüsselung von "
            },
            {
              "type": "math",
              "tex": "c = 31"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "m = c^d \\pmod N = 31^7 \\pmod{33}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Da "
            },
            {
              "type": "math",
              "tex": "31 \\equiv -2 \\pmod{33}"
            },
            {
              "type": "text",
              "text": ", lässt sich die Potenz modular extrem vereinfachen:     "
            },
            {
              "type": "math",
              "tex": "(-2)^7 = -128 \\pmod{33} = -128 + 4 \\cdot 33 = -128 + 132 = \\mathbf{4}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Der ursprüngliche Klartext "
            },
            {
              "type": "math",
              "tex": "m = 4"
            },
            {
              "type": "text",
              "text": " wurde fehlerfrei rekonstruiert!"
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
