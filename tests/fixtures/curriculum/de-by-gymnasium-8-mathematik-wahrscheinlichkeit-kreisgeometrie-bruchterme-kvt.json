      ],
      "practice_items": [
        {
          "id": "01K8G8B0000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie lautet die exakte mathematische Formel für den Flächeninhalt "
            },
            {
              "type": "math",
              "tex": "A",
              "speech": "A"
            },
            {
              "type": "text",
              "text": " eines Kreises mit dem Radius "
            },
            {
              "type": "math",
              "tex": "r",
              "speech": "r"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept_segments": [
            {
              "type": "math",
              "tex": "A = \\pi \\cdot r^2",
              "speech": "A gleich Pi mal r Quadrat"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              [
                {
                  "type": "math",
                  "tex": "A = \\pi \\cdot r^2",
                  "speech": "A gleich Pi mal r Quadrat"
                }
              ],
              "A = 2 * pi * r"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8G8B0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Kreisberechnungen und Bruchterme im Gymnasium 8: 1. Der Kreis:   * Umfang: "
            },
            {
              "type": "math",
              "tex": "U = 2\\pi r = \\pi d",
              "speech": "U gleich 2 Pi r gleich Pi d"
            },
            {
              "type": "text",
              "text": ".   * Flächeninhalt: "
            },
            {
              "type": "math",
              "tex": "A = \\pi r^2 = \\frac{1}{4}\\pi d^2",
              "speech": "A gleich Pi r Quadrat gleich ein Viertel Pi d Quadrat"
            },
            {
              "type": "text",
              "text": ".   * Kreissektor (Mittelpunktswinkel "
            },
            {
              "type": "math",
              "tex": "\\alpha",
              "speech": "Alpha"
            },
            {
              "type": "text",
              "text": "): Bogenlänge "
            },
            {
              "type": "math",
              "tex": "b = 2\\pi r \\cdot \\frac{\\alpha}{360^\\circ}",
              "speech": "b gleich 2 Pi r mal Alpha durch 360 Grad"
            },
            {
              "type": "text",
              "text": ", Sektorfläche "
            },
            {
              "type": "math",
              "tex": "A_{\\text{Sektor}} = \\pi r^2 \\cdot \\frac{\\alpha}{360^\\circ} = \\frac{1}{2} b \\cdot r",
              "speech": "A Sektor gleich Pi r Quadrat mal Alpha durch 360 Grad gleich ein halb b mal r"
            },
            {
              "type": "text",
              "text": ", 2. Bruchterme und Definitionsmenge "
            },
            {
              "type": "math",
              "tex": "D",
              "speech": "D"
            },
            {
              "type": "text",
              "text": ":   * Ein Bruchterm enthält eine Variable im Nenner: Der Nenner darf niemals Null werden "
            },
            {
              "type": "math",
              "tex": "\\implies D = \\mathbb{Q} \\setminus \\{x \\mid \\text{Nenner}(x) = 0\\}",
              "speech": "daraus folgt D gleich Q ohne die Menge der x mit Nenner von x gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Kürzen: Nur aus Produkten kürzen ('Aus Differenzen und Summen kürzen nur die Dummen'). 3. Vereinfache den Bruchterm und bestimme "
            },
            {
              "type": "math",
              "tex": "D",
              "speech": "D"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "T(x) = \\frac{2x^2 - 8}{x^2 - 4x + 4}",
              "speech": "T von x gleich Bruch: 2 x Quadrat minus 8, durch x Quadrat minus 4 x plus 4"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept": "Kreis: U = 2*pi*r, A = pi*r^2, Kreissektor (alpha/360°); Bruchterme: Definitionsmenge D (Nenner != 0), Faktorisieren (binomische Formeln) vor dem Kürzen; Rechnung: 2(x^2 - 4)/(x-2)^2 = 2(x-2)(x+2)/(x-2)^2 = 2(x+2)/(x-2) mit D = Q \\ {2}.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Formeln der Kreisgeometrie: - 1. Kreisumfang "
            },
            {
              "type": "math",
              "tex": "U"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{U = 2\\pi r = \\pi d}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Kreisfläche "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{A = \\pi r^2 = \\frac{\\pi}{4} d^2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 3. Kreisteile (Sektor mit Mittelpunktswinkel "
            },
            {
              "type": "math",
              "tex": "\\alpha"
            },
            {
              "type": "text",
              "text": "):   * Kreisbogenlänge "
            },
            {
              "type": "math",
              "tex": "b_\\alpha"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "b_\\alpha = 2\\pi r \\cdot \\frac{\\alpha}{360^\\circ} = \\pi r \\cdot \\frac{\\alpha}{180^\\circ}"
            },
            {
              "type": "text",
              "text": ".   * Sektorflächeninhalt "
            },
            {
              "type": "math",
              "tex": "A_{\\text{Sektor}}"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "A_{\\text{Sektor}} = \\pi r^2 \\cdot \\frac{\\alpha}{360^\\circ} = \\frac{1}{2} \\cdot b_\\alpha \\cdot r"
            },
            {
              "type": "text",
              "text": ". 2. Bruchterme und algebraische Regeln: - Definition: Ein algebraischer Ausdruck "
            },
            {
              "type": "math",
              "tex": "\\frac{Z(x)}{N(x)}"
            },
            {
              "type": "text",
              "text": " heißt Bruchterm, wenn im Nenner "
            },
            {
              "type": "math",
              "tex": "N(x)"
            },
            {
              "type": "text",
              "text": " die Variable "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": " auftritt. - Definitionsmenge "
            },
            {
              "type": "math",
              "tex": "D"
            },
            {
              "type": "text",
              "text": ":   * Da die Division durch "
            },
            {
              "type": "math",
              "tex": "0"
            },
            {
              "type": "text",
              "text": " mathematisch nicht definiert ist, müssen alle Nullstellen des Nenners ausgeschlossen werden:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{D = \\mathbb{Q} \\setminus \\{x \\mid N(x) = 0\\}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Kürzungsregel:   * Zähler und Nenner müssen zuerst durch Ausklammern und Anwendung der Binomischen Formeln vollständig faktorisiert (in Faktoren zerlegt) werden. 3. Durchrechnung des Beispiels: - Gegebener Bruchterm:   "
            },
            {
              "type": "math",
              "tex": "T(x) = \\frac{2x^2 - 8}{x^2 - 4x + 4}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 1: Definitionsmenge "
            },
            {
              "type": "math",
              "tex": "D"
            },
            {
              "type": "text",
              "text": " bestimmen:   * Nenner "
            },
            {
              "type": "math",
              "tex": "= x^2 - 4x + 4 = (x - 2)^2"
            },
            {
              "type": "text",
              "text": " (2. binomische Formel).   * Nullstelle: "
            },
            {
              "type": "math",
              "tex": "(x - 2)^2 = 0 \\iff x = 2"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{D = \\mathbb{Q} \\setminus \\{2\\}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Zähler faktorisieren:   * "
            },
            {
              "type": "math",
              "tex": "2x^2 - 8 = 2(x^2 - 4) = 2(x - 2)(x + 2)"
            },
            {
              "type": "text",
              "text": " (3. binomische Formel). - Schritt 3: Kürzen mit dem gemeinsamen Faktor "
            },
            {
              "type": "math",
              "tex": "(x - 2)"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "T(x) = \\frac{2(x - 2)(x + 2)}{(x - 2)^2} = \\mathbf{\\frac{2(x + 2)}{x - 2} = \\frac{2x + 4}{x - 2}} \\quad \\text{für } x \\in D",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    }
  ]
}
