            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "(2x - 1) \\cdot \\ln(2) = \\ln(16) = 4 \\cdot \\ln(2) \\implies 2x - 1 = 4"
            },
            {
