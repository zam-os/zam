        {
          "id": "01K8GA10000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Exponentialfunktionen und Wachstums-/Zerfallsprozesse: 1. Funktionsgleichung & Graphenverlauf:   * "
            },
            {
              "type": "math",
              "tex": "f(x) = b \\cdot a^x",
              "speech": "f von x gleich b mal a hoch x"
            },
            {
              "type": "text",
              "text": " (mit Anfangsbestand "
            },
            {
              "type": "math",
              "tex": "b > 0",
              "speech": "b größer als 0"
            },
            {
              "type": "text",
              "text": " und Basis "
            },
            {
              "type": "math",
              "tex": "a > 0, a \\neq 1",
              "speech": "a größer als 0, a ungleich 1"
            },
            {
              "type": "text",
              "text": ").   * Für "
            },
            {
              "type": "math",
              "tex": "a > 1",
              "speech": "a größer als 1"
            },
            {
              "type": "text",
              "text": ": streng monoton wachsend ("
            },
            {
              "type": "math",
              "tex": "x \\rightarrow -\\infty: y \\rightarrow 0",
              "speech": "für x gegen minus unendlich geht y gegen 0"
            },
            {
              "type": "text",
              "text": ").   * Für "
            },
            {
              "type": "math",
              "tex": "0 < a < 1",
              "speech": "0 kleiner als a kleiner als 1"
            },
            {
              "type": "text",
              "text": ": streng monoton fallend ("
            },
            {
              "type": "math",
              "tex": "x \\rightarrow +\\infty: y \\rightarrow 0",
              "speech": "für x gegen plus unendlich geht y gegen 0"
            },
            {
              "type": "text",
              "text": ").   * Die "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse ("
            },
            {
              "type": "math",
              "tex": "y = 0",
              "speech": "y gleich 0"
            },
            {
              "type": "text",
              "text": ") ist stets waagrechte Asymptote, 2. Darstellung mit der Eulerschen Zahl "
            },
            {
              "type": "math",
              "tex": "e \\approx 2{,}71828",
              "speech": "e ungefähr 2,71828"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "B(t) = B_0 \\cdot e^{k \\cdot t}",
              "speech": "B von t gleich B null mal e hoch k mal t"
            },
            {
              "type": "text",
              "text": " (mit Wachstumskonstante "
            },
            {
              "type": "math",
              "tex": "k = \\ln(a)",
              "speech": "k gleich l n von a"
            },
            {
              "type": "text",
              "text": "), 3. Verdopplungszeit "
            },
            {
              "type": "math",
              "tex": "T_2",
              "speech": "T zwei"
            },
            {
              "type": "text",
              "text": " & Halbwertszeit "
            },
            {
              "type": "math",
              "tex": "T_{1/2}",
              "speech": "T ein halb"
            },
            {
              "type": "text",
              "text": ":   * Verdopplung ("
            },
            {
              "type": "math",
              "tex": "a > 1",
              "speech": "a größer als 1"
            },
            {
              "type": "text",
              "text": " bzw. "
            },
            {
              "type": "math",
              "tex": "k > 0",
              "speech": "k größer als 0"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "T_2 = \\frac{\\ln(2)}{k}",
              "speech": "T zwei gleich l n von 2 durch k"
            },
            {
              "type": "text",
              "text": ".   * Halbwertszeit ("
            },
            {
              "type": "math",
              "tex": "0 < a < 1",
              "speech": "0 kleiner als a kleiner als 1"
            },
            {
              "type": "text",
              "text": " bzw. "
            },
            {
              "type": "math",
              "tex": "k < 0",
              "speech": "k kleiner als 0"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "T_{1/2} = \\frac{\\ln(2)}{|k|}",
              "speech": "T ein halb gleich l n von 2 durch Betrag von k"
            },
            {
              "type": "text",
              "text": ", 4. Eine Bakterienkultur hat zu Beginn "
            },
            {
              "type": "math",
              "tex": "B_0 = 500",
              "speech": "B null gleich 500"
            },
            {
              "type": "text",
              "text": " Bakterien und verdoppelt sich alle "
            },
            {
              "type": "math",
              "tex": "3",
              "speech": "3"
            },
            {
              "type": "text",
              "text": " Stunden. Bestimme die Funktionsgleichung "
            },
            {
              "type": "math",
              "tex": "B(t)",
              "speech": "B von t"
            },
            {
              "type": "text",
              "text": " und berechne den Bestand nach "
            },
            {
              "type": "math",
              "tex": "9",
              "speech": "9"
            },
            {
              "type": "text",
              "text": " Stunden."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Exponentialfunktion: "
            },
            {
              "type": "math",
              "tex": "f(x) = b \\cdot a^x = b \\cdot e^{k \\cdot t}",
              "speech": "f von x gleich b mal a hoch x gleich b mal e hoch k mal t"
            },
            {
              "type": "text",
              "text": "; Asymptote "
            },
            {
              "type": "math",
              "tex": "y = 0",
              "speech": "y gleich 0"
            },
            {
              "type": "text",
              "text": "; Verdopplungszeit "
            },
            {
              "type": "math",
              "tex": "T_2 = \\frac{\\ln(2)}{k}",
              "speech": "T zwei gleich l n von 2 durch k"
            },
            {
              "type": "text",
              "text": "; Halbwertszeit "
            },
            {
              "type": "math",
              "tex": "T_{1/2} = \\frac{\\ln(2)}{|k|}",
              "speech": "T ein halb gleich l n von 2 durch Betrag von k"
            },
            {
              "type": "text",
              "text": "; Rechnung: "
            },
            {
              "type": "math",
              "tex": "B(t) = 500 \\cdot 2^{t/3}",
              "speech": "B von t gleich 500 mal 2 hoch, t durch 3"
            },
            {
              "type": "text",
              "text": "; nach 9 h: "
            },
            {
              "type": "math",
              "tex": "\\frac{t}{3} = 3",
              "speech": "t durch 3 gleich 3"
            },
            {
              "type": "text",
              "text": " Verdopplungen "
            },
            {
              "type": "math",
              "tex": "\\Rightarrow B(9) = 500 \\cdot 2^3 = 500 \\cdot 8 = 4000",
              "speech": "daraus folgt B von 9 gleich 500 mal 2 hoch drei gleich 500 mal 8 gleich 4000"
            },
            {
              "type": "text",
              "text": " Bakterien."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Mathematische Grundlagen der Exponentialfunktionen: - Allgemeine Funktionsgleichung:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(x) = b \\cdot a^x} \\quad (b > 0, a > 0, a \\neq 1)",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "b = f(0)"
            },
            {
              "type": "text",
              "text": ": Anfangsbestand ("
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achsenabschnitt "
            },
            {
              "type": "math",
              "tex": "S_y(0 \\mid b)"
            },
            {
              "type": "text",
              "text": ").   * "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": ": Wachstumsfaktor pro Zeiteinheit ("
            },
            {
              "type": "math",
              "tex": "a = 1 + p"
            },
            {
              "type": "text",
              "text": " bei Zunahme um "
            },
            {
              "type": "math",
              "tex": "p\\%"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "a = 1 - p"
            },
            {
              "type": "text",
              "text": " bei Abnahme). - Verlauf des Graphen:   * "
            },
            {
              "type": "math",
              "tex": "a > 1"
            },
            {
              "type": "text",
              "text": ": Exponentielles Wachstum (linksgekrümmt, streng monoton steigend, nähert sich für "
            },
            {
              "type": "math",
              "tex": "x \\rightarrow -\\infty"
            },
            {
              "type": "text",
              "text": " der Asymptote "
            },
            {
              "type": "math",
              "tex": "y = 0"
            },
            {
              "type": "text",
              "text": ").   * "
            },
            {
              "type": "math",
              "tex": "0 < a < 1"
            },
            {
              "type": "text",
              "text": ": Exponentieller Zerfall (streng monoton fallend, nähert sich für "
            },
            {
              "type": "math",
              "tex": "x \\rightarrow +\\infty"
            },
            {
              "type": "text",
              "text": " der Asymptote "
            },
            {
              "type": "math",
              "tex": "y = 0"
            },
            {
              "type": "text",
              "text": "). 2. Kontinuierliches Wachstum mit Basis "
            },
            {
              "type": "math",
              "tex": "e"
            },
            {
              "type": "text",
              "text": ": - Jede Exponentialfunktion lässt sich mit der Eulerschen Zahl "
            },
            {
              "type": "math",
              "tex": "e \\approx 2{,}71828"
            },
            {
              "type": "text",
              "text": " darstellen:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{B(t) = B_0 \\cdot e^{k \\cdot t}} \\quad \\text{mit} \\quad \\mathbf{k = \\ln(a)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "k > 0"
            },
            {
              "type": "text",
              "text": ": kontinuierliche Wachstumsrate; "
            },
            {
              "type": "math",
              "tex": "k < 0"
            },
            {
              "type": "text",
              "text": ": kontinuierliche Zerfallsrate. 3. Verdopplungs- und Halbwertszeit: - Verdopplungszeit "
            },
            {
              "type": "math",
              "tex": "T_2"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "2 B_0 = B_0 \\cdot e^{k \\cdot T_2} \\implies 2 = e^{k \\cdot T_2} \\implies \\mathbf{T_2 = \\frac{\\ln(2)}{k}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Halbwertszeit "
            },
            {
              "type": "math",
              "tex": "T_{1/2}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\frac{1}{2} B_0 = B_0 \\cdot e^{k \\cdot T_{1/2}} \\implies \\frac{1}{2} = e^{k \\cdot T_{1/2}} \\implies \\mathbf{T_{1/2} = \\frac{\\ln(2)}{|k|}}",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Berechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "B_0 = 500, T_2 = 3\\,\\text{h}"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Funktionsgleichung:   "
            },
            {
              "type": "math",
              "tex": "B(t) = 500 \\cdot 2^{\\frac{t}{3\\,\\text{h}}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Bestand nach "
            },
            {
              "type": "math",
              "tex": "t = 9\\,\\text{h}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "B(9) = 500 \\cdot 2^{\\frac{9}{3}} = 500 \\cdot 2^3 = 500 \\cdot 8 = \\mathbf{4000\\,\\text{Bakterien}}",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
