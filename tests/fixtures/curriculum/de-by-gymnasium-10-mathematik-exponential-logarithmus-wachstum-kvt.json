          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie lautet das fundamentale Logarithmengesetz zur Vereinfachung einer Potenz im Logarithmus "
            },
            {
              "type": "math",
              "tex": "\\log_a(u^r)",
              "speech": "Logarithmus zur Basis a von u hoch r"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept_segments": [
            {
              "type": "math",
              "tex": "\\log_a(u^r) = r \\cdot \\log_a(u)",
              "speech": "Logarithmus zur Basis a von u hoch r gleich r mal Logarithmus zur Basis a von u"
            },
            {
              "type": "text",
              "text": " (Exponentenregel: Exponent wird zum multiplikativen Vorfaktor)"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              [
                {
                  "type": "math",
                  "tex": "\\log_a(u^r) = r \\cdot \\log_a(u)",
                  "speech": "Logarithmus zur Basis a von u hoch r gleich r mal Logarithmus zur Basis a von u"
                }
              ],
              [
                {
                  "type": "math",
                  "tex": "\\log_a(u^r) = (\\log_a u)^r",
                  "speech": "Logarithmus zur Basis a von u hoch r gleich, Logarithmus zur Basis a von u, hoch r"
                }
              ]
            ],
