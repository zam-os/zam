          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie viele reelle Lösungen besitzt eine quadratische Gleichung "
            },
            {
              "type": "math",
              "tex": "ax^2 + bx + c = 0",
              "speech": "a x Quadrat plus b x plus c gleich 0"
            },
            {
              "type": "text",
              "text": ", wenn ihre Diskriminante "
            },
            {
              "type": "math",
              "tex": "D = b^2 - 4ac < 0",
              "speech": "D gleich b Quadrat minus 4 a c kleiner als 0"
            },
            {
              "type": "text",
              "text": " ist?"
            }
          ],
          "concept": "Genau 0 reelle Lösungen (die Lösungsmenge ist leer: L = {})",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "0 reelle Lösungen (L = {})",
              "2 reelle Lösungen"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8G9A0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere quadratische Funktionen und Gleichungen: 1. Darstellungsformen der Parabel:   * Scheitelpunktform: "
            },
            {
              "type": "math",
              "tex": "f(x) = a(x - d)^2 + e \\implies",
              "speech": "f von x gleich a mal Klammer auf x minus d Klammer zu Quadrat plus e, daraus folgt"
            },
            {
              "type": "text",
              "text": " Scheitelpunkt "
            },
            {
              "type": "math",
              "tex": "S(d \\mid e)",
              "speech": "Punkt S mit den Koordinaten d und e"
            },
            {
              "type": "text",
              "text": ".   * Allgemeine Form (Normalform): "
            },
            {
              "type": "math",
              "tex": "f(x) = ax^2 + bx + c",
              "speech": "f von x gleich a x Quadrat plus b x plus c"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "c = y",
              "speech": "c gleich y"
            },
            {
              "type": "text",
              "text": "-Achsenabschnitt).   * Linearfaktorform (faktorisierte Form): "
            },
            {
              "type": "math",
              "tex": "f(x) = a(x - x_1)(x - x_2)",
              "speech": "f von x gleich a mal Klammer auf x minus x eins Klammer zu mal Klammer auf x minus x zwei Klammer zu"
            },
            {
              "type": "text",
              "text": " bei Nullstellen "
            },
            {
              "type": "math",
              "tex": "x_1, x_2",
              "speech": "x eins, x zwei"
            },
            {
              "type": "text",
              "text": ", 2. Bedeutung des Formfaktors "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "a > 0",
              "speech": "a größer als 0"
            },
            {
              "type": "text",
              "text": ": nach oben geöffnet (Tiefpunkt); "
            },
            {
              "type": "math",
              "tex": "a < 0",
              "speech": "a kleiner als 0"
            },
            {
              "type": "text",
              "text": ": nach unten geöffnet (Hochpunkt).   * "
            },
            {
              "type": "math",
              "tex": "|a| > 1",
              "speech": "Betrag von a größer als 1"
            },
            {
              "type": "text",
              "text": ": gestreckt / schmaler als Normalparabel; "
            },
            {
              "type": "math",
              "tex": "|a| < 1",
              "speech": "Betrag von a kleiner als 1"
            },
            {
              "type": "text",
              "text": ": gestaucht / breiter, 3. Die Mitternachtsformel (Große Lösungsformel):   "
            },
            {
              "type": "math",
              "tex": "x_{1,2} = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}",
              "block": true,
              "speech": "x eins zwei gleich minus b plus minus Wurzel aus b Quadrat minus 4 a c, geteilt durch 2 a"
            },
            {
              "type": "text",
              "text": "   * Diskriminante "
            },
            {
              "type": "math",
              "tex": "D = b^2 - 4ac",
              "speech": "D gleich b Quadrat minus 4 a c"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "D > 0 \\implies 2",
              "speech": "D größer als 0, daraus folgt 2"
            },
            {
              "type": "text",
              "text": " Nullstellen; "
            },
            {
              "type": "math",
              "tex": "D = 0 \\implies 1",
              "speech": "D gleich 0, daraus folgt 1"
            },
            {
              "type": "text",
              "text": " doppelte Nullstelle (Scheitelpunkt auf "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse); "
            },
            {
              "type": "math",
              "tex": "D < 0 \\implies 0",
              "speech": "D kleiner als 0, daraus folgt 0"
            },
            {
              "type": "text",
              "text": " Nullstellen, 4. Bestimme Scheitelpunkt und Nullstellen der Parabel "
            },
            {
              "type": "math",
              "tex": "p: f(x) = 2x^2 - 8x + 6",
              "speech": "p: f von x gleich 2 x Quadrat minus 8 x plus 6"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Quadratische Funktionen: Scheitelpunktform "
            },
            {
              "type": "math",
              "tex": "f(x) = a(x - d)^2 + e \\Rightarrow S(d|e)",
              "speech": "f von x gleich a mal Klammer auf x minus d Klammer zu Quadrat plus e, daraus folgt Scheitelpunkt S mit den Koordinaten d und e"
            },
            {
              "type": "text",
              "text": "; Formfaktor "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": "; Mitternachtsformel "
            },
            {
              "type": "math",
              "tex": "x_{1,2} = \\frac{-b \\pm \\sqrt{D}}{2a}",
              "speech": "x eins zwei gleich minus b plus minus Wurzel aus D, geteilt durch 2 a"
            },
            {
              "type": "text",
              "text": "; Diskriminante "
            },
            {
              "type": "math",
              "tex": "D = b^2 - 4ac",
              "speech": "D gleich b Quadrat minus 4 a c"
            },
            {
              "type": "text",
              "text": " (3 Fälle); Umrechnung: "
            },
            {
              "type": "math",
              "tex": "2(x^2 - 4x + 3) = 2((x - 2)^2 - 1) = 2(x - 2)^2 - 2 \\Rightarrow S(2|-2)",
              "speech": "2 mal Klammer auf x Quadrat minus 4 x plus 3 Klammer zu gleich 2 mal Klammer auf Klammer auf x minus 2 Klammer zu Quadrat minus 1 Klammer zu gleich 2 mal Klammer auf x minus 2 Klammer zu Quadrat minus 2, daraus folgt Scheitelpunkt S mit den Koordinaten 2 und minus 2"
            },
            {
              "type": "text",
              "text": "; Nullstellen "
            },
            {
              "type": "math",
              "tex": "x_1 = 1",
              "speech": "x eins gleich 1"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "x_2 = 3",
              "speech": "x zwei gleich 3"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Darstellungsformen quadratischer Funktionen: - 1. Scheitelpunktform:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(x) = a(x - d)^2 + e \\implies \\text{Scheitel } S(d \\mid e)}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "d"
            },
            {
              "type": "text",
              "text": ": Verschiebung in "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Richtung (nach rechts für "
            },
            {
              "type": "math",
              "tex": "d > 0"
            },
            {
              "type": "text",
              "text": ", nach links für "
            },
            {
              "type": "math",
              "tex": "d < 0"
            },
            {
              "type": "text",
              "text": ").   * "
            },
            {
              "type": "math",
              "tex": "e"
            },
            {
              "type": "text",
              "text": ": Verschiebung in "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Richtung nach oben/unten. - 2. Allgemeine Form:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(x) = ax^2 + bx + c}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "c = f(0)"
            },
            {
              "type": "text",
              "text": ": Schnittpunkt mit der "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achse "
            },
            {
              "type": "math",
              "tex": "S_y(0 \\mid c)"
            },
            {
              "type": "text",
              "text": ". - 3. Faktorisierte Form (Linearfaktorzerlegung):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{f(x) = a(x - x_1)(x - x_2)}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Der Formfaktor "
            },
            {
              "type": "math",
              "tex": "a"
            },
            {
              "type": "text",
              "text": ": - Öffnungsrichtung: "
            },
            {
              "type": "math",
              "tex": "a > 0"
            },
            {
              "type": "text",
              "text": " nach oben, "
            },
            {
              "type": "math",
              "tex": "a < 0"
            },
            {
              "type": "text",
              "text": " nach unten. - Streckung/Stauchung: "
            },
            {
              "type": "math",
              "tex": "|a| > 1"
            },
            {
              "type": "text",
              "text": " schmaler (gestreckt), "
            },
            {
              "type": "math",
              "tex": "|a| < 1"
            },
            {
              "type": "text",
              "text": " breiter (gestaucht), "
            },
            {
              "type": "math",
              "tex": "a = 1"
            },
            {
              "type": "text",
              "text": " Normalparabel. 3. Die Mitternachtsformel und Diskriminante "
            },
            {
              "type": "math",
              "tex": "D"
            },
            {
              "type": "text",
              "text": ": - Für "
            },
            {
              "type": "math",
              "tex": "ax^2 + bx + c = 0"
            },
            {
              "type": "text",
              "text": " gilt:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{x_{1,2} = \\frac{-b \\pm \\sqrt{D}}{2a}} \\quad \\text{mit} \\quad \\mathbf{D = b^2 - 4ac}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{D > 0}"
            },
            {
              "type": "text",
              "text": ": Zwei reelle Lösungen (zwei Schnittpunkte mit der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse).   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{D = 0}"
            },
            {
              "type": "text",
              "text": ": Genau eine Lösung ("
            },
            {
              "type": "math",
              "tex": "x_0 = -\\frac{b}{2a}"
            },
            {
              "type": "text",
              "text": ", Parabel berührt die "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse).   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{D < 0}"
            },
            {
              "type": "text",
              "text": ": Keine reelle Lösung ("
            },
            {
              "type": "math",
              "tex": "L = \\emptyset"
            },
            {
              "type": "text",
              "text": ", Parabel verläuft echt ober- bzw. unterhalb der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse). 4. Durchrechnung des Beispiels "
            },
            {
              "type": "math",
              "tex": "p: f(x) = 2x^2 - 8x + 6"
            },
            {
              "type": "text",
              "text": ": - Schritt 1: Scheitelpunkt durch quadratische Ergänzung:   "
            },
            {
              "type": "math",
              "tex": "f(x) = 2[x^2 - 4x + 3] = 2[(x - 2)^2 - 4 + 3] = 2[(x - 2)^2 - 1] = \\mathbf{2(x - 2)^2 - 2}",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "\\implies \\mathbf{S(2 \\mid -2)}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Nullstellen mit der Mitternachtsformel ("
            },
            {
              "type": "math",
              "tex": "a=2, b=-8, c=6"
            },
            {
              "type": "text",
              "text": "):   "
            },
            {
              "type": "math",
              "tex": "D = (-8)^2 - 4 \\cdot 2 \\cdot 6 = 64 - 48 = 16 > 0",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "x_{1,2} = \\frac{-(-8) \\pm \\sqrt{16}}{2 \\cdot 2} = \\frac{8 \\pm 4}{4}",
              "block": true
            },
            {
              "type": "text",
              "text": "   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{x_1 = \\frac{8 - 4}{4} = 1}, \\quad \\mathbf{x_2 = \\frac{8 + 4}{4} = 3}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Nullstellen: "
            },
            {
              "type": "math",
              "tex": "N_1(1 \\mid 0)"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "N_2(3 \\mid 0)"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
