          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie ist der Sinus eines spitzen Winkels "
            },
            {
              "type": "math",
              "tex": "\\alpha",
              "speech": "Alpha"
            },
            {
              "type": "text",
              "text": " in einem rechtwinkligen Dreieck definiert?"
            }
          ],
          "concept": "sin(alpha) = Gegenkathete / Hypotenuse",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Gegenkathete / Hypotenuse",
              "Ankathete / Hypotenuse"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8G9A0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Systematisiere die Satzgruppe des Pythagoras und die Trigonometrie am rechtwinkligen Dreieck: 1. Die Satzgruppe des Pythagoras (rechtwinkliges Dreieck "
            },
            {
              "type": "math",
              "tex": "\\triangle ABC",
              "speech": "Dreieck A B C"
            },
            {
              "type": "text",
              "text": " mit Hypotenuse "
            },
            {
              "type": "math",
              "tex": "c",
              "speech": "c"
            },
            {
              "type": "text",
              "text": ", Katheten "
            },
            {
              "type": "math",
              "tex": "a, b",
              "speech": "a, b"
            },
            {
              "type": "text",
              "text": ", Höhe "
            },
            {
              "type": "math",
              "tex": "h",
              "speech": "h"
            },
            {
              "type": "text",
              "text": " und Hypotenusenabschnitten "
            },
            {
              "type": "math",
              "tex": "p, q",
              "speech": "p, q"
            },
            {
              "type": "text",
              "text": "):   * Satz des Pythagoras: "
            },
            {
              "type": "math",
              "tex": "a^2 + b^2 = c^2",
              "speech": "a Quadrat plus b Quadrat gleich c Quadrat"
            },
            {
              "type": "text",
              "text": ".   * Höhensatz des Euklid: "
            },
            {
              "type": "math",
              "tex": "h^2 = p \\cdot q",
              "speech": "h Quadrat gleich p mal q"
            },
            {
              "type": "text",
              "text": ".   * Kathetensatz des Euklid: "
            },
            {
              "type": "math",
              "tex": "a^2 = c \\cdot p",
              "speech": "a Quadrat gleich c mal p"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "b^2 = c \\cdot q",
              "speech": "b Quadrat gleich c mal q"
            },
            {
              "type": "text",
              "text": ", 2. Trigonometrische Verhältnisse:   * "
            },
            {
              "type": "math",
              "tex": "\\sin \\alpha = \\frac{\\text{Gegenkathete von } \\alpha}{\\text{Hypotenuse}}",
              "speech": "Sinus Alpha gleich Gegenkathete von Alpha durch Hypotenuse"
            },
            {
              "type": "text",
              "text": ".   * "
            },
            {
              "type": "math",
