      "practice_items": [
        {
          "id": "01K8GA30000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wann stehen zwei vom Nullvektor verschiedene Vektoren "
            },
            {
              "type": "math",
              "tex": "\\vec{a}",
              "speech": "Vektor a"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{b}",
              "speech": "Vektor b"
            },
            {
              "type": "text",
              "text": " im dreidimensionalen Raum "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": " orthogonal (senkrecht) aufeinander?"
            }
          ],
          "concept": "Genau dann, wenn ihr Skalarprodukt Null ist: a * b = a1*b1 + a2*b2 + a3*b3 = 0 (da cos(90°) = 0)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Wenn ihr Skalarprodukt Null ist: a * b = 0",
              "Wenn ihr Skalarprodukt 1 ergibt"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GA30000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Vektoroperationen und das Skalarprodukt im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ": 1. Punkte und Vektoren:   * Verbindungsvektor von "
            },
            {
              "type": "math",
              "tex": "A(a_1|a_2|a_3)",
              "speech": "Punkt A mit den Koordinaten a eins, a zwei und a drei"
            },
            {
              "type": "text",
              "text": " nach "
            },
            {
              "type": "math",
              "tex": "B(b_1|b_2|b_3)",
              "speech": "Punkt B mit den Koordinaten b eins, b zwei und b drei"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\vec{AB} = \\vec{B} - \\vec{A} = \\begin{pmatrix} b_1 - a_1 \\\\ b_2 - a_2 \\\\ b_3 - a_3 \\end{pmatrix}",
              "speech": "Vektor A B gleich Vektor B minus Vektor A gleich Spaltenvektor b eins minus a eins, b zwei minus a zwei, b drei minus a drei"
            },
            {
              "type": "text",
              "text": " ('Spitze minus Schaft').   * Betrag (Länge): "
            },
            {
              "type": "math",
              "tex": "|\\vec{v}| = \\sqrt{v_1^2 + v_2^2 + v_3^2}",
              "speech": "Betrag von Vektor v gleich Wurzel aus v eins Quadrat plus v zwei Quadrat plus v drei Quadrat"
            },
            {
              "type": "text",
              "text": ", 2. Das Skalarprodukt (Skalares Produkt zweier Vektoren):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{a} \\circ \\vec{b} = a_1 b_1 + a_2 b_2 + a_3 b_3 = |\\vec{a}| \\cdot |\\vec{b}| \\cdot \\cos(\\varphi)}",
              "block": true,
              "speech": "Vektor a mal Vektor b gleich a eins b eins plus a zwei b zwei plus a drei b drei gleich Betrag von Vektor a mal Betrag von Vektor b mal Kosinus von Phi"
            },
            {
              "type": "text",
              "text": "   * Orthogonalitätskriterium: "
            },
            {
              "type": "math",
              "tex": "\\vec{a} \\perp \\vec{b} \\iff \\vec{a} \\circ \\vec{b} = 0",
              "speech": "Vektor a senkrecht zu Vektor b genau dann, wenn Vektor a mal Vektor b gleich 0"
            },
            {
              "type": "text",
              "text": ".   * Winkelberechnung: "
            },
            {
              "type": "math",
              "tex": "\\cos(\\varphi) = \\frac{\\vec{a} \\circ \\vec{b}}{|\\vec{a}| \\cdot |\\vec{b}|}",
              "speech": "Kosinus von Phi gleich Vektor a mal Vektor b durch Betrag von Vektor a mal Betrag von Vektor b"
            },
            {
              "type": "text",
              "text": ", 3. Gegeben sind die Vektoren "
            },
            {
              "type": "math",
              "tex": "\\vec{a} = \\begin{pmatrix} 2 \\\\ -3 \\\\ 6 \\end{pmatrix}",
              "speech": "Vektor a gleich Spaltenvektor 2, minus 3, 6"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{b} = \\begin{pmatrix} 6 \\\\ 4 \\\\ 0 \\end{pmatrix}",
              "speech": "Vektor b gleich Spaltenvektor 6, 4, 0"
            },
            {
              "type": "text",
              "text": ". Berechne die Länge "
            },
            {
              "type": "math",
              "tex": "|\\vec{a}|",
              "speech": "Betrag von Vektor a"
            },
            {
              "type": "text",
              "text": " und zeige rechnerisch, dass "
            },
            {
              "type": "math",
              "tex": "\\vec{a}",
              "speech": "Vektor a"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{b}",
              "speech": "Vektor b"
            },
            {
              "type": "text",
              "text": " orthogonal zueinander sind."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Vektoren im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ": Verbindungsvektor "
            },
            {
              "type": "math",
              "tex": "\\vec{AB} = B - A",
              "speech": "Vektor A B gleich B minus A"
            },
            {
              "type": "text",
              "text": "; Betrag "
            },
            {
              "type": "math",
              "tex": "|\\vec{v}| = \\sqrt{v_1^2 + v_2^2 + v_3^2}",
              "speech": "Betrag von Vektor v gleich Wurzel aus v eins Quadrat plus v zwei Quadrat plus v drei Quadrat"
            },
            {
              "type": "text",
              "text": "; Skalarprodukt "
            },
            {
              "type": "math",
              "tex": "\\vec{a} \\cdot \\vec{b} = a_1 b_1 + a_2 b_2 + a_3 b_3",
              "speech": "Vektor a mal Vektor b gleich a eins b eins plus a zwei b zwei plus a drei b drei"
            },
            {
              "type": "text",
              "text": "; Orthogonalität "
            },
            {
              "type": "math",
              "tex": "\\vec{a} \\cdot \\vec{b} = 0",
              "speech": "Vektor a mal Vektor b gleich 0"
            },
            {
              "type": "text",
              "text": "; Rechnung: "
            },
            {
              "type": "math",
              "tex": "|\\vec{a}| = \\sqrt{4 + 9 + 36} = \\sqrt{49} = 7",
              "speech": "Betrag von Vektor a gleich Wurzel aus 4 plus 9 plus 36 gleich Wurzel aus 49 gleich 7"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "\\vec{a} \\cdot \\vec{b} = 2 \\cdot 6 + (-3) \\cdot 4 + 6 \\cdot 0 = 12 - 12 + 0 = 0 \\Rightarrow",
              "speech": "Vektor a mal Vektor b gleich 2 mal 6 plus minus 3 mal 4 plus 6 mal 0 gleich 12 minus 12 plus 0 gleich 0, daraus folgt"
            },
            {
              "type": "text",
              "text": " orthogonal!"
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Koordinaten und Vektorgeometrie im Raum "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3"
            },
            {
              "type": "text",
              "text": ": - 1. Punkte und Verbindungsvektoren:   * Der Pfeil von Punkt "
            },
            {
              "type": "math",
              "tex": "A(a_1 \\mid a_2 \\mid a_3)"
            },
            {
              "type": "text",
              "text": " zu Punkt "
            },
            {
              "type": "math",
              "tex": "B(b_1 \\mid b_2 \\mid b_3)"
            },
            {
              "type": "text",
              "text": " berechnet sich nach der Regel 'Spitze minus Fuß':     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{AB} = \\begin{pmatrix} b_1 - a_1 \\\\ b_2 - a_2 \\\\ b_3 - a_3 \\end{pmatrix}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Betrag (Länge eines Vektors):   * Euklidische Norm über den doppelten Satz des Pythagoras:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{|\\vec{v}| = \\sqrt{v_1^2 + v_2^2 + v_3^2}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Einheitsvektor: "
            },
            {
              "type": "math",
              "tex": "\\vec{v}_0 = \\frac{\\vec{v}}{|\\vec{v}|}"
            },
            {
              "type": "text",
              "text": " mit Länge "
            },
            {
              "type": "math",
              "tex": "|\\vec{v}_0| = 1"
            },
            {
              "type": "text",
              "text": ". 2. Das Skalarprodukt und seine geometrischen Anwendungen: - Definition:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{a} \\circ \\vec{b} = a_1 \\cdot b_1 + a_2 \\cdot b_2 + a_3 \\cdot b_3 = |\\vec{a}| \\cdot |\\vec{b}| \\cdot \\cos(\\varphi)}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 1. Orthogonalitätskriterium:   * Da "
            },
            {
              "type": "math",
              "tex": "\\cos(90^\\circ) = 0"
            },
            {
              "type": "text",
              "text": ", gilt für zwei Vektoren "
            },
            {
              "type": "math",
              "tex": "\\vec{a}, \\vec{b} \\neq \\vec{0}"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{a} \\perp \\vec{b} \\quad \\iff \\quad \\vec{a} \\circ \\vec{b} = 0}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Schnittwinkel "
            },
            {
              "type": "math",
              "tex": "\\varphi"
            },
            {
              "type": "text",
              "text": " zweier Vektoren:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\cos(\\varphi) = \\frac{\\vec{a} \\circ \\vec{b}}{|\\vec{a}| \\cdot |\\vec{b}|} \\quad (0^\\circ \\le \\varphi \\le 180^\\circ)}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Durchrechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "\\vec{a} = \\begin{pmatrix} 2 \\\\ -3 \\\\ 6 \\end{pmatrix}, \\vec{b} = \\begin{pmatrix} 6 \\\\ 4 \\\\ 0 \\end{pmatrix}"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Betrag von "
            },
            {
              "type": "math",
              "tex": "\\vec{a}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "|\\vec{a}| = \\sqrt{2^2 + (-3)^2 + 6^2} = \\sqrt{4 + 9 + 36} = \\sqrt{49} = \\mathbf{7\\,\\text{LE (Längeneinheiten)}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Skalarprodukt "
            },
            {
              "type": "math",
              "tex": "\\vec{a} \\circ \\vec{b}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\vec{a} \\circ \\vec{b} = 2 \\cdot 6 + (-3) \\cdot 4 + 6 \\cdot 0 = 12 - 12 + 0 = \\mathbf{0}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schlussfolgerung:   * Da das Skalarprodukt exakt "
            },
            {
              "type": "math",
              "tex": "0"
            },
            {
              "type": "text",
              "text": " ist, stehen die beiden Vektoren "
            },
            {
              "type": "math",
              "tex": "\\vec{a}"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "\\vec{b}"
            },
            {
              "type": "text",
              "text": " senkrecht (orthogonal) aufeinander (Winkel "
            },
            {
              "type": "math",
              "tex": "\\varphi = 90^\\circ"
            },
            {
              "type": "text",
              "text": ")."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
