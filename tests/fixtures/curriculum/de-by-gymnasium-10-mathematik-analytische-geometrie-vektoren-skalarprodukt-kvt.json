      "practice_items": [
        {
          "id": "01K8GA30000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Welche Lagebeziehung liegt vor, wenn zwei Geraden im Raum weder parallel noch identisch sind und keinen gemeinsamen Schnittpunkt besitzen?",
          "concept": "Sie sind windschief zueinander (ihre Richtungsvektoren sind nicht kollinear und sie schneiden sich nicht)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Windschief (kein Schnittpunkt, nicht parallel)",
              "Orthogonal schneidend"
            ],
            "correct_index": 0
          }
        },
        {
          "id": "01K8GA30000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere Geradengleichungen in Parameterform und die 4 Lagebeziehungen zweier Geraden im "
            },
            {
              "type": "math",
              "tex": "\\mathbb{R}^3",
              "speech": "R drei"
            },
            {
              "type": "text",
              "text": ": 1. Parametergleichung einer Geraden "
            },
            {
              "type": "math",
              "tex": "g",
              "speech": "g"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{g: \\vec{X} = \\vec{P} + \\lambda \\cdot \\vec{v}} \\quad (\\lambda \\in \\mathbb{R})",
              "block": true,
              "speech": "g: Vektor X gleich Vektor P plus Lambda mal Vektor v, mit Lambda Element von R"
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\vec{P}",
              "speech": "Vektor P"
            },
            {
              "type": "text",
              "text": ": Stützvektor (Ortsvektor eines Punktes auf der Geraden).   * "
            },
            {
              "type": "math",
              "tex": "\\vec{v} \\neq \\vec{0}",
              "speech": "Vektor v ungleich Nullvektor"
            },
            {
              "type": "text",
              "text": ": Richtungsvektor.   * "
            },
            {
              "type": "math",
              "tex": "\\lambda",
              "speech": "Lambda"
            },
            {
              "type": "text",
              "text": ": reeller Parameter, 2. Punktprobe: Liegt ein Punkt "
            },
            {
              "type": "math",
              "tex": "Q",
              "speech": "Q"
            },
            {
              "type": "text",
              "text": " auf "
            },
            {
              "type": "math",
              "tex": "g",
              "speech": "g"
            },
            {
              "type": "text",
              "text": "? "
            },
            {
              "type": "math",
              "tex": "\\vec{Q} = \\vec{P} + \\lambda \\vec{v} \\implies",
              "speech": "Vektor Q gleich Vektor P plus Lambda mal Vektor v, daraus folgt"
            },
            {
              "type": "text",
              "text": " Einsetzen und Prüfen, ob alle drei Koordinatengleichungen denselben Parameter "
            },
            {
              "type": "math",
              "tex": "\\lambda",
              "speech": "Lambda"
            },
            {
              "type": "text",
              "text": " liefern, 3. Die 4 gegenseitigen Lagebeziehungen zweier Geraden "
            },
            {
              "type": "math",
              "tex": "g",
              "speech": "g"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "h",
              "speech": "h"
            },
            {
              "type": "text",
              "text": ":   * 1. Identisch ("
            },
            {
              "type": "math",
              "tex": "g = h",
              "speech": "g gleich h"
            },
            {
              "type": "text",
              "text": "): Richtungsvektoren kollinear ("
            },
            {
              "type": "math",
              "tex": "\\vec{v}_g = k \\cdot \\vec{v}_h",
              "speech": "Vektor v g gleich k mal Vektor v h"
            },
            {
              "type": "text",
              "text": ") UND Stützpunkt "
            },
            {
              "type": "math",
              "tex": "P_g",
              "speech": "P g"
            },
            {
              "type": "text",
              "text": " liegt auf "
            },
            {
              "type": "math",
              "tex": "h",
              "speech": "h"
            },
            {
              "type": "text",
              "text": ".   * 2. Echt parallel ("
            },
            {
              "type": "math",
              "tex": "g \\parallel h",
              "speech": "g parallel zu h"
            },
            {
              "type": "text",
              "text": "): Richtungsvektoren kollinear UND Stützpunkt "
            },
            {
              "type": "math",
              "tex": "P_g",
              "speech": "P g"
            },
            {
              "type": "text",
              "text": " liegt nicht auf "
            },
            {
              "type": "math",
              "tex": "h",
              "speech": "h"
            },
            {
              "type": "text",
              "text": ".   * 3. Schneidend ("
            },
            {
              "type": "math",
              "tex": "g \\cap h = \\{S\\}",
              "speech": "g geschnitten mit h gleich die Menge aus S"
            },
            {
              "type": "text",
              "text": "): Richtungsvektoren nicht kollinear UND Gleichsetzen "
            },
            {
              "type": "math",
              "tex": "g = h",
              "speech": "g gleich h"
            },
            {
              "type": "text",
              "text": " liefert genau eine eindeutige Lösung "
            },
            {
              "type": "math",
              "tex": "(\\lambda, \\mu)",
              "speech": "Lambda und My"
            },
            {
              "type": "text",
              "text": ".   * 4. Windschief: Richtungsvektoren nicht kollinear UND Gleichsetzen "
            },
            {
