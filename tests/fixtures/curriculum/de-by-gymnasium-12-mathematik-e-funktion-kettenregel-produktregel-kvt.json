          "sample_solution": [
            {
              "type": "text",
              "text": "1. Uneigentliche Integrale und Konvergenz: - Ein Integral heißt uneigentlich, wenn mindestens eine Integrationsgrenze unendlich ist ("
            },
            {
              "type": "math",
              "tex": "\\pm\\infty"
            },
            {
              "type": "text",
              "text": ") oder der Integrand an einer Stelle im Intervall eine Polstelle/Definitionslücke besitzt. - Berechnung über Limesbildung:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\int_0^\\infty f(x)\\,\\mathrm{d}x = \\lim_{z \\to \\infty} \\left[ F(x) \\right]_0^z = \\lim_{z \\to \\infty} (F(z) - F(0))}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Berechnung der Fläche für "
            },
            {
              "type": "math",
              "tex": "f(x) = 2 \\cdot e^{-0{,}5 x}"
            },
            {
              "type": "text",
              "text": ": - Stammfunktion: "
            },
            {
              "type": "math",
              "tex": "F(x) = \\int 2 \\cdot e^{-0{,}5 x}\\,\\mathrm{d}x = 2 \\cdot \\frac{1}{-0{,}5} e^{-0{,}5 x} = \\mathbf{-4 \\cdot e^{-0{,}5 x}}"
            },
            {
              "type": "text",
              "text": ". - Flächenberechnung:   "
            },
            {
              "type": "math",
              "tex": "\\begin{aligned}     A &= \\int_0^\\infty 2\\cdot e^{-0{,}5 x}\\,\\mathrm{d}x = \\lim_{z \\to \\infty} \\left[ -4 e^{-0{,}5 x} \\right]_0^z \\\\       &= \\lim_{z \\to \\infty} \\left( -4 e^{-0{,}5 z} - (-4 e^0) \\right) \\\\       &= \\lim_{z \\to \\infty} \\left( -\\frac{4}{e^{0{,}5 z}} + 4 \\right) = 0 + 4 = \\mathbf{4\\,\\text{Flächeneinheiten (FE)}}   \\end{aligned}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Berechnung des Rotationsvolumens "
            },
            {
              "type": "math",
              "tex": "V_x"
            },
            {
              "type": "text",
              "text": ": - Für die Rotation um die "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse quadrieren wir die Funktion:   "
            },
            {
              "type": "math",
              "tex": "[f(x)]^2 = (2 \\cdot e^{-0{,}5 x})^2 = 4 \\cdot (e^{-0{,}5 x})^2 = \\mathbf{4 \\cdot e^{-x}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Berechnung des uneigentlichen Rotationsvolumens:   "
            },
            {
              "type": "math",
              "tex": "\\begin{aligned}     V_x &= \\pi \\int_0^\\infty [f(x)]^2\\,\\mathrm{d}x = \\pi \\lim_{z \\to \\infty} \\int_0^z 4 e^{-x}\\,\\mathrm{d}x \\\\         &= 4\\pi \\lim_{z \\to \\infty} \\left[ -e^{-x} \\right]_0^z \\\\         &= 4\\pi \\lim_{z \\to \\infty} \\left( -e^{-z} - (-e^0) \\right) \\\\         &= 4\\pi \\lim_{z \\to \\infty} \\left( -\\frac{1}{e^z} + 1 \\right) = 4\\pi \\cdot (0 + 1) = \\mathbf{4\\pi \\approx 12{,}566\\,\\text{Volumeneinheiten (VE)}}   \\end{aligned}",
              "block": true
            }
          ],
          "materiality": "cosmetic"
        }
      ]
