          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Untersuche die Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = (x^2 - 4) \\cdot e^{-x}",
              "speech": "f von x gleich Klammer auf x Quadrat minus 4 Klammer zu mal e hoch minus x"
            },
            {
              "type": "text",
              "text": " auf ihrem maximalen Definitionsbereich "
            },
            {
              "type": "math",
              "tex": "\\mathbb{D} = \\mathbb{R}",
              "speech": "D gleich R"
            },
            {
              "type": "text",
              "text": ": 1. Bestimme alle Nullstellen von "
            },
            {
              "type": "math",
              "tex": "f(x)",
              "speech": "f von x"
            },
            {
              "type": "text",
              "text": ", 2. Berechne die 1. und 2. Ableitung "
            },
            {
              "type": "math",
              "tex": "f'(x)",
              "speech": "f Strich von x"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "f''(x)",
              "speech": "f Strich Strich von x"
            },
            {
              "type": "text",
              "text": " unter Ausklammern von "
            },
            {
              "type": "math",
              "tex": "e^{-x}",
              "speech": "e hoch minus x"
            },
            {
              "type": "text",
              "text": ", 3. Ermittle alle lokalen Extrempunkte (Hoch-/Tiefpunkte mit "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "- und "
            },
            {
              "type": "math",
              "tex": "y",
              "speech": "y"
            },
            {
              "type": "text",
              "text": "-Koordinaten sowie Nachweis über "
            },
            {
              "type": "math",
              "tex": "f''",
              "speech": "f Strich Strich"
            },
            {
              "type": "text",
              "text": "), 4. Untersuche das Grenzverhalten für "
            },
            {
              "type": "math",
              "tex": "x \\to +\\infty",
              "speech": "x gegen plus unendlich"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "x \\to -\\infty",
              "speech": "x gegen minus unendlich"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Kurvendiskussion e-Funktion: Nullstellen "
            },
            {
              "type": "math",
              "tex": "x_1 = 2",
              "speech": "x eins gleich 2"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "x_2 = -2",
              "speech": "x zwei gleich minus 2"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "f'(x) = (-x^2 + 2x + 4) \\cdot e^{-x}",
              "speech": "f Strich von x gleich Klammer auf minus x Quadrat plus 2 x plus 4 Klammer zu mal e hoch minus x"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "f''(x) = (x^2 - 4x + 2) \\cdot e^{-x}",
              "speech": "f Strich Strich von x gleich Klammer auf x Quadrat minus 4 x plus 2 Klammer zu mal e hoch minus x"
            },
            {
              "type": "text",
              "text": "; Extremstellen "
            },
            {
              "type": "math",
              "tex": "x = 1 \\pm \\sqrt{5}",
              "speech": "x gleich 1 plus minus Wurzel aus 5"
            },
            {
              "type": "text",
              "text": "; Grenzwerte: "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to +\\infty} f(x) = 0",
              "speech": "Limes für x gegen plus unendlich f von x gleich 0"
            },
            {
              "type": "text",
              "text": " (Dominanz der e-Funktion), "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to -\\infty} f(x) = +\\infty",
              "speech": "Limes für x gegen minus unendlich f von x gleich plus unendlich"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Nullstellen von "
            },
            {
              "type": "math",
              "tex": "f(x)"
            },
            {
              "type": "text",
              "text": ": - Ansatz: "
            },
            {
              "type": "math",
              "tex": "f(x) = 0 \\iff (x^2 - 4) \\cdot e^{-x} = 0"
            },
            {
              "type": "text",
              "text": ". - Da "
            },
            {
              "type": "math",
              "tex": "e^{-x} > 0"
            },
            {
              "type": "text",
              "text": " für alle "
            },
            {
              "type": "math",
              "tex": "x \\in \\mathbb{R}"
            },
            {
              "type": "text",
              "text": ", kann nur der Klammerausdruck Null werden:   "
            },
            {
              "type": "math",
              "tex": "x^2 - 4 = 0 \\implies x^2 = 4 \\implies \\mathbf{x_1 = 2, \\quad x_2 = -2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Die Schnittpunkte mit der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse lauten "
            },
            {
              "type": "math",
              "tex": "N_1(2|0)"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "N_2(-2|0)"
            },
            {
              "type": "text",
              "text": ". 2. Ableitungen mit Produkt- und Kettenregel: - Für "
            },
            {
              "type": "math",
              "tex": "f(x) = u(x) \\cdot v(x)"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "u(x) = x^2 - 4 \\implies u'(x) = 2x"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "v(x) = e^{-x} \\implies v'(x) = -e^{-x}"
            },
            {
              "type": "text",
              "text": ": - 1. Ableitung "
            },
            {
              "type": "math",
              "tex": "f'(x)"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\begin{aligned}     f'(x) &= u'(x) \\cdot v(x) + u(x) \\cdot v'(x) \\\\           &= 2x \\cdot e^{-x} + (x^2 - 4) \\cdot (-e^{-x}) \\\\           &= e^{-x} \\cdot \\left[ 2x - (x^2 - 4) \\right] = \\mathbf{(-x^2 + 2x + 4) \\cdot e^{-x}}   \\end{aligned}",
              "block": true
            },
            {
              "type": "text",
              "text": " - 2. Ableitung "
            },
            {
              "type": "math",
              "tex": "f''(x)"
            },
            {
              "type": "text",
              "text": ":   * Mit "
            },
            {
              "type": "math",
              "tex": "u_1(x) = -x^2 + 2x + 4 \\implies u_1'(x) = -2x + 2"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "v_1(x) = e^{-x} \\implies v_1'(x) = -e^{-x}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\begin{aligned}     f''(x) &= (-2x + 2) \\cdot e^{-x} + (-x^2 + 2x + 4) \\cdot (-e^{-x}) \\\\           &= e^{-x} \\cdot \\left[ -2x + 2 + x^2 - 2x - 4 \\right] = \\mathbf{(x^2 - 4x - 2) \\cdot e^{-x}}   \\end{aligned}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Lokale Extrempunkte: - Notwendige Bedingung: "
            },
            {
              "type": "math",
              "tex": "f'(x) = 0 \\iff -x^2 + 2x + 4 = 0 \\iff x^2 - 2x - 4 = 0"
            },
            {
              "type": "text",
              "text": ". - Mit Mitternachtsformel:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{x_{1,2} = \\frac{2 \\pm \\sqrt{4 - 4(1)(-4)}}{2} = \\frac{2 \\pm \\sqrt{20}}{2} = 1 \\pm \\sqrt{5}} \\quad (x_1 \\approx 3{,}236; \\; x_2 \\approx -1{,}236)",
              "block": true
            },
            {
              "type": "text",
              "text": " - Hinreichende Bedingung über "
            },
            {
              "type": "math",
              "tex": "f''(x)"
            },
            {
              "type": "text",
              "text": ":   * Für "
            },
            {
              "type": "math",
              "tex": "x_1 = 1 + \\sqrt{5}"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "f''(1+\\sqrt{5}) = ((1+\\sqrt{5})^2 - 4(1+\\sqrt{5}) - 2) \\cdot e^{-(1+\\sqrt{5})} = (6 + 2\\sqrt{5} - 4 - 4\\sqrt{5} - 2) \\cdot e^{-(1+\\sqrt{5})} = -2\\sqrt{5} \\cdot e^{-(1+\\sqrt{5})} < 0",
              "block": true
            },
            {
              "type": "text",
              "text": "     "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Lokales Maximum (Hochpunkt) bei "
            },
            {
              "type": "math",
              "tex": "x_1 = 1 + \\sqrt{5}"
            },
            {
              "type": "text",
              "text": ".   * Für "
            },
            {
              "type": "math",
              "tex": "x_2 = 1 - \\sqrt{5}"
            },
            {
              "type": "text",
              "text": ":     "
            },
            {
              "type": "math",
              "tex": "f''(1-\\sqrt{5}) = +2\\sqrt{5} \\cdot e^{-(1-\\sqrt{5})} > 0 \\implies \\mathbf{\\text{Lokales Minimum (Tiefpunkt)}} \\text{ bei } x_2 = 1 - \\sqrt{5}.",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Grenzverhalten an den Rändern: - Für "
            },
            {
              "type": "math",
              "tex": "x \\to +\\infty"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to +\\infty} (x^2 - 4) \\cdot e^{-x} = \\lim_{x \\to +\\infty} \\frac{x^2 - 4}{e^x} = \\mathbf{0}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (Die e-Funktion wächst im Nenner asymptotisch viel schneller als jedes Polynom "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Die "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse "
            },
            {
              "type": "math",
              "tex": "y = 0"
            },
            {
              "type": "text",
              "text": " ist waagrechte Asymptote für "
            },
            {
              "type": "math",
              "tex": "x \\to +\\infty"
            },
            {
              "type": "text",
              "text": "). - Für "
            },
            {
              "type": "math",
              "tex": "x \\to -\\infty"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\lim_{x \\to -\\infty} (x^2 - 4) \\cdot e^{-x} = (+\\infty) \\cdot (+\\infty) = \\mathbf{+\\infty}",
              "block": true
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
