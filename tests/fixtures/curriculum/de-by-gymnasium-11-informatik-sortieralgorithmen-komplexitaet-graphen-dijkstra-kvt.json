          "question_segments": [
            {
              "type": "text",
              "text": "Welche asymptotische Zeitkomplexität (O-Notation) besitzt der Mergesort-Algorithmus im Worst-Case, Average-Case und Best-Case bei "
            },
            {
              "type": "math",
              "tex": "n",
              "speech": "n"
            },
            {
              "type": "text",
              "text": " Eingabeelementen?"
            }
          ],
          "concept": "O(n * log n) in allen drei Fällen (durch deterministische Teilung in zwei Hälften und lineares Mischen)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "O(n * log n) in allen Fällen",
              [
                {
                  "type": "math",
                  "tex": "O(n^2)",
                  "speech": "O von n Quadrat"
                }
              ]
            ],
