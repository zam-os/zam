      "title": "Lineare Funktionen: Steigung m, y-Achsenabschnitt t, Nullstellen und Orthogonalitätsbedingung",
      "domain": "mathematik/funktionen",
      "reduction": "formal",
      "typical_age_min": 13.5,
      "prerequisites": [],
      "alignments": [
        {
          "target_uri": "http://www.wikidata.org/entity/Q12483",
