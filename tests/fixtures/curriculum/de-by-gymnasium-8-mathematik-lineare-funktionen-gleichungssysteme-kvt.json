        }
      ],
      "practice_items": [
        {
          "id": "01K8G8A0000000000000000J01",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Welche Steigung "
            },
            {
              "type": "math",
              "tex": "m_2",
              "speech": "m zwei"
            },
            {
              "type": "text",
              "text": " muss eine Gerade "
            },
            {
              "type": "math",
              "tex": "g_2",
              "speech": "g zwei"
            },
            {
              "type": "text",
              "text": " besitzen, damit sie orthogonal (senkrecht) auf der Geraden "
            },
            {
              "type": "math",
              "tex": "g_1: y = 2x - 5",
              "speech": "g eins: y gleich 2 x minus 5"
            },
            {
              "type": "text",
              "text": " steht?"
            }
          ],
          "concept": "m2 = -1/2 (Orthogonalitätsbedingung: m1 * m2 = -1)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "m2 = -1/2",
              "m2 = 2"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8G8A0000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere lineare Funktionen in der Normalform "
            },
            {
              "type": "math",
              "tex": "f(x) = m \\cdot x + t",
              "speech": "f von x gleich m mal x plus t"
            },
            {
              "type": "text",
              "text": ": 1. Bedeutung der Parameter:   * Steigung "
            },
            {
              "type": "math",
              "tex": "m",
              "speech": "m"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "m = \\frac{\\Delta y}{\\Delta x} = \\frac{y_2 - y_1}{x_2 - x_1}",
              "speech": "m gleich Delta y durch Delta x gleich Bruch: y zwei minus y eins, durch x zwei minus x eins"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "m > 0",
              "speech": "m größer als 0"
            },
            {
              "type": "text",
              "text": ": streng monoton steigend; "
            },
            {
              "type": "math",
              "tex": "m < 0",
              "speech": "m kleiner als 0"
            },
            {
              "type": "text",
              "text": ": fallend; "
            },
            {
              "type": "math",
              "tex": "m = 0",
              "speech": "m gleich 0"
            },
            {
              "type": "text",
              "text": ": konstante waagrechte Gerade).   * "
            },
            {
              "type": "math",
              "tex": "y",
              "speech": "y"
            },
            {
              "type": "text",
              "text": "-Achsenabschnitt "
            },
            {
              "type": "math",
              "tex": "t",
              "speech": "t"
            },
            {
              "type": "text",
              "text": ": Schnittpunkt mit der Ordinate "
            },
            {
              "type": "math",
              "tex": "S_y(0 \\mid t)",
              "speech": "S y mit den Koordinaten 0 und t"
            },
            {
              "type": "text",
              "text": ", 2. Nullstelle "
            },
            {
              "type": "math",
              "tex": "x_0",
              "speech": "x null"
            },
            {
              "type": "text",
              "text": ": Ansatz "
            },
            {
              "type": "math",
              "tex": "f(x) = 0 \\implies m \\cdot x_0 + t = 0 \\implies x_0 = -\\frac{t}{m}",
              "speech": "f von x gleich 0, daraus folgt m mal x null plus t gleich 0, daraus folgt x null gleich minus t durch m"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "m \\neq 0",
              "speech": "m ungleich 0"
            },
            {
              "type": "text",
              "text": "), 3. Lagebeziehungen zweier Geraden:   * Parallelität: "
            },
            {
              "type": "math",
              "tex": "g_1 \\parallel g_2 \\iff m_1 = m_2",
              "speech": "g eins parallel zu g zwei genau dann, wenn m eins gleich m zwei"
            },
            {
              "type": "text",
              "text": " (bei "
            },
            {
              "type": "math",
              "tex": "t_1 \\neq t_2",
              "speech": "t eins ungleich t zwei"
            },
            {
              "type": "text",
              "text": " echt parallel, bei "
            },
            {
              "type": "math",
              "tex": "t_1 = t_2",
              "speech": "t eins gleich t zwei"
            },
            {
              "type": "text",
              "text": " identisch).   * Orthogonalität (senkrechter Schnitt): "
            },
            {
              "type": "math",
              "tex": "g_1 \\perp g_2 \\iff m_1 \\cdot m_2 = -1 \\iff m_2 = -\\frac{1}{m_1}",
              "speech": "g eins senkrecht zu g zwei genau dann, wenn m eins mal m zwei gleich minus 1 genau dann, wenn m zwei gleich minus 1 durch m eins"
            },
            {
              "type": "text",
              "text": ", 4. Bestimme die Funktionsgleichung der Geraden "
            },
            {
              "type": "math",
              "tex": "g",
              "speech": "g"
            },
            {
              "type": "text",
              "text": ", die durch "
            },
            {
              "type": "math",
              "tex": "P(3 \\mid 1)",
              "speech": "Punkt P mit den Koordinaten 3 und 1"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "Q(-1 \\mid -7)",
              "speech": "Punkt Q mit den Koordinaten minus 1 und minus 7"
            },
            {
              "type": "text",
              "text": " verläuft."
            }
          ],
          "concept": "Lineare Funktion: f(x) = mx + t; m = Delta y / Delta x; t = y-Achsenabschnitt; Nullstelle x0 = -t/m; Parallel (m1=m2) vs. Orthogonal (m1*m2 = -1); Rechnung: m = (-7 - 1)/(-1 - 3) = -8/-4 = 2; 1 = 2*3 + t -> t = -5 -> g: y = 2x - 5.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Die Normalform der linearen Funktion "
            },
            {
              "type": "math",
              "tex": "f(x) = m \\cdot x + t"
            },
            {
              "type": "text",
              "text": ": - 1. Steigung "
            },
            {
              "type": "math",
              "tex": "m"
            },
            {
              "type": "text",
              "text": ":   * Beschreibt die Änderungsrate und wird über das Steigungsdreieck berechnet:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{m = \\frac{\\Delta y}{\\Delta x} = \\frac{y_2 - y_1}{x_2 - x_1}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "m > 0"
            },
            {
              "type": "text",
              "text": ": Graph steigt von links unten nach rechts oben (Monotoniewachstum).   * "
            },
            {
              "type": "math",
              "tex": "m < 0"
            },
            {
              "type": "text",
              "text": ": Graph fällt von links oben nach rechts unten.   * "
            },
            {
              "type": "math",
              "tex": "m = 0"
            },
            {
              "type": "text",
              "text": ": Parallele zur "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse ("
            },
            {
              "type": "math",
              "tex": "f(x) = t"
            },
            {
              "type": "text",
              "text": "). - 2. "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achsenabschnitt "
            },
            {
              "type": "math",
              "tex": "t"
            },
            {
              "type": "text",
              "text": ":   * Wert der Funktion an der Stelle "
            },
            {
              "type": "math",
              "tex": "x = 0 \\implies"
            },
            {
              "type": "text",
              "text": " Schnittpunkt mit der "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achse ist "
            },
            {
              "type": "math",
              "tex": "\\mathbf{S_y(0 \\mid t)}"
            },
            {
              "type": "text",
              "text": ". 2. Berechnung der Nullstelle "
            },
            {
              "type": "math",
              "tex": "x_0"
            },
            {
              "type": "text",
              "text": ": - Die Nullstelle ist die Schnittstelle des Graphen mit der "
            },
            {
              "type": "math",
              "tex": "x"
            },
            {
              "type": "text",
              "text": "-Achse:   "
            },
            {
              "type": "math",
              "tex": "f(x_0) = 0 \\iff m \\cdot x_0 + t = 0 \\iff \\mathbf{x_0 = -\\frac{t}{m}} \\quad (m \\neq 0)",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Relative Lage zweier Geraden in der Ebene: - Parallelität: Zwei Geraden sind genau dann parallel, wenn ihre Steigungen übereinstimmen:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{g_1 \\parallel g_2 \\iff m_1 = m_2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Orthogonalität (Senkrecht): Zwei Geraden stehen genau dann senkrecht aufeinander, wenn das Produkt ihrer Steigungen "
            },
            {
              "type": "math",
              "tex": "-1"
            },
            {
              "type": "text",
              "text": " ergibt (negative Kehrwerte):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{g_1 \\perp g_2 \\iff m_1 \\cdot m_2 = -1 \\iff m_2 = -\\frac{1}{m_1}}",
              "block": true
            },
            {
              "type": "text",
              "text": " 4. Bestimmung der Geradengleichung durch zwei Punkte "
            },
            {
              "type": "math",
              "tex": "P(3 \\mid 1)"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "Q(-1 \\mid -7)"
            },
            {
              "type": "text",
              "text": ": - Schritt 1: Steigung "
            },
            {
              "type": "math",
              "tex": "m"
            },
            {
              "type": "text",
              "text": " berechnen:   "
            },
            {
              "type": "math",
              "tex": "m = \\frac{y_Q - y_P}{x_Q - x_P} = \\frac{-7 - 1}{-1 - 3} = \\frac{-8}{-4} = \\mathbf{2}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: "
            },
            {
              "type": "math",
              "tex": "y"
            },
            {
              "type": "text",
              "text": "-Achsenabschnitt "
            },
            {
              "type": "math",
              "tex": "t"
            },
            {
              "type": "text",
              "text": " bestimmen (Punktprobe mit "
            },
            {
              "type": "math",
              "tex": "P(3 \\mid 1)"
            },
            {
              "type": "text",
              "text": "):   "
            },
            {
              "type": "math",
              "tex": "y = m \\cdot x + t \\implies 1 = 2 \\cdot 3 + t \\implies 1 = 6 + t \\implies \\mathbf{t = -5}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Funktionsgleichung: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{g: y = 2x - 5}"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
    {
      "id": "01K8G8A0000000000000000A02",
