      "practice_items": [
        {
          "id": "01K4P7M0000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Ein Astronaut hat auf der Erde eine Masse von "
            },
            {
              "type": "math",
              "tex": "80\\text{ kg}",
              "speech": "80 Kilogramm"
            },
            {
              "type": "text",
              "text": ". Wie groß ist seine Masse auf dem Mond (wo die Schwerkraft nur ein Sechstel beträgt)?"
            }
          ],
          "concept": "Exakt 80 kg, da die Masse eine ortsunabhängige Stoffeigenschaft ist (nur die Gewichtskraft sinkt auf dem Mond auf ca. 130 N)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "Exakt 80 kg (Masse bleibt überall konstant)",
              "Nur ca. 13,3 kg"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K4P7M0000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Differenziere die fundamentalen Größen der Mechanik: 1. Masse "
            },
            {
              "type": "math",
              "tex": "m",
              "speech": "m"
            },
            {
              "type": "text",
              "text": " vs. Gewichtskraft "
            },
            {
              "type": "math",
              "tex": "F_G",
              "speech": "F G"
            },
            {
              "type": "text",
              "text": ": Masse ist eine universelle Körpereigenschaft (Trägheit und Materiemenge, Einheit "
            },
            {
              "type": "math",
              "tex": "\\text{kg}",
              "speech": "Kilogramm"
            },
            {
              "type": "text",
              "text": "); Gewichtskraft "
            },
            {
              "type": "math",
              "tex": "F_G = m \\cdot g",
              "speech": "F G gleich m mal g"
            },
            {
              "type": "text",
              "text": " ist ortsabhängig (Erde: "
            },
            {
              "type": "math",
              "tex": "g \\approx 9,81\\text{ N/kg}",
              "speech": "g ungefähr 9,81 Newton pro Kilogramm"
            },
            {
              "type": "text",
              "text": ", Mond: "
            },
            {
              "type": "math",
              "tex": "g_{\\text{Mond}} \\approx 1,62\\text{ N/kg}",
              "speech": "g Mond ungefähr 1,62 Newton pro Kilogramm"
            },
            {
              "type": "text",
              "text": "), 2. Dichte "
            },
            {
              "type": "math",
              "tex": "\\rho",
              "speech": "Rho"
            },
            {
              "type": "text",
              "text": ": Stoffspezifische Masse pro Volumeneinheit: "
            },
            {
              "type": "math",
              "tex": "\\rho = \\frac{m}{V}",
              "speech": "Rho gleich m durch V"
            },
            {
              "type": "text",
              "text": " (Wasser: "
            },
            {
              "type": "math",
              "tex": "\\rho = 1,0\\text{ g/cm}^3 = 1000\\text{ kg/m}^3",
              "speech": "Rho gleich 1,0 Gramm pro Kubikzentimeter gleich 1000 Kilogramm pro Kubikmeter"
            },
            {
              "type": "text",
              "text": "), 3. Druck "
            },
            {
              "type": "math",
              "tex": "p",
              "speech": "p"
            },
            {
              "type": "text",
              "text": ": Senkrecht auf eine Fläche "
            },
            {
              "type": "math",
              "tex": "A",
              "speech": "A"
            },
            {
              "type": "text",
              "text": " wirkende Kraft: "
            },
            {
              "type": "math",
              "tex": "p = \\frac{F}{A}",
              "speech": "p gleich F durch A"
            },
            {
              "type": "text",
              "text": " (Einheit Pascal "
            },
            {
              "type": "math",
              "tex": "[\\text{Pa}] = [\\text{N/m}^2]",
              "speech": "Einheit Pascal gleich Newton pro Quadratmeter"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "1\\text{ bar} = 100.000\\text{ Pa} = 1000\\text{ hPa}",
              "speech": "1 bar gleich 100.000 Pascal gleich 1000 Hektopascal"
            },
            {
              "type": "text",
              "text": "), 4. Hydrostatischer Schweredruck in Flüssigkeiten: "
            },
            {
              "type": "math",
              "tex": "p(h) = \\rho \\cdot g \\cdot h",
              "speech": "p von h gleich Rho mal g mal h"
            },
            {
              "type": "text",
              "text": " (nimmt linear mit der Eintauchtiefe zu)."
            }
          ],
          "concept": "Masse (ortsungebunden, kg) vs. Gewichtskraft (Fg = m * g, N); Dichte rho = m / V; Druck p = F / A in Pascal (N/m²); Schweredruck p = rho * g * h.",
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Der fundamentale Unterschied: Masse vs. Gewichtskraft: - Masse "
            },
            {
              "type": "math",
              "tex": "m"
            },
            {
              "type": "text",
              "text": " (Skalar, Einheit "
            },
            {
              "type": "math",
              "tex": "[\\text{kg}]"
            },
            {
              "type": "text",
              "text": "):   * Maß für die Trägheit und die Menge an Materie eines Körpers.   * Ortsunabhängige Invariante: Bleibt auf der Erde, auf dem Mond und im schwerelosen Weltall absolut identisch. - Gewichtskraft "
            },
            {
              "type": "math",
              "tex": "F_G"
            },
            {
              "type": "text",
              "text": " (Vektor, Einheit "
            },
            {
              "type": "math",
              "tex": "[\\text{N}]"
            },
            {
              "type": "text",
              "text": "):   * Die Kraft, mit der ein Himmelskörper eine Masse gravitativ anzieht:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{F_G = m \\cdot g}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Ortsabhängig: Hängt vom lokalen Ortsfaktor (Schwerebeschleunigung "
            },
            {
              "type": "math",
              "tex": "g"
            },
            {
              "type": "text",
              "text": ") ab:     - Erde (Mitteleuropa): "
            },
            {
              "type": "math",
              "tex": "g_{\\text{Erde}} \\approx 9,81\\text{ N/kg}"
            },
            {
              "type": "text",
              "text": " (eine Masse von "
            },
            {
              "type": "math",
              "tex": "100\\text{ g}"
            },
            {
              "type": "text",
              "text": " wiegt ca. "
            },
            {
              "type": "math",
              "tex": "1\\text{ N}"
            },
            {
              "type": "text",
              "text": ").     - Mond: "
            },
            {
              "type": "math",
              "tex": "g_{\\text{Mond}} \\approx 1,62\\text{ N/kg} \\approx \\frac{1}{6} g_{\\text{Erde}}"
            },
            {
              "type": "text",
              "text": ".     - Jupiter: "
            },
            {
              "type": "math",
              "tex": "g_{\\text{Jupiter}} \\approx 24,8\\text{ N/kg}"
            },
            {
              "type": "text",
              "text": ". 2. Die Dichte "
            },
            {
              "type": "math",
              "tex": "\\rho"
            },
            {
              "type": "text",
              "text": " (Stoffspezifische Größe): - Gibt an, wie viel Masse in einem bestimmten Volumen "
            },
            {
              "type": "math",
              "tex": "V"
            },
            {
              "type": "text",
              "text": " gepackt ist:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\rho = \\frac{m}{V}} \\qquad \\left[\\frac{\\text{g}}{\\text{cm}^3}\\right] \\text{ bzw. } \\left[\\frac{\\text{kg}}{\\text{m}^3}\\right]",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Umrechnung: "
            },
            {
              "type": "math",
              "tex": "1\\text{ g/cm}^3 = 1000\\text{ kg/m}^3"
            },
            {
              "type": "text",
              "text": ".   * Beispiele: Gold "
            },
            {
              "type": "math",
              "tex": "19,3\\text{ g/cm}^3"
            },
            {
              "type": "text",
              "text": ", Eisen "
            },
            {
              "type": "math",
              "tex": "7,87\\text{ g/cm}^3"
            },
            {
              "type": "text",
              "text": ", Aluminium "
            },
            {
              "type": "math",
              "tex": "2,7\\text{ g/cm}^3"
            },
            {
              "type": "text",
              "text": ", Wasser "
            },
            {
              "type": "math",
              "tex": "1,00\\text{ g/cm}^3"
            },
            {
              "type": "text",
              "text": ", Luft "
            },
            {
              "type": "math",
              "tex": "\\approx 1,2\\text{ kg/m}^3"
            },
            {
              "type": "text",
              "text": ".   * Auftriebsprinzip: Ein Körper schwimmt in einer Flüssigkeit, wenn seine mittlere Dichte kleiner als die Dichte der Flüssigkeit ist ("
            },
            {
              "type": "math",
              "tex": "\\rho_{\\text{Körper}} < \\rho_{\\text{Flüssigkeit}}"
            },
            {
              "type": "text",
              "text": "). 3. Der physikalische Druck "
            },
            {
              "type": "math",
              "tex": "p"
            },
            {
              "type": "text",
              "text": ": - Definiert als Quotient aus der senkrecht wirkenden Kraft "
            },
            {
              "type": "math",
              "tex": "F"
            },
            {
              "type": "text",
              "text": " und der Fläche "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{p = \\frac{F}{A}} \\qquad \\left[\\text{Pa} = \\frac{\\text{N}}{\\text{m}^2}\\right]",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "1\\text{ hPa} = 100\\text{ Pa}"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "1\\text{ bar} = 100.000\\text{ Pa} = 10^5\\text{ N/m}^2"
            },
            {
              "type": "text",
              "text": ". - Hydrostatischer Schweredruck in Flüssigkeiten:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{p_{\\text{hydr}} = \\rho \\cdot g \\cdot h}",
              "block": true
            },
            {
              "type": "text",
              "text": "   (In Wasser steigt der Druck alle 10 Meter Tiefe um rund "
            },
            {
              "type": "math",
              "tex": "1\\text{ bar}"
            },
            {
              "type": "text",
              "text": " an). "
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    }
  ]
