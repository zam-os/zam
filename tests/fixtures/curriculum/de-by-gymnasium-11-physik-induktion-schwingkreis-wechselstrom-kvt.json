              "type": "math",
              "tex": "\\mathbf{T = \\frac{2\\pi}{\\omega_0} = 2\\pi \\sqrt{L \\cdot C}} \\quad \\iff \\quad \\mathbf{f_0 = \\frac{1}{2\\pi \\sqrt{L \\cdot C}}}",
              "block": true
            },
