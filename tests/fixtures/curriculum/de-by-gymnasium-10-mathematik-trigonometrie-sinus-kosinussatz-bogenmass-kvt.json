          "question_segments": [
            {
              "type": "text",
              "text": "Welche Formel beschreibt den Kosinussatz zur Berechnung der Seite "
            },
            {
              "type": "math",
              "tex": "a",
              "speech": "a"
            },
            {
              "type": "text",
              "text": " im allgemeinen Dreieck "
            },
            {
              "type": "math",
              "tex": "\\triangle ABC",
              "speech": "Dreieck A B C"
            },
            {
              "type": "text",
              "text": " bei gegebenen Seiten "
            },
            {
              "type": "math",
              "tex": "b, c",
              "speech": "b, c"
            },
            {
              "type": "text",
              "text": " und eingeschlossenem Winkel "
            },
            {
              "type": "math",
              "tex": "\\alpha",
              "speech": "Alpha"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept_segments": [
            {
              "type": "math",
              "tex": "a^2 = b^2 + c^2 - 2 \\cdot b \\cdot c \\cdot \\cos(\\alpha)",
              "speech": "a Quadrat gleich b Quadrat plus c Quadrat minus 2 mal b mal c mal Kosinus von Alpha"
            }
          ],
          "fast_check": {
