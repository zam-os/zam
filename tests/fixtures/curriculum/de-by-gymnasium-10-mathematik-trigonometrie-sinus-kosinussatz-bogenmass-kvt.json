      "practice_items": [
        {
          "id": "01K8GA00000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie viel Radiant ("
            },
            {
              "type": "math",
              "tex": "rad",
              "speech": "Radiant"
            },
            {
              "type": "text",
              "text": ") im Bogenmaß entspricht einem vollen Winkel von "
            },
            {
              "type": "math",
              "tex": "360^\\circ",
              "speech": "360 Grad"
            },
            {
              "type": "text",
              "text": " am Einheitskreis?"
            }
          ],
          "concept": "2 * pi (ca. 6,283 rad; 180° entspricht pi rad, 90° entspricht pi/2 rad)",
          "fast_check": {
            "type": "binary_choice",
            "options": [
              "2 * pi (Kreisumfang des Einheitskreises)",
              "pi / 2"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GA00000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Erkläre den Übergang von geometrischen Winkeln zu reellen Winkelfunktionen am Einheitskreis: 1. Der Einheitskreis ("
            },
            {
              "type": "math",
              "tex": "r = 1",
              "speech": "r gleich 1"
            },
            {
              "type": "text",
              "text": "):   * Ein Zeiger vom Ursprung "
            },
            {
              "type": "math",
              "tex": "(0|0)",
              "speech": "Punkt null, null"
            },
            {
              "type": "text",
              "text": " schließt mit der positiven "
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": "-Achse den Winkel "
            },
            {
              "type": "math",
              "tex": "\\alpha",
              "speech": "Alpha"
            },
            {
              "type": "text",
              "text": " ein.   * Die Koordinaten des Kreis-Endpunktes definieren die Winkelfunktionen: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{P(\\cos \\alpha \\mid \\sin \\alpha)}",
              "speech": "Punkt P mit den Koordinaten Kosinus Alpha und Sinus Alpha"
            },
            {
              "type": "text",
              "text": ".   * Vorzeichen in den 4 Quadranten: Sinus positiv in Q1/Q2, negativ in Q3/Q4; Kosinus positiv in Q1/Q4, negativ in Q2/Q3, 2. Das Bogenmaß ("
            },
            {
              "type": "math",
              "tex": "x",
              "speech": "x"
            },
            {
              "type": "text",
              "text": " in Radiant / rad):   * Entspricht der Bogenlänge "
            },
            {
              "type": "math",
              "tex": "b",
              "speech": "b"
            },
            {
              "type": "text",
              "text": " auf dem Einheitskreis:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{x = \\frac{\\alpha}{180^\\circ} \\cdot \\pi} \\iff \\mathbf{\\alpha = \\frac{x}{\\pi} \\cdot 180^\\circ}",
              "block": true,
              "speech": "x gleich Alpha durch 180 Grad mal Pi genau dann, wenn Alpha gleich x durch Pi mal 180 Grad"
            },
            {
              "type": "text",
              "text": "   * Standardwerte: "
            },
            {
              "type": "math",
              "tex": "0^\\circ = 0",
              "speech": "0 Grad gleich 0"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "30^\\circ = \\frac{\\pi}{6}",
              "speech": "30 Grad gleich Pi durch 6"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "45^\\circ = \\frac{\\pi}{4}",
              "speech": "45 Grad gleich Pi durch 4"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "60^\\circ = \\frac{\\pi}{3}",
              "speech": "60 Grad gleich Pi durch 3"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "90^\\circ = \\frac{\\pi}{2}",
              "speech": "90 Grad gleich Pi durch 2"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "180^\\circ = \\pi",
              "speech": "180 Grad gleich Pi"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "270^\\circ = \\frac{3\\pi}{2}",
              "speech": "270 Grad gleich 3 Pi durch 2"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "360^\\circ = 2\\pi",
              "speech": "360 Grad gleich 2 Pi"
            },
            {
              "type": "text",
              "text": ", 3. Die allgemeine Sinusfunktion "
            },
            {
              "type": "math",
              "tex": "f(x) = a \\cdot \\sin(b(x - c)) + d",
              "speech": "f von x gleich a mal Sinus von b mal Klammer auf x minus c Klammer zu, plus d"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "|a|",
              "speech": "Betrag von a"
            },
            {
              "type": "text",
              "text": ": Amplitude (Ausschlag).   * "
            },
            {
              "type": "math",
              "tex": "b",
              "speech": "b"
            },
            {
              "type": "text",
              "text": ": Frequenzfaktor "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " Periode "
            },
            {
              "type": "math",
              "tex": "p = \\frac{2\\pi}{|b|}",
              "speech": "p gleich 2 Pi durch Betrag von b"
            },
