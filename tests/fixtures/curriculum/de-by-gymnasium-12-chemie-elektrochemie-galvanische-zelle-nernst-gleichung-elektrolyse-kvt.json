        {
          "id": "01K8GC70000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question": "Welches Funktionsprinzip ermöglicht die wiederholte elektrische Aufladung und Entladung moderner Lithium-Ionen-Akkumulatoren ohne metallische Zersetzung der Elektroden?",
          "concept": "Die reversible Interkalation (Einlagerung und Auslagerung) von Li+-Ionen in die Schichtgitter von Graphit (Anode) und Lithium-Metalloxiden (Kathode)",
          "fast_check": {
