          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Wie ändert sich die elektrische Feldenergie "
            },
            {
              "type": "math",
              "tex": "W_{\\text{el}} = \\frac{1}{2} C U^2",
              "speech": "W el gleich ein halb C U Quadrat"
            },
            {
              "type": "text",
              "text": " eines aufgeladenen, von der Spannungsquelle getrennten Kondensators ("
            },
            {
              "type": "math",
              "tex": "Q = \\text{konstant}",
              "speech": "Q gleich konstant"
            },
            {
              "type": "text",
              "text": "), wenn der Plattenabstand "
            },
            {
              "type": "math",
              "tex": "d",
              "speech": "d"
            },
            {
              "type": "text",
              "text": " verdoppelt wird?"
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Die Energie verdoppelt sich ("
            },
            {
              "type": "math",
              "tex": "W_{\\text{el}} = \\frac{Q^2}{2C}",
              "speech": "W el gleich Q Quadrat durch 2 C"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "C",
              "speech": "C"
            },
            {
              "type": "text",
              "text": " halbiert sich, da gegen die anziehende Coulomb-Kraft mechanische Trennarbeit verrichtet wird)"
            }
          ],
          "fast_check": {
