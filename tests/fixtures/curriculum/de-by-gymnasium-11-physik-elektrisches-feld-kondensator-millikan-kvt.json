        },
        {
          "id": "01K8GB40000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere das elektrische Feld und den Plattenkondensator: 1. Coulombsches Gesetz (Charles Augustin de Coulomb, 1785):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{F_C = \\frac{1}{4\\pi \\varepsilon_0 \\varepsilon_r} \\cdot \\frac{q_1 \\cdot q_2}{r^2}} \\quad (\\varepsilon_0 \\approx 8{,}854 \\cdot 10^{-12}\\,\\frac{\\text{A}\\cdot\\text{s}}{\\text{V}\\cdot\\text{m}})",
              "block": true,
              "speech": "F C gleich 1 durch 4 Pi Epsilon null Epsilon r mal q eins mal q zwei durch r Quadrat, mit Epsilon null ungefähr 8,854 mal 10 hoch minus 12 Amperesekunden pro Voltmeter"
            },
            {
              "type": "text",
              "text": " 2. Elektrische Feldstärke "
            },
            {
              "type": "math",
              "tex": "\\vec{E}",
              "speech": "Vektor E"
            },
            {
              "type": "text",
              "text": " & Potential "
            },
            {
              "type": "math",
              "tex": "\\varphi",
              "speech": "Phi"
            },
            {
              "type": "text",
              "text": ":   * "
            },
            {
              "type": "math",
              "tex": "\\vec{E} = \\frac{\\vec{F}}{q}",
              "speech": "Vektor E gleich Vektor F durch q"
            },
            {
              "type": "text",
              "text": " (Kraft pro Probeladung; Einheit: "
            },
            {
              "type": "math",
              "tex": "\\frac{\\text{N}}{\\text{C}} = \\frac{\\text{V}}{\\text{m}}",
              "speech": "Newton pro Coulomb gleich Volt pro Meter"
            },
            {
              "type": "text",
              "text": ").   * Im homogenen Feld eines Plattenkondensators mit Plattenabstand "
            },
            {
              "type": "math",
              "tex": "d",
              "speech": "d"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E = \\frac{U}{d}}",
              "speech": "E gleich U durch d"
            },
            {
              "type": "text",
              "text": ", 3. Der Plattenkondensator:   * Kapazität "
            },
            {
              "type": "math",
              "tex": "C",
              "speech": "C"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "C = \\frac{Q}{U} = \\varepsilon_0 \\cdot \\varepsilon_r \\cdot \\frac{A}{d}",
              "speech": "C gleich Q durch U gleich Epsilon null mal Epsilon r mal A durch d"
            },
            {
              "type": "text",
              "text": " (Einheit: "
            },
            {
              "type": "math",
              "tex": "1\\text{ Farad [F]} = 1\\,\\frac{\\text{C}}{\\text{V}}",
              "speech": "1 Farad gleich 1 Coulomb pro Volt"
            },
            {
              "type": "text",
              "text": ").   * Gespeicherte Feldenergie: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{W_{\\text{el}} = \\frac{1}{2} C U^2 = \\frac{1}{2} Q U = \\frac{Q^2}{2C}}",
              "speech": "W el gleich ein halb C U Quadrat gleich ein halb Q U gleich Q Quadrat durch 2 C"
            },
            {
              "type": "text",
              "text": ", 4. Ein Plattenkondensator mit Fläche "
            },
            {
              "type": "math",
              "tex": "A = 400\\,\\text{cm}^2",
              "speech": "A gleich 400 Quadratzentimeter"
            },
            {
              "type": "text",
              "text": " und Plattenabstand "
            },
            {
              "type": "math",
              "tex": "d = 2\\,\\text{mm}",
              "speech": "d gleich 2 Millimeter"
            },
            {
              "type": "text",
              "text": " im Vakuum ("
            },
            {
              "type": "math",
              "tex": "\\to \\varepsilon_r = 1",
              "speech": "also Epsilon r gleich 1"
            },
            {
              "type": "text",
              "text": ") ist an eine Spannung von "
            },
            {
              "type": "math",
              "tex": "U = 500\\,\\text{V}",
              "speech": "U gleich 500 Volt"
            },
            {
              "type": "text",
              "text": " angeschlossen. Berechne die Kapazität "
            },
            {
              "type": "math",
              "tex": "C",
              "speech": "C"
            },
            {
              "type": "text",
              "text": " und die elektrische Feldstärke "
            },
            {
              "type": "math",
              "tex": "E",
              "speech": "E"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Elektrisches Feld: Coulomb-Gesetz; Feldstärke "
            },
            {
              "type": "math",
              "tex": "E = \\frac{U}{d}",
              "speech": "E gleich U durch d"
            },
            {
              "type": "text",
              "text": "; Kapazität "
            },
            {
              "type": "math",
              "tex": "C = \\varepsilon_0 \\cdot \\varepsilon_r \\cdot \\frac{A}{d}",
              "speech": "C gleich Epsilon null mal Epsilon r mal A durch d"
            },
            {
              "type": "text",
              "text": "; Feldenergie "
            },
            {
              "type": "math",
              "tex": "W_{\\text{el}} = \\frac{1}{2} \\cdot C \\cdot U^2",
              "speech": "W el gleich ein halb mal C mal U Quadrat"
            },
            {
              "type": "text",
              "text": "; Rechnung: "
            },
            {
              "type": "math",
              "tex": "A = 0{,}04\\,\\text{m}^2",
              "speech": "A gleich 0,04 Quadratmeter"
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "math",
              "tex": "d = 0{,}002\\,\\text{m} \\Rightarrow C = \\frac{8{,}854 \\cdot 10^{-12} \\cdot 0{,}04}{0{,}002} = 1{,}77 \\cdot 10^{-10}\\,\\text{F} = 177\\,\\text{pF}",
              "speech": "d gleich 0,002 Meter, daraus folgt C gleich 8,854 mal 10 hoch minus 12 mal 0,04 durch 0,002 gleich 1,77 mal 10 hoch minus 10 Farad gleich 177 Pikofarad"
            },
            {
              "type": "text",
              "text": "; "
            },
            {
              "type": "math",
              "tex": "E = \\frac{500\\,\\text{V}}{0{,}002\\,\\text{m}} = 250.000\\,\\text{V/m} = 250\\,\\text{kV/m}",
              "speech": "E gleich 500 Volt durch 0,002 Meter gleich 250.000 Volt pro Meter gleich 250 Kilovolt pro Meter"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Das physikalische Konzept des elektrischen Feldes: - Ein Zustand des Raumes um elektrische Ladungen, der auf andere geladene Körper elektrostatische Kräfte ausübt. - 1. Das Coulombsche Gesetz (Punktladungen):   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{F_C = \\frac{1}{4\\pi \\varepsilon_0} \\cdot \\frac{|q_1 \\cdot q_2|}{r^2}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Gleiche Ladungen stoßen sich ab, ungleiche ziehen sich an. - 2. Elektrische Feldstärke "
            },
            {
              "type": "math",
              "tex": "\\vec{E}"
            },
            {
              "type": "text",
              "text": ":   * Vektorgröße, definiert als Quotient aus der Coulomb-Kraft "
            },
            {
              "type": "math",
              "tex": "\\vec{F}"
            },
            {
              "type": "text",
              "text": " auf eine positive Probeladung "
            },
            {
              "type": "math",
              "tex": "q"
            },
            {
              "type": "text",
              "text": " und der Ladung "
            },
            {
              "type": "math",
              "tex": "q"
            },
            {
              "type": "text",
              "text": " selbst:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{E} = \\frac{\\vec{F}}{q}} \\quad (\\text{Einheit: } 1\\,\\frac{\\text{N}}{\\text{C}} = 1\\,\\frac{\\text{V}}{\\text{m}})",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Feldlinien: Verlaufen stets von positiven Ladungen (Quellen) zu negativen Ladungen (Senken); stehen senkrecht auf leitenden Oberflächen und Äquipotentialflächen. 2. Der Plattenkondensator: - Besteht aus zwei parallelen leitenden Platten der Fläche "
            },
            {
              "type": "math",
              "tex": "A"
            },
            {
              "type": "text",
              "text": " im Abstand "
            },
            {
              "type": "math",
              "tex": "d"
            },
            {
              "type": "text",
              "text": ". Zwischen den Platten bildet sich ein homogenes elektrisches Feld aus:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E = \\frac{U}{d}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Kapazität "
            },
            {
              "type": "math",
              "tex": "C"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{C = \\frac{Q}{U} = \\varepsilon_0 \\cdot \\varepsilon_r \\cdot \\frac{A}{d}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * "
            },
            {
              "type": "math",
              "tex": "\\varepsilon_0 \\approx 8{,}854 \\cdot 10^{-12}\\,\\frac{\\text{F}}{\\text{m}}"
            },
            {
              "type": "text",
              "text": " (elektrische Feldkonstante).   * "
            },
            {
              "type": "math",
              "tex": "\\varepsilon_r"
            },
            {
              "type": "text",
              "text": ": Relative Permittivität des Dielektrikums zwischen den Platten (z. B. Luft "
            },
            {
              "type": "math",
              "tex": "\\approx 1"
            },
            {
              "type": "text",
              "text": ", Glas "
            },
            {
              "type": "math",
              "tex": "\\approx 6"
            },
            {
              "type": "text",
              "text": ", Wasser "
            },
            {
              "type": "math",
              "tex": "\\approx 80"
            },
            {
              "type": "text",
              "text": "). - Im elektrischen Feld gespeicherte Energie "
            },
            {
              "type": "math",
              "tex": "W_{\\text{el}}"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{W_{\\text{el}} = \\int_0^Q U(q)\\,\\mathrm{d}q = \\frac{1}{2} C U^2 = \\frac{1}{2} Q U = \\frac{Q^2}{2C}}",
              "block": true
            },
            {
              "type": "text",
              "text": " 3. Durchrechnung des Beispiels ("
            },
            {
              "type": "math",
              "tex": "A = 400\\,\\text{cm}^2 = 0{,}04\\,\\text{m}^2, d = 2\\,\\text{mm} = 2 \\cdot 10^{-3}\\,\\text{m}, U = 500\\,\\text{V}"
            },
            {
              "type": "text",
              "text": "): - Schritt 1: Kapazität "
            },
            {
              "type": "math",
              "tex": "C"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "C = \\varepsilon_0 \\cdot \\frac{A}{d} = 8{,}854 \\cdot 10^{-12}\\,\\frac{\\text{F}}{\\text{m}} \\cdot \\frac{0{,}04\\,\\text{m}^2}{2 \\cdot 10^{-3}\\,\\text{m}} = 8{,}854 \\cdot 10^{-12} \\cdot 20\\,\\text{F} = \\mathbf{1{,}771 \\cdot 10^{-10}\\,\\text{F} = 177{,}1\\,\\text{pF}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 2: Elektrische Feldstärke "
            },
            {
              "type": "math",
              "tex": "E"
            },
            {
              "type": "text",
              "text": ":   "
            },
            {
              "type": "math",
              "tex": "E = \\frac{U}{d} = \\frac{500\\,\\text{V}}{2 \\cdot 10^{-3}\\,\\text{m}} = \\mathbf{250.000\\,\\frac{\\text{V}}{\\text{m}} = 250\\,\\frac{\\text{kV}}{\\text{m}}}",
              "block": true
            },
            {
              "type": "text",
              "text": " - Schritt 3: Gespeicherte Energie:   "
            },
            {
              "type": "math",
              "tex": "W_{\\text{el}} = \\frac{1}{2} C U^2 = \\frac{1}{2} \\cdot 1{,}771 \\cdot 10^{-10}\\,\\text{F} \\cdot (500\\,\\text{V})^2 = \\mathbf{2{,}21 \\cdot 10^{-5}\\,\\text{J} = 22{,}1\\,\\mu\\text{J}}",
              "block": true
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
