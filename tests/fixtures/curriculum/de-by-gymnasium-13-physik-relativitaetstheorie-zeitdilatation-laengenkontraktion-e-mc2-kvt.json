        {
          "id": "01K8GD40000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere den relativistischen Impuls, die kinetische Energie und die Energie-Impuls-Beziehung: 1. Relativistischer Impuls:   * "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\vec{p} = \\gamma \\cdot m_0 \\cdot \\vec{v} = \\frac{m_0 \\cdot \\vec{v}}{\\sqrt{1 - \\frac{v^2}{c^2}}}}",
              "speech": "Vektor p gleich Gamma mal m null mal Vektor v gleich m null mal Vektor v durch Wurzel aus 1 minus v Quadrat durch c Quadrat"
            },
            {
              "type": "text",
              "text": ".   * Für "
            },
            {
              "type": "math",
              "tex": "v \\to c",
              "speech": "v gegen c"
            },
            {
              "type": "text",
              "text": " divergiert der Impuls gegen Unendlich "
            },
            {
              "type": "math",
              "tex": "\\implies",
              "speech": "daraus folgt"
            },
            {
              "type": "text",
              "text": " Ein massebehafteter Körper ("
            },
            {
              "type": "math",
              "tex": "m_0 > 0",
              "speech": "m null größer als 0"
            },
            {
              "type": "text",
              "text": ") kann niemals die Lichtgeschwindigkeit "
            },
            {
              "type": "math",
              "tex": "c",
              "speech": "c"
            },
            {
              "type": "text",
              "text": " erreichen, da unendlich viel Energie und Beschleunigungsarbeit nötig wäre, 2. Relativistische Energieformen:   * Ruheenergie: "
            },
            {
              "type": "math",
              "tex": "E_0 = m_0 \\cdot c^2",
              "speech": "E null gleich m null mal c Quadrat"
            },
