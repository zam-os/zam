          "question_segments": [
            {
              "type": "text",
              "text": "Wie verändert sich die im Laborsystem gemessene Zeitdauer "
            },
            {
              "type": "math",
              "tex": "\\Delta t",
              "speech": "Delta t"
            },
            {
              "type": "text",
              "text": " eines bewegten Vorgangs im Vergleich zur im Ruhesystem gemessenen Eigenzeit "
            },
            {
              "type": "math",
              "tex": "\\Delta t_0",
              "speech": "Delta t null"
            },
            {
              "type": "text",
              "text": " bei einer Geschwindigkeit "
            },
            {
              "type": "math",
              "tex": "v > 0",
              "speech": "v größer als 0"
            },
            {
              "type": "text",
              "text": "?"
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Sie ist verlangsamt / gedehnt: "
            },
            {
              "type": "math",
              "tex": "\\Delta t = \\gamma \\cdot \\Delta t_0 = \\frac{\\Delta t_0}{\\sqrt{1 - \\frac{v^2}{c^2}}} > \\Delta t_0",
              "speech": "Delta t gleich Gamma mal Delta t null gleich Delta t null durch Wurzel aus 1 minus v Quadrat durch c Quadrat, größer als Delta t null"
            },
            {
              "type": "text",
              "text": " (Zeitdilatation: 'Bewegte Uhren gehen langsamer')"
            }
          ],
          "fast_check": {
