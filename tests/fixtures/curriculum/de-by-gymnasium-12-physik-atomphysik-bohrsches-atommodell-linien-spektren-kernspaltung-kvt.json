      "practice_items": [
        {
          "id": "01K8GC40000000000000000J03",
          "language": "de",
          "tier": "tier1_fast",
          "bloom_level": 1,
          "question_segments": [
            {
              "type": "text",
              "text": "Warum ist die Masse eines gebundenen Atomkerns stets geringer als die Summe der Ruhemassen seiner freien Protonen und Neutronen (Massendefekt "
            },
            {
              "type": "math",
              "tex": "\\Delta m",
              "speech": "Delta m"
            },
            {
              "type": "text",
              "text": ")?"
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Weil beim Zusammenfügen der Nukleonen die Kernbindungsenergie nach Einsteins Äquivalenzformel "
            },
            {
              "type": "math",
              "tex": "E = \\Delta m \\cdot c^2",
              "speech": "E gleich Delta m mal c Quadrat"
            },
            {
              "type": "text",
              "text": " in Form von Gammastrahlung freigesetzt wird"
            }
          ],
          "fast_check": {
            "type": "binary_choice",
            "options": [
              [
                {
                  "type": "text",
                  "text": "Weil Kernbindungsenergie nach "
                },
                {
                  "type": "math",
                  "tex": "E = \\Delta m \\cdot c^2",
                  "speech": "E gleich Delta m mal c Quadrat"
                },
                {
                  "type": "text",
                  "text": " abgestrahlt wurde"
                }
              ],
              "Weil Protonen im Kern zerfallen"
            ],
            "correct_index": 0
          },
          "materiality": "cosmetic"
        },
        {
          "id": "01K8GC40000000000000000J04",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere den Massendefekt, die Bindungsenergie pro Nukleon und vergleiche Kernspaltung mit Kernfusion: 1. Der Massendefekt "
            },
            {
              "type": "math",
              "tex": "\\Delta m",
              "speech": "Delta m"
            },
            {
              "type": "text",
              "text": ":   * Für einen Kern "
            },
            {
              "type": "math",
              "tex": "^{A}_{Z}X",
              "speech": "X mit Massenzahl A und Kernladungszahl Z"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "Z",
              "speech": "Z"
            },
            {
              "type": "text",
              "text": " Protonen und "
            },
            {
              "type": "math",
              "tex": "N = A - Z",
              "speech": "N gleich A minus Z"
            },
            {
              "type": "text",
              "text": " Neutronen:     "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\Delta m = Z \\cdot m_p + (A - Z) \\cdot m_n - m_{\\text{Kern}} > 0}",
              "block": true,
              "speech": "Delta m gleich Z mal m p plus Klammer auf A minus Z Klammer zu mal m n minus m Kern größer als 0"
            },
            {
              "type": "text",
              "text": "   * Kernbindungsenergie: "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E_B = \\Delta m \\cdot c^2}",
              "speech": "E B gleich Delta m mal c Quadrat"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "1\\,\\text{u} \\approx 931{,}49\\,\\text{MeV}",
              "speech": "1 atomare Masseneinheit ungefähr 931,49 Megaelektronenvolt"
            },
            {
              "type": "text",
              "text": "), 2. Kurve der Bindungsenergie pro Nukleon "
            },
            {
              "type": "math",
              "tex": "\\frac{E_B}{A}",
              "speech": "E B durch A"
            },
            {
              "type": "text",
              "text": ":   * Steigt steil von "
            },
            {
              "type": "math",
              "tex": "^1H",
              "speech": "Wasserstoff 1"
            },
            {
              "type": "text",
              "text": " bis zum Maximum bei Eisen-56 ("
            },
            {
              "type": "math",
              "tex": "^{56}_{26}\\text{Fe}",
              "speech": "Eisen mit Massenzahl 56 und Kernladungszahl 26"
            },
            {
              "type": "text",
              "text": ") mit ca. "
            },
            {
              "type": "math",
              "tex": "8{,}8\\,\\text{MeV/Nukleon}",
              "speech": "8,8 Megaelektronenvolt pro Nukleon"
            },
            {
              "type": "text",
              "text": " an und sinkt bei schweren Kernen wie Uran-238 langsam auf ca. "
            },
            {
              "type": "math",
              "tex": "7{,}6\\,\\text{MeV/Nukleon}",
              "speech": "7,6 Megaelektronenvolt pro Nukleon"
            },
            {
              "type": "text",
              "text": " ab.   * Folge: Energiefreisetzung ist möglich durch:     - Kernfusion: Verschmelzung extrem leichter Kerne ("
            },
            {
              "type": "math",
              "tex": "^2H + ^3H \\rightarrow ^4He + n + 17{,}6\\,\\text{MeV}",
