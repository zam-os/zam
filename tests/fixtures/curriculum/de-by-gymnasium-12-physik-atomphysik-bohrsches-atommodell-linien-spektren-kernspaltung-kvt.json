        {
          "id": "01K8GC40000000000000000J02",
          "language": "de",
          "tier": "tier2_synthesis",
          "bloom_level": 2,
          "question_segments": [
            {
              "type": "text",
              "text": "Analysiere das Bohrsche Atommodell und Spektrallinien des Wasserstoffs: 1. Bohrs Postulate (1913):   * 1. Bahnen-Postulat: Elektronen kreisen strahlungsfrei auf bestimmten stationären Bahnen.   * 2. Quantenbedingung: Der Bahndrehimpuls ist ein ganzzahliges Vielfaches von "
            },
            {
              "type": "math",
              "tex": "\\hbar",
              "speech": "h quer"
            },
            {
              "type": "text",
              "text": ": "
            },
            {
              "type": "math",
              "tex": "L = m_e \\cdot v \\cdot r = n \\cdot \\frac{h}{2\\pi} = n \\cdot \\hbar",
              "speech": "L gleich m e mal v mal r gleich n mal h durch 2 Pi gleich n mal h quer"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "math",
              "tex": "n \\in \\{1, 2, 3, \\dots\\}",
              "speech": "n Element der Menge 1, 2, 3 und so weiter"
            },
            {
              "type": "text",
              "text": ").   * 3. Frequenz-Bedingung: Beim Übergang zwischen zwei Niveaus "
            },
            {
              "type": "math",
              "tex": "E_m",
              "speech": "E m"
            },
            {
              "type": "text",
              "text": " und "
            },
            {
              "type": "math",
              "tex": "E_n",
              "speech": "E n"
            },
            {
              "type": "text",
              "text": " wird ein Photon emittiert/absorbiert: "
            },
            {
              "type": "math",
              "tex": "\\Delta E = E_m - E_n = h \\cdot f",
              "speech": "Delta E gleich E m minus E n gleich h mal f"
            },
            {
              "type": "text",
              "text": ", 2. Energieniveaus des Wasserstoffs:   * "
            },
            {
              "type": "math",
              "tex": "E_n = -\\frac{13{,}6\\,\\text{eV}}{n^2}",
              "speech": "E n gleich minus 13,6 Elektronenvolt durch n Quadrat"
            },
            {
              "type": "text",
              "text": " (Grundzustand "
            },
            {
              "type": "math",
              "tex": "E_1 = -13{,}6\\,\\text{eV}",
              "speech": "E eins gleich minus 13,6 Elektronenvolt"
            },
            {
              "type": "text",
              "text": ", Ionisationsgrenze "
            },
            {
              "type": "math",
              "tex": "E_\\infty = 0\\,\\text{eV}",
              "speech": "E unendlich gleich 0 Elektronenvolt"
            },
            {
              "type": "text",
              "text": "), 3. Spektralserien (Rydberg-Formel):   * "
            },
            {
              "type": "math",
              "tex": "\\frac{1}{\\lambda} = R_H \\cdot \\left( \\frac{1}{n^2} - \\frac{1}{m^2} \\right)",
              "speech": "1 durch Lambda gleich R H mal Klammer auf 1 durch n Quadrat minus 1 durch m Quadrat Klammer zu"
            },
            {
              "type": "text",
              "text": " mit "
            },
            {
              "type": "math",
              "tex": "R_H \\approx 1{,}097 \\cdot 10^7\\,\\text{m}^{-1}",
              "speech": "R H ungefähr 1,097 mal 10 hoch 7 pro Meter"
            },
            {
              "type": "text",
              "text": ".   * Lyman-Serie ("
            },
            {
              "type": "math",
              "tex": "n=1",
              "speech": "n gleich 1"
            },
            {
              "type": "text",
              "text": ", UV-Bereich), Balmer-Serie ("
            },
            {
              "type": "math",
              "tex": "n=2",
              "speech": "n gleich 2"
            },
            {
              "type": "text",
              "text": ", sichtbares Licht), Paschen-Serie ("
            },
            {
              "type": "math",
              "tex": "n=3",
              "speech": "n gleich 3"
            },
            {
              "type": "text",
              "text": ", Infrarot)."
            }
          ],
          "concept_segments": [
            {
              "type": "text",
              "text": "Bohrsches Atommodell: 3 Bohr-Postulate (strahlungsfreie Bahnen, Drehimpulsquantisierung "
            },
            {
              "type": "math",
              "tex": "L = n \\cdot \\hbar",
              "speech": "L gleich n mal h quer"
            },
            {
              "type": "text",
              "text": ", Frequenzbedingung "
            },
            {
              "type": "math",
              "tex": "\\Delta E = h \\cdot f",
              "speech": "Delta E gleich h mal f"
            },
            {
              "type": "text",
              "text": "); H-Atom Energien "
            },
            {
              "type": "math",
              "tex": "E_n = -\\frac{13{,}6\\,\\text{eV}}{n^2}",
              "speech": "E n gleich minus 13,6 Elektronenvolt durch n Quadrat"
            },
            {
              "type": "text",
              "text": "; Spektralserien (Lyman "
            },
            {
              "type": "math",
              "tex": "n = 1",
              "speech": "n gleich 1"
            },
            {
              "type": "text",
              "text": " UV, Balmer "
            },
            {
              "type": "math",
              "tex": "n = 2",
              "speech": "n gleich 2"
            },
            {
              "type": "text",
              "text": " sichtbar, Paschen "
            },
            {
              "type": "math",
              "tex": "n = 3",
              "speech": "n gleich 3"
            },
            {
              "type": "text",
              "text": " IR); Franck-Hertz-Versuch (inelastische Stöße)."
            }
          ],
          "sample_solution": [
            {
              "type": "text",
              "text": "1. Die Bohrschen Postulate (Niels Bohr, 1913): - Das klassische Dilemma: Nach der Maxwellschen Elektrodynamik müsste ein kreisendes (beschleunigtes) Elektron kontinuierlich elektromagnetische Wellen abstrahlen, in Sekundenbruchteilen in den Kern stürzen und ein kontinuierliches Lichtspektrum aussenden "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Atome wären instabil. - Bohrs revolutionäre Postulate:   1. Stationäre Zustände: Das Elektron bewegt sich auf diskreten Kreisbahnen, ohne elektromagnetische Strahlung zu emittieren.   2. Drehimpulsquantisierung: Erlaubt sind nur Bahnen, auf denen der Drehimpuls "
            },
            {
              "type": "math",
              "tex": "L"
            },
            {
              "type": "text",
              "text": " ein ganzzahliges Vielfaches des reduzierten Planckschen Wirkungsquantums ist:      "
            },
            {
              "type": "math",
              "tex": "\\mathbf{L = m_e \\cdot v_n \\cdot r_n = n \\cdot \\hbar = n \\cdot \\frac{h}{2\\pi}} \\quad (n = 1, 2, 3, \\dots)",
              "block": true
            },
            {
              "type": "text",
              "text": "      (De-Broglie-Deutung: Auf der "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": "-ten Bahn passt exakt das "
            },
            {
              "type": "math",
              "tex": "n"
            },
            {
              "type": "text",
              "text": "-fache der De-Broglie-Wellenlänge als stehende Welle auf den Kreisumfang: "
            },
            {
              "type": "math",
              "tex": "2\\pi r_n = n \\cdot \\lambda"
            },
            {
              "type": "text",
              "text": ").   3. Strahlungsübergänge: Strahlung wird nur beim Quantensprung von einem höheren Niveau "
            },
            {
              "type": "math",
              "tex": "E_m"
            },
            {
              "type": "text",
              "text": " auf ein niedrigeres Niveau "
            },
            {
              "type": "math",
              "tex": "E_n"
            },
            {
              "type": "text",
              "text": " als einzelnes Photon emittiert:      "
            },
            {
              "type": "math",
              "tex": "\\mathbf{h \\cdot f = E_m - E_n \\iff \\lambda = \\frac{h \\cdot c}{E_m - E_n}}",
              "block": true
            },
            {
              "type": "text",
              "text": " 2. Das Termschema des Wasserstoffatoms: - Aus dem Kräftegleichgewicht zwischen Coulomb-Kraft und Zentripetalkraft ("
            },
            {
              "type": "math",
              "tex": "F_C = F_Z"
            },
            {
              "type": "text",
              "text": ") sowie der Quantenbedingung folgt die Energieformel:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{E_n = -\\frac{m_e \\cdot e^4}{8 \\cdot \\varepsilon_0^2 \\cdot h^2} \\cdot \\frac{1}{n^2} = -\\frac{13{,}6\\,\\text{eV}}{n^2}}",
              "block": true
            },
            {
              "type": "text",
              "text": "   * Grundzustand ("
            },
            {
              "type": "math",
              "tex": "n = 1"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "E_1 = -13{,}6\\,\\text{eV}"
            },
            {
              "type": "text",
              "text": " (stabilster Zustand).   * 1. Angeregter Zustand ("
            },
            {
              "type": "math",
              "tex": "n = 2"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "E_2 = -\\frac{13{,}6}{4} = -3{,}4\\,\\text{eV}"
            },
            {
              "type": "text",
              "text": ".   * Ionisationsgrenze ("
            },
            {
              "type": "math",
              "tex": "n \\to \\infty"
            },
            {
              "type": "text",
              "text": "): "
            },
            {
              "type": "math",
              "tex": "E_\\infty = 0\\,\\text{eV}"
            },
            {
              "type": "text",
              "text": " (Elektron ist frei vom Kern). 3. Die Spektralserien und die Rydberg-Gleichung: - Wellenlängen emittierter Spektrallinien:   "
            },
            {
              "type": "math",
              "tex": "\\mathbf{\\frac{1}{\\lambda} = R_\\infty \\cdot \\left( \\frac{1}{n^2} - \\frac{1}{m^2} \\right)} \\quad (m > n; \\; R_\\infty \\approx 1{,}09737 \\cdot 10^7\\,\\text{m}^{-1})",
              "block": true
            },
            {
              "type": "text",
              "text": " - Die Serien im Überblick:   * Lyman-Serie ("
            },
            {
              "type": "math",
              "tex": "n = 1"
            },
            {
              "type": "text",
              "text": "): Übergänge von "
            },
            {
              "type": "math",
              "tex": "m \\ge 2 \\rightarrow 1"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Hochenergetische Ultraviolett-Strahlung (UV).   * Balmer-Serie ("
            },
            {
              "type": "math",
              "tex": "n = 2"
            },
            {
              "type": "text",
              "text": "): Übergänge von "
            },
            {
              "type": "math",
              "tex": "m \\ge 3 \\rightarrow 2"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Sichtbares Licht ("
            },
            {
              "type": "math",
              "tex": "H_\\alpha = 656\\,\\text{nm}"
            },
            {
              "type": "text",
              "text": " rot, "
            },
            {
              "type": "math",
              "tex": "H_\\beta = 486\\,\\text{nm}"
            },
            {
              "type": "text",
              "text": " blaugrün, "
            },
            {
              "type": "math",
              "tex": "H_\\gamma = 434\\,\\text{nm}"
            },
            {
              "type": "text",
              "text": " blauviolett).   * Paschen-Serie ("
            },
            {
              "type": "math",
              "tex": "n = 3"
            },
            {
              "type": "text",
              "text": "): Übergänge auf "
            },
            {
              "type": "math",
              "tex": "n = 3"
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "math",
              "tex": "\\implies"
            },
            {
              "type": "text",
              "text": " Infrarot-Strahlung (IR)."
            }
          ],
          "materiality": "cosmetic"
        }
      ]
    },
